@using Microsoft.EntityFrameworkCore
@using DossierArchiveApp.Data
@using DossierArchiveApp.Models
@using DossierArchiveApp.Services
@inject IJSRuntime JS

<MudDialog DisableSidePadding="true" Class="print-dialog-wrapper">
    <DialogContent>
        <!-- شريط التحكم: يظهر على الشاشة فقط ويختفي نهائياً في الطباعة -->
        <div class="no-print d-flex justify-space-between align-center px-4 py-2" style="background-color: #f1f5f3; border-bottom: 1px solid #dcdcdc;">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.Print" Color="Color.Primary" />
                <MudText Typo="Typo.subtitle1" Class="fw-bold" Style="color: #1B4D3E;">معاينة استمارة الفهرس الرسمية</MudText>
            </div>
            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.LocalPrintshop"
                           OnClick="TriggerPrint"
                           Style="background-color: #1B4D3E; color: white; font-weight: bold;">
                    طباعة / حفظ كـ PDF
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="Close">
                    إغلاق
                </MudButton>
            </div>
        </div>

        <!-- ورقة الطباعة A4 المجهزة للطباعة الحكومية -->
        <div id="print-sheet" class="print-page-layout" dir="rtl">

            <!-- الترويسة الرسمية -->
            <div class="header-container d-flex justify-space-between align-center mb-2 pb-2">
                <div style="text-align: right; min-width: 190px;">
                    <div style="font-size: 13pt; font-weight: bold; color: #1B4D3E;">ديوان الوقف الشيعي</div>
                    <div style="font-size: 11pt; font-weight: bold;">@(Settings?.DirectorateName ?? "مديرية الوقف الشيعي في ديالى")</div>
                    <div style="font-size: 10pt; color: #444;">@(Settings?.DepartmentName ?? "شعبة تكنولوجيا المعلومات")</div>
                </div>

                <div style="text-align: center;">
                    @if (!string.IsNullOrWhiteSpace(Settings?.LogoPath))
                    {
                        <img src="@Settings.LogoPath" style="height: 70px; width: 70px; object-fit: contain;" alt="الشعار الرسمي" />
                    }
                </div>

                <div style="text-align: left; min-width: 190px; direction: ltr;">
                    <div style="font-size: 9pt;"><strong>تاريخ الاستخراج:</strong> @DateTime.Now.ToString("yyyy/MM/dd")</div>
                    <div style="font-size: 9pt;"><strong>وقت الاستخراج:</strong> @DateTime.Now.ToString("hh:mm tt")</div>
                    <div style="font-size: 8pt; color: #666; font-family: monospace;">رمز الأرشفة: #@Employee.FileNumber-@DateTime.Now.ToString("yyMMdd")</div>
                </div>
            </div>

            <!-- عنوان الاستمارة -->
            <div class="text-center my-2">
                <span class="report-title">فهرس محتويات إضبارة الموظف</span>
            </div>

            <!-- بطاقة بيانات الموظف -->
            <table class="emp-info-table mb-3">
                <tr>
                    <td class="info-label">اسم الموظف:</td>
                    <td class="info-val fw-bold" style="font-size: 11pt; color: #1B4D3E;">@Employee.EmployeeName</td>
                    <td class="info-label">رقم الإضبارة:</td>
                    <td class="info-val fw-bold">@Employee.FileNumber</td>
                </tr>
                <tr>
                    <td class="info-label">الحالة الوظيفية:</td>
                    <td class="info-val">@(Employee.IsActive == 1 ? "فعال مستمر بالخدمة" : "غير فعال / متوقف")</td>
                    <td class="info-label">عدد الكتب المفهرسة:</td>
                    <td class="info-val fw-bold">@Documents.Count كتاباً</td>
                </tr>
            </table>

            <!-- جدول المستندات المؤرشفة -->
            <table class="report-table">
                <thead>
                    <tr>
                        <th style="width: 6%;">ت</th>
                        <th style="width: 18%;">رقم الكتاب</th>
                        <th style="width: 16%;">تاريخ الكتاب</th>
                        <th style="width: 38%;">الموضوع</th>
                        <th style="width: 22%;">التصنيف الإداري</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int idx = 1;
                    }
                    @foreach (var doc in Documents)
                    {
                        <tr>
                            <td class="text-center">@(idx++)</td>
                            <td class="text-center fw-bold">@doc.DocumentNumber</td>
                            <td class="text-center">@doc.DocumentDate</td>
                            <td class="subject-cell">@doc.Subject</td>
                            <td>@GetCategoryName(doc)</td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- قسم التواقيع الإدارية المعتمدة -->
            <div class="signatures-wrapper">
                <div class="signatures-row">
                    <div class="sig-box">
                        <div class="fw-bold">منظم الفهرس</div>
                        <div class="sig-title">توقيع واسم الموظف المختص</div>
                        <div class="sig-dots">...........................................</div>
                    </div>
                    <div class="sig-box">
                        <div class="fw-bold">مسؤول الشعبة / القسم</div>
                        <div class="sig-title">التوقيع والمصادقة</div>
                        <div class="sig-dots">...........................................</div>
                    </div>
                    <div class="sig-box">
                        <div class="fw-bold">السيد المدير</div>
                        <div class="sig-title">مدير المديرية المحترم</div>
                        <div class="sig-dots">...........................................</div>
                    </div>
                </div>

                <!-- تذييل الترقيم الأمني للحماية من التلاعب -->
                <div class="page-security-footer">
                    <div>* وثيقة رسمية صادرة من نظام الأرشفة الإلكتروني - لا يعتد بها في حال الكشط أو الحك أو التحريف.</div>
                    <div class="page-number-box">
                        إجمالي محتويات الإضبارة: (@Documents.Count) وثيقة مسجلة
                    </div>
                </div>
            </div>

        </div>
    </DialogContent>
</MudDialog>

<style>
    /* تنسيقات العرض على الشاشة */
    .print-page-layout {
        background-color: white;
        width: 210mm;
        min-height: 280mm;
        margin: 0 auto;
        padding: 12mm 15mm;
        color: #111;
        font-family: 'Dubai', 'Segoe UI', Tahoma, sans-serif;
        box-sizing: border-box;
        position: relative;
    }

    .header-container {
        border-bottom: 2px solid #1B4D3E;
    }

    .report-title {
        display: inline-block;
        font-size: 13pt;
        font-weight: bold;
        color: #1B4D3E;
        background-color: #f1f8f5;
        border: 1.5px solid #1B4D3E;
        border-radius: 4px;
        padding: 3px 25px;
    }

    .emp-info-table {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid #c8e6c9;
        background-color: #fcfdfc;
    }

        .emp-info-table td {
            padding: 5px 8px;
            font-size: 9.5pt;
            border: 1px solid #dcdcdc;
        }

    .info-label {
        width: 18%;
        font-weight: bold;
        background-color: #f0f6f3;
        color: #2c3e50;
    }

    .info-val {
        width: 32%;
    }

    .report-table {
        width: 100%;
        border-collapse: collapse;
    }

        .report-table th, .report-table td {
            border: 1px solid #333;
            padding: 5px 8px;
            font-size: 9pt;
        }

        .report-table th {
            background-color: #1B4D3E !important;
            color: white !important;
            text-align: center;
            font-weight: bold;
        }

        .report-table tr:nth-child(even) td {
            background-color: #fcfcfc;
        }

    .subject-cell {
        font-weight: 500;
        line-height: 1.35;
    }

    /* قسم التواقيع وأسفل الصفحة */
    .signatures-wrapper {
        margin-top: 35px;
        page-break-inside: avoid;
        break-inside: avoid;
    }

    .signatures-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
    }

    .sig-box {
        text-align: center;
        width: 31%;
    }

    .sig-title {
        font-size: 8pt;
        color: #666;
        margin-top: 2px;
    }

    .sig-dots {
        margin-top: 45px;
        color: #777;
        font-size: 9pt;
    }

    .page-security-footer {
        margin-top: 25px;
        padding-top: 6px;
        border-top: 1px dashed #bbb;
        display: flex;
        justify-content: space-between;
        font-size: 7.5pt;
        color: #666;
    }

    .page-number-box {
        font-weight: bold;
        color: #1B4D3E;
        direction: rtl;
    }

    /* ======================================================== */
    /* قواعد الطباعة الصارمة (طباعة صفحة A4 واحدة متوازنة ونظيفة) */
    /* ======================================================== */
    @@media print {
        /* إخفاء عناصر التحكم ورأس النافذة المنبثقة الافتراضي بالكامل */
        .no-print,
        .mud-dialog-title,
        .mud-dialog-actions,
        header,
        nav {
            display: none !important;
            visibility: hidden !important;
            height: 0 !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        body, html {
            background-color: white !important;
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
            height: 100% !important;
        }

        .mud-dialog {
            box-shadow: none !important;
            border: none !important;
            max-width: 100% !important;
            width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .mud-dialog-content {
            padding: 0 !important;
            margin: 0 !important;
            overflow: visible !important;
        }

        @@page {
            size: A4 portrait;
            margin: 8mm 10mm 10mm 10mm; /* هوامش متوازنة تمنع تدفق ورقة ثانية فارغة */
        }

        .print-page-layout {
            width: 100% !important;
            max-width: 100% !important;
            min-height: auto !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .report-table th {
            background-color: #1B4D3E !important;
            color: white !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .emp-info-table td, .info-label {
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .signatures-wrapper {
            page-break-inside: avoid !important;
            break-inside: avoid !important;
        }
    }
</style>

@code {
    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public Employee Employee { get; set; } = default!;

    [Parameter]
    public List<Document> Documents { get; set; } = new();

    [Parameter]
    public SystemSetting? Settings { get; set; }

    [Parameter]
    public List<MainCategory> MainCategories { get; set; } = new();

    [Parameter]
    public List<PrimaryCategory> PrimaryCategories { get; set; } = new();

    private string GetCategoryName(Document doc)
    {
        var main = MainCategories.FirstOrDefault(c => c.MainCategoryId == doc.MainCategoryId)?.Name;
        var prim = PrimaryCategories.FirstOrDefault(c => c.PrimaryCategoryId == doc.PrimaryCategoryId)?.Name;
        if (!string.IsNullOrEmpty(main) && !string.IsNullOrEmpty(prim))
            return $"{main} / {prim}";
        return main ?? prim ?? "-";
    }

    private async Task TriggerPrint()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private void Close()
    {
        MudDialog?.Close();
    }
}
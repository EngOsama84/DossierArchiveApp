    private async Task SaveAllAsync()
    {
        if (!_items.Any()) return;

        if (_items.Any(i => string.IsNullOrWhiteSpace(i.DocumentNumber)))
        {
            Snackbar.Add("يرجى التأكد من ملء رقم الكتاب لجميع الأسطر!", Severity.Warning);
            return;
        }

        _isProcessing = true;
        _processedCount = 0;

        try
        {
            var settings = await DbContext.SystemSettings.AsNoTracking().FirstOrDefaultAsync();
            string baseFolder = settings?.BaseFolderPath ?? string.Empty;

            if (string.IsNullOrWhiteSpace(baseFolder) || !Directory.Exists(baseFolder))
            {
                Snackbar.Add("مسار التخزين الأساسي (BaseFolderPath) غير معرّف أو غير موجود على القرص!", Severity.Error);
                return;
            }

            char[] invalidChars = Path.GetInvalidFileNameChars();

            // 1. جلب الموظفين المشتركين مع شعبهم بدفعة واحدة مع تطبيق شرط الأمان
            var allTargetEmployeeIds = _items.SelectMany(i => i.SharedEmployeeIds).Distinct().ToList();

            var sharedEmployeesQuery = DbContext.Employees
                .Include(e => e.Department)
                .Where(e => allTargetEmployeeIds.Contains(e.EmployeeId));

            if (!SessionService.IsSuperAdmin && SessionService.CurrentDepartmentId.HasValue)
            {
                int myDeptId = SessionService.CurrentDepartmentId.Value;
                sharedEmployeesQuery = sharedEmployeesQuery.Where(e => e.DepartmentId == myDeptId);
            }

            var sharedEmployeesMap = await sharedEmployeesQuery.ToDictionaryAsync(e => e.EmployeeId, e => e);

            string cleanEmpName = string.Concat(Employee.EmployeeName.Trim().Split(invalidChars, StringSplitOptions.RemoveEmptyEntries));
            string cleanEmpFile = string.Concat(Employee.FileNumber.Trim().Split(invalidChars, StringSplitOptions.RemoveEmptyEntries));

            // تحديد مسار الموظف المعزول بالشعبة
            string employeeFolderRelPath;
            if (!string.IsNullOrWhiteSpace(Employee.EmployeeFolderPath))
            {
                employeeFolderRelPath = Employee.EmployeeFolderPath;
            }
            else
            {
                string deptFolder = Employee.Department != null
                    ? string.Concat(Employee.Department.Name.Trim().Split(invalidChars, StringSplitOptions.RemoveEmptyEntries))
                    : "المديرية العامة";
                employeeFolderRelPath = Path.Combine(deptFolder, $"{cleanEmpFile}_{cleanEmpName}");
            }

            string employeeRootFullPath = Path.Combine(baseFolder, employeeFolderRelPath);
            if (!Directory.Exists(employeeRootFullPath)) Directory.CreateDirectory(employeeRootFullPath);

            var createdSecCategories = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);

            await using var transaction = await DbContext.Database.BeginTransactionAsync();

            foreach (var item in _items)
            {
                var mainCat = MainCategories.FirstOrDefault(c => c.MainCategoryId == item.MainCategoryId);
                string mainName = mainCat?.Name?.Trim() ?? "";
                string branchName = mainName.Contains("وارد") ? "الوارد" : "الصادر";

                var priCat = PrimaryCategories.FirstOrDefault(p => p.PrimaryCategoryId == item.PrimaryCategoryId);
                string priName = priCat?.Name?.Trim() ?? "عام";

                string cleanBranch = string.Concat(branchName.Split(invalidChars, StringSplitOptions.RemoveEmptyEntries));
                string cleanPri = string.Concat(priName.Split(invalidChars, StringSplitOptions.RemoveEmptyEntries));

                string primaryTargetDir = Path.Combine(employeeRootFullPath, cleanBranch, cleanPri);

                int? actualSecondaryId = item.SecondaryCategoryId;
                string secName = string.Empty;

                if (item.SecondaryCategoryId.HasValue)
                {
                    var secCat = SecondaryCategories.FirstOrDefault(s => s.SecondaryCategoryId == item.SecondaryCategoryId.Value)
                                 ?? GetFilteredSecondaryCategories(item.PrimaryCategoryId).FirstOrDefault(s => s.SecondaryCategoryId == item.SecondaryCategoryId.Value);

                    if (secCat != null && !string.IsNullOrWhiteSpace(secCat.Name))
                    {
                        secName = secCat.Name.Trim();

                        if (actualSecondaryId is < 0 && item.PrimaryCategoryId.HasValue)
                        {
                            string catKey = $"{item.PrimaryCategoryId.Value}_{secName}";

                            if (createdSecCategories.TryGetValue(catKey, out int existingId))
                            {
                                actualSecondaryId = existingId;
                            }
                            else
                            {
                                var existingDbCat = await DbContext.SecondaryCategories
                                    .FirstOrDefaultAsync(s => s.PrimaryCategoryId == item.PrimaryCategoryId.Value && s.Name == secName);

                                if (existingDbCat != null)
                                {
                                    actualSecondaryId = existingDbCat.SecondaryCategoryId;
                                }
                                else
                                {
                                    var newSec = new SecondaryCategory { Name = secName, PrimaryCategoryId = item.PrimaryCategoryId.Value };
                                    DbContext.SecondaryCategories.Add(newSec);
                                    await DbContext.SaveChangesAsync();
                                    actualSecondaryId = newSec.SecondaryCategoryId;
                                }

                                createdSecCategories[catKey] = actualSecondaryId.Value;
                            }

                            item.SecondaryCategoryId = actualSecondaryId;
                        }

                        string cleanSec = string.Concat(secName.Split(invalidChars, StringSplitOptions.RemoveEmptyEntries));
                        primaryTargetDir = Path.Combine(primaryTargetDir, cleanSec);
                    }
                }

                if (!Directory.Exists(primaryTargetDir)) Directory.CreateDirectory(primaryTargetDir);

                string cleanSubject = string.Concat((string.IsNullOrWhiteSpace(item.Subject) ? "مستند" : item.Subject.Trim()).Split(invalidChars, StringSplitOptions.RemoveEmptyEntries));
                string cleanDocNum = string.Concat(item.DocumentNumber.Trim().Split(invalidChars, StringSplitOptions.RemoveEmptyEntries));
                string docDateStr = item.DocumentDate?.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd");

                string extension = Path.GetExtension(item.File.Name);
                if (string.IsNullOrWhiteSpace(extension)) extension = ".pdf";

                string fileName = $"{cleanSubject} - {cleanDocNum} - {docDateStr}{extension}";
                string physicalFilePath = Path.Combine(primaryTargetDir, fileName);

                if (File.Exists(physicalFilePath))
                {
                    fileName = $"{cleanSubject} - {cleanDocNum} - {docDateStr}_{Guid.NewGuid().ToString()[..4]}{extension}";
                    physicalFilePath = Path.Combine(primaryTargetDir, fileName);
                }

                await using (var fileStream = new FileStream(physicalFilePath, FileMode.Create, FileAccess.Write, FileShare.None, 4096, useAsync: true))
                {
                    await item.File.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024).CopyToAsync(fileStream);
                }

                string relativeFilePath = Path.GetRelativePath(baseFolder, physicalFilePath);

                int? actualTertiaryId = (item.TertiaryCategoryId.HasValue && item.TertiaryCategoryId.Value < 0)
                    ? null
                    : item.TertiaryCategoryId;

                var newDoc = new Document
                {
                    DocumentNumber = item.DocumentNumber.Trim(),
                    DocumentDate = item.DocumentDate,
                    Subject = string.IsNullOrWhiteSpace(item.Subject) ? $"كتاب رقم {item.DocumentNumber}" : item.Subject.Trim(),
                    FilePath = relativeFilePath,
                    MainCategoryId = item.MainCategoryId ?? 0,
                    PrimaryCategoryId = item.PrimaryCategoryId ?? 0,
                    SecondaryCategoryId = actualSecondaryId,
                    TertiaryCategoryId = actualTertiaryId,
                    CreatedBy = SessionService.CurrentUser?.UserId,
                    IsDeleted = 0,
                    CreatedAt = DateTime.Now,
                    UpdatedAt = DateTime.Now
                };

                DbContext.Documents.Add(newDoc);
                await DbContext.SaveChangesAsync();

                var docEmployeesToAdd = new List<DocumentEmployee>
                {
                    new DocumentEmployee
                    {
                        DocumentId = newDoc.DocumentId,
                        EmployeeId = Employee.EmployeeId,
                        EmployeeFilePath = relativeFilePath,
                        CreatedAt = DateTime.Now
                    }
                };

                foreach (var sharedEmpId in item.SharedEmployeeIds)
                {
                    if (sharedEmployeesMap.TryGetValue(sharedEmpId, out var sharedEmp))
                    {
                        string sCleanName = string.Concat(sharedEmp.EmployeeName.Trim().Split(invalidChars, StringSplitOptions.RemoveEmptyEntries));
                        string sCleanFile = string.Concat(sharedEmp.FileNumber.Trim().Split(invalidChars, StringSplitOptions.RemoveEmptyEntries));

                        string sEmpFolderRel;
                        if (!string.IsNullOrWhiteSpace(sharedEmp.EmployeeFolderPath))
                        {
                            sEmpFolderRel = sharedEmp.EmployeeFolderPath;
                        }
                        else
                        {
                            string sDeptFolder = sharedEmp.Department != null
                                ? string.Concat(sharedEmp.Department.Name.Trim().Split(invalidChars, StringSplitOptions.RemoveEmptyEntries))
                                : "المديرية العامة";
                            sEmpFolderRel = Path.Combine(sDeptFolder, $"{sCleanFile}_{sCleanName}");
                        }

                        string sEmpTargetDir = Path.Combine(baseFolder, sEmpFolderRel, cleanBranch, cleanPri);
                        if (!string.IsNullOrWhiteSpace(secName))
                        {
                            string cleanSec = string.Concat(secName.Split(invalidChars, StringSplitOptions.RemoveEmptyEntries));
                            sEmpTargetDir = Path.Combine(sEmpTargetDir, cleanSec);
                        }
                        if (!Directory.Exists(sEmpTargetDir)) Directory.CreateDirectory(sEmpTargetDir);

                        string sPhysicalFilePath = Path.Combine(sEmpTargetDir, fileName);
                        if (File.Exists(sPhysicalFilePath))
                        {
                            string sAltName = $"{cleanSubject} - {cleanDocNum} - {docDateStr}_{Guid.NewGuid().ToString()[..4]}{extension}";
                            sPhysicalFilePath = Path.Combine(sEmpTargetDir, sAltName);
                        }

                        File.Copy(physicalFilePath, sPhysicalFilePath, overwrite: true);
                        string sRelativeFilePath = Path.GetRelativePath(baseFolder, sPhysicalFilePath);

                        docEmployeesToAdd.Add(new DocumentEmployee
                        {
                            DocumentId = newDoc.DocumentId,
                            EmployeeId = sharedEmp.EmployeeId,
                            EmployeeFilePath = sRelativeFilePath,
                            CreatedAt = DateTime.Now
                        });
                    }
                }

                DbContext.DocumentEmployees.AddRange(docEmployeesToAdd);
                await DbContext.SaveChangesAsync();

                _processedCount++;
                StateHasChanged();
            }

            await transaction.CommitAsync();

            await SessionService.LogActivityAsync(
                actionType: "أرشفة ذكية مجمعة ومشاركة",
                entityType: "إضبارة موظف",
                entityId: Employee.EmployeeId,
                description: $"أرشفة وتوزيع ({_items.Count}) كتاباً ضمن إضبارة ({Employee.EmployeeName})."
            );

            Snackbar.Add($"تم حفظ وتوزيع {_items.Count} كتاباً بنجاح في أضابير الموظفين المعنيين!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"حدث خطأ أثناء حفظ الملفات: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

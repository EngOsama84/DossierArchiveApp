@rendermode InteractiveServer

@using System.IO
@using System.Globalization
@using System.Text.RegularExpressions
@using Microsoft.EntityFrameworkCore
@using DossierArchiveApp.Data
@using DossierArchiveApp.Models
@using DossierArchiveApp.Services
@inject AppDbContext DbContext
@inject IWebHostEnvironment Environment
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject UserSessionService SessionService

<MudDialog MaxWidth="MaxWidth.ExtraLarge" FullWidth="true">
    <TitleContent>
        <div class="d-flex align-center justify-space-between w-100" style="color: #1B4D3E;">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.AutoFixHigh" Size="Size.Large" />
                <MudText Typo="Typo.h6" Class="fw-bold">
                    الأرشفة المجمعة الذكية (سحب وإفلات مع التحليل والمشاركة)
                </MudText>
            </div>
            <div class="d-flex align-center gap-2">
                @if (Employee.Department != null)
                {
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small">
                        @Employee.Department.Name
                    </MudChip>
                }
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">
                    الموظف: @Employee.EmployeeName (إضبارة: @Employee.FileNumber)
                </MudChip>
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        <div dir="rtl" class="pa-2">

            <!-- شريط التصنيف الجماعي لكافة المستويات الشجرية الأربعة -->
            <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-3" Style="background-color: #fcfdfc; border-color: #c8e6c9;">
                <div class="d-flex align-center gap-2 flex-wrap">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color: #1B4D3E; min-width: 105px;">
                        تطبيق تصنيف عام:
                    </MudText>

                    <!-- 1. نوع الكتاب -->
                    <MudSelect T="int?" Value="_bulkMainCatId"
                               ValueChanged="OnBulkMainCatChanged"
                               ToStringFunc="GetMainCatName"
                               Label="نوع الكتاب"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               Clearable="true"
                               Style="min-width: 140px; background-color: white;">
                        @foreach (var cat in DistinctMainCategories)
                        {
                            <MudSelectItem T="int?" Value="@((int?)cat.MainCategoryId)">@cat.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <!-- 2. التصنيف الرئيسي -->
                    <MudSelect T="int?" Value="_bulkPrimaryCatId"
                               ValueChanged="OnBulkPrimaryCatChanged"
                               ToStringFunc="GetPrimaryCatName"
                               Label="التصنيف الرئيسي"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               Clearable="true"
                               Disabled="@(!AvailableBulkPrimaryCategories.Any())"
                               Style="min-width: 140px; background-color: white;">
                        @foreach (var pCat in AvailableBulkPrimaryCategories)
                        {
                            <MudSelectItem T="int?" Value="@((int?)pCat.PrimaryCategoryId)">@pCat.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <!-- 3. الفرعي الأول -->
                    <MudSelect T="int?" Value="_bulkSecondaryCatId"
                               ValueChanged="OnBulkSecondaryCatChanged"
                               ToStringFunc="GetSecondaryCatName"
                               Label="الفرعي الأول"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               Clearable="true"
                               Disabled="@(!AvailableBulkSecondaryCategories.Any())"
                               Style="min-width: 140px; background-color: white;">
                        @foreach (var sCat in AvailableBulkSecondaryCategories)
                        {
                            <MudSelectItem T="int?" Value="@((int?)sCat.SecondaryCategoryId)">@sCat.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <!-- 4. الفرعي الثاني -->
                    <MudSelect T="int?" @bind-Value="_bulkTertiaryCatId"
                               ToStringFunc="GetTertiaryCatName"
                               Label="الفرعي الثاني"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               Clearable="true"
                               Disabled="@(!AvailableBulkTertiaryCategories.Any())"
                               Style="min-width: 140px; background-color: white;">
                        @foreach (var tCat in AvailableBulkTertiaryCategories)
                        {
                            <MudSelectItem T="int?" Value="@((int?)tCat.TertiaryCategoryId)">@tCat.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Success"
                               Size="Size.Small"
                               OnClick="ApplyBulkCategoryToAll"
                               Disabled="!_items.Any()"
                               StartIcon="@Icons.Material.Filled.DoneAll">
                        تطبيق على الجميع
                    </MudButton>
                </div>
            </MudPaper>

            <!-- منطقة السحب والإفلات -->
            <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                           FilesChanged="OnFilesDropped"
                           AppendMultipleFiles="true"
                           maximumFileCount="20"
                           Accept=".pdf,.jpg,.jpeg,.png">
                <ActivatorContent>
                    <div class="drop-zone">
                        <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Style="font-size: 3rem; color: #1B4D3E;" />
                        <MudText Typo="Typo.subtitle1" Class="fw-bold mt-1">
                            اسحب وأفلت ملفات الكتب هنا دفعة واحدة (بحد أقصى 20 كتاباً)
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            أو انقر لتحديد ملفات الـ PDF أو الصور من الحاسبة (أقصى حجم للملف 20 ميغابايت)
                        </MudText>
                    </div>
                </ActivatorContent>
            </MudFileUpload>

            <!-- جدول المعاينة والإدخال السريع قبل الحفظ -->
            @if (_items.Any())
            {
                <div class="d-flex justify-space-between align-center mt-4 mb-2">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color: #1B4D3E;">
                        الكتب المستخرجة جاهزة للمراجعة والحفظ (@_items.Count من 20 كتاباً):
                    </MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="_items.Clear">
                        تفريغ القائمة
                    </MudButton>
                </div>

                <div style="max-height: 520px; overflow-y: auto; overflow-x: auto; border: 1px solid #dcdcdc; border-radius: 6px;">
                    <MudSimpleTable Dense="true" Hover="true" Striped="true" Class="compact-bulk-table" Style="background-color: white; width: 100%; table-layout: fixed;">
                        <thead>
                            <tr style="background-color: #1B4D3E; color: white;">
                                <th style="width: 35px; text-align: center;">ت</th>
                                <th style="width: 105px;">رقم الكتاب</th>
                                <th style="width: 145px;">تاريخ الكتاب</th>
                                <th style="width: 22%;">الموضوع</th>
                                <th style="width: 110px;">نوع الكتاب</th>
                                <th style="width: 115px;">الرئيسي</th>
                                <th style="width: 115px;">الفرعي الأول</th>
                                <th style="width: 110px;">الفرعي الثاني</th>
                                <th style="width: 85px; text-align: center;">المشاركة</th>
                                <th style="width: 45px; text-align: center;">حذف</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowIdx = 1;
                            }
                            @foreach (var item in _items)
                            {
                                <tr>
                                    <td style="text-align: center; font-weight: bold;">@(rowIdx++)</td>

                                    <!-- رقم الكتاب -->
                                    <td>
                                        <MudTextField @bind-Value="item.DocumentNumber"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Class="table-input"
                                                      Required="true" />
                                    </td>

                                    <!-- تاريخ الكتاب -->
                                    <td>
                                        <MudDatePicker @bind-Date="item.DocumentDate"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense"
                                                       DateFormat="yyyy-MM-dd"
                                                       ShowToolbar="false"
                                                       Class="table-input" />
                                    </td>

                                    <!-- موضوع الكتاب -->
                                    <td>
                                        <MudTextField @bind-Value="item.Subject"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Placeholder="موضوع الكتاب..."
                                                      Class="table-input"
                                                      Required="true" />
                                    </td>

                                    <!-- 1. نوع الكتاب -->
                                    <td>
                                        <MudSelect T="int?" Value="item.MainCategoryId"
                                                   ValueChanged="@((int? val) => OnRowMainCatChanged(item, val))"
                                                   ToStringFunc="GetMainCatName"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   Dense="true"
                                                   Class="table-input">
                                            @foreach (var cat in DistinctMainCategories)
                                            {
                                                <MudSelectItem T="int?" Value="@((int?)cat.MainCategoryId)">@cat.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </td>

                                    <!-- 2. التصنيف الرئيسي -->
                                    <td>
                                        <MudSelect T="int?" Value="item.PrimaryCategoryId"
                                                   ValueChanged="@((int? val) => OnRowPrimaryCatChanged(item, val))"
                                                   ToStringFunc="GetPrimaryCatName"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   Dense="true"
                                                   Class="table-input"
                                                   Disabled="@(!GetFilteredPrimaryCategories(item.MainCategoryId).Any())">
                                            @foreach (var pCat in GetFilteredPrimaryCategories(item.MainCategoryId))
                                            {
                                                <MudSelectItem T="int?" Value="@((int?)pCat.PrimaryCategoryId)">@pCat.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </td>

                                    <!-- 3. الفرعي الأول -->
                                    <td>
                                        <MudSelect T="int?" Value="item.SecondaryCategoryId"
                                                   ValueChanged="@((int? val) => OnRowSecondaryCatChanged(item, val))"
                                                   ToStringFunc="GetSecondaryCatName"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   Dense="true"
                                                   Class="table-input"
                                                   Disabled="@(!GetFilteredSecondaryCategories(item.PrimaryCategoryId).Any())">
                                            @foreach (var sCat in GetFilteredSecondaryCategories(item.PrimaryCategoryId))
                                            {
                                                <MudSelectItem T="int?" Value="@((int?)sCat.SecondaryCategoryId)">@sCat.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </td>

                                    <!-- 4. الفرعي الثاني -->
                                    <td>
                                        <MudSelect T="int?" @bind-Value="item.TertiaryCategoryId"
                                                   ToStringFunc="GetTertiaryCatName"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   Dense="true"
                                                   Class="table-input"
                                                   Disabled="@(!GetFilteredTertiaryCategories(item.SecondaryCategoryId).Any())">
                                            @foreach (var tCat in GetFilteredTertiaryCategories(item.SecondaryCategoryId))
                                            {
                                                <MudSelectItem T="int?" Value="@((int?)tCat.TertiaryCategoryId)">@tCat.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </td>

                                    <!-- زر مشاركة الكتاب مع موظفين آخرين -->
                                    <td style="text-align: center;">
                                        @if (item.SharedEmployeeIds.Any())
                                        {
                                            <MudButton Variant="Variant.Filled"
                                                       Color="Color.Success"
                                                       Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Group"
                                                       OnClick="@(() => OpenShareDialog(item))"
                                                       Style="font-weight: bold; font-size: 0.72rem; padding: 2px 6px; height: 30px; white-space: nowrap;">
                                                مشترك (@item.SharedEmployeeIds.Count)
                                            </MudButton>
                                        }
                                        else
                                        {
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Default"
                                                       Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.PersonAdd"
                                                       OnClick="@(() => OpenShareDialog(item))"
                                                       Style="font-size: 0.72rem; padding: 2px 6px; height: 30px; white-space: nowrap;">
                                                مشاركة
                                            </MudButton>
                                        }
                                    </td>

                                    <!-- حذف السطر -->
                                    <td style="text-align: center;">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       OnClick="() => RemoveItem(item)" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </div>
            }

            @if (_isProcessing)
            {
                <div class="mt-3">
                    <MudProgressLinear Color="Color.Success" Value="_progressPercentage" Class="my-2" />
                    <MudText Typo="Typo.caption" Class="text-center d-block fw-bold" Style="color: #1B4D3E;">
                        جارٍ حفظ المستندات ونسخها في أضابير الموظفين المشتركين: @_processedCount من @_items.Count...
                    </MudText>
                </div>
            }

        </div>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel" Disabled="_isProcessing">
            إلغاء
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="SaveAllAsync"
                   Disabled="_isProcessing || !_items.Any()"
                   StartIcon="@Icons.Material.Filled.Save"
                   Style="background-color: #1B4D3E; font-weight: bold; color: white;">
            تأكيد وحفظ الكل في الأضابير
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .drop-zone {
        border: 2px dashed #1B4D3E;
        border-radius: 8px;
        background-color: #f7faf8;
        padding: 20px;
        text-align: center;
        cursor: pointer;
        transition: background-color 0.2s, border-color 0.2s;
    }

        .drop-zone:hover {
            background-color: #ebf3ef;
            border-color: #143a2f;
        }

    .compact-bulk-table th,
    .compact-bulk-table td {
        padding: 4px 5px !important;
        vertical-align: middle !important;
    }

    .compact-bulk-table .table-input .mud-input-root-outlined {
        height: 32px !important;
        min-height: 32px !important;
        background-color: #ffffff;
        padding: 0 4px !important;
    }

    .compact-bulk-table .table-input input,
    .compact-bulk-table .table-input .mud-select-input {
        font-size: 0.82rem !important;
        padding: 0 4px !important;
        height: 30px !important;
        line-height: 30px !important;
    }

    .compact-bulk-table .table-input .mud-input-adornment {
        margin: 0 !important;
    }

        .compact-bulk-table .table-input .mud-input-adornment .mud-icon-root {
            font-size: 1.1rem !important;
        }
</style>

@code {
    public class BulkDocumentItem
    {
        public IBrowserFile File { get; set; } = default!;
        public string DocumentNumber { get; set; } = string.Empty;
        public string Subject { get; set; } = string.Empty;
        public DateTime? DocumentDate { get; set; } = DateTime.Today;
        public int? MainCategoryId { get; set; }
        public int? PrimaryCategoryId { get; set; }
        public int? SecondaryCategoryId { get; set; }
        public int? TertiaryCategoryId { get; set; }
        public List<int> SharedEmployeeIds { get; set; } = new();
    }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Employee Employee { get; set; } = default!;

    [Parameter]
    public List<MainCategory> MainCategories { get; set; } = new();

    [Parameter]
    public List<PrimaryCategory> PrimaryCategories { get; set; } = new();

    [Parameter]
    public List<SecondaryCategory> SecondaryCategories { get; set; } = new();

    [Parameter]
    public List<TertiaryCategory> TertiaryCategories { get; set; } = new();

    private List<BulkDocumentItem> _items = new();

    private int? _bulkMainCatId;
    private int? _bulkPrimaryCatId;
    private int? _bulkSecondaryCatId;
    private int? _bulkTertiaryCatId;

    private readonly Dictionary<string, string[]> _primaryToSecondaryMap = new(StringComparer.OrdinalIgnoreCase)
    {
        ["أمر إداري"] = new[] { "مباشرة", "انفكاك", "علاوة", "ترفيع", "شكر", "عقوبة", "لجنة", "تكليف", "تنسيب", "ترشيح", "تقييم", "احتساب", "إضافة", "إعفاء", "دورة", "غير ذلك" },
        ["استمارة"] = new[] { "معلومات", "مستمسكات", "تقييم", "جرد", "غير ذلك" },
        ["طلب شخصي"] = new[] { "إجازة", "نقل", "تنسيب", "تظلم", "مخصصات", "سلفة", "غير ذلك" },
        ["اعتيادية"] = new[] { "مخاطبات", "تبليغ", "استدعاء", "نتيجة", "غير ذلك" }
    };

    private readonly string[] _tertiaryForEnfakak = new[] { "دورة", "مؤتمر", "ورشة", "إجازة", "نقل", "تنسيب", "تقاعد", "تكليف", "غير ذلك" };
    private readonly string[] _tertiaryForEhtisab = new[] { "شهادة", "خدمة", "علاوة", "ترفيع", "شكر", "غير ذلك" };
    private readonly string[] _tertiaryForTakleef = new[] { "منصب", "لجنة", "مهام", "تنسيب", "تكليف", "غير ذلك" };
    private readonly string[] _tertiaryForTarsheeh = new[] { "دورة", "مؤتمر", "ورشة", "تكليف", "لجنة", "غير ذلك" };

    private readonly List<string> _iraqiCommittees = new()
    {
        "تحقيقية", "تدقيقية", "فتح وتحليل العطاءات", "استلام وإنجاز",
        "مشتريات واعتدال أسعار", "شطب وإتلاف", "جرد سنوي", "تضمين",
        "تثمين وبيع وإيجار أموال الدولة", "احتساب خدمة وتقاعد", "فنية تخصصية", "مقابلة وترقية"
    };

    private bool _isProcessing = false;
    private int _processedCount = 0;
    private double _progressPercentage => _items.Count == 0 ? 0 : (_processedCount * 100.0) / _items.Count;

    protected override void OnInitialized()
    {
        if (!SessionService.CanAccessEmployee(Employee))
        {
            Snackbar.Add("عذراً، لا تمتلك الصلاحية للأرشفة في هذه الإضبارة!", Severity.Error);
            MudDialog.Cancel();
        }
    }

    private string GetMainCatName(int? id)
    {
        if (!id.HasValue) return string.Empty;
        return MainCategories.FirstOrDefault(c => c.MainCategoryId == id.Value)?.Name ?? string.Empty;
    }

    private string GetPrimaryCatName(int? id)
    {
        if (!id.HasValue) return string.Empty;
        return PrimaryCategories.FirstOrDefault(c => c.PrimaryCategoryId == id.Value)?.Name ?? string.Empty;
    }

    private string GetSecondaryCatName(int? id)
    {
        if (!id.HasValue) return string.Empty;
        var sec = SecondaryCategories.FirstOrDefault(c => c.SecondaryCategoryId == id.Value);
        if (sec != null) return sec.Name;

        var bulkSec = AvailableBulkSecondaryCategories.FirstOrDefault(s => s.SecondaryCategoryId == id.Value);
        if (bulkSec != null) return bulkSec.Name;

        foreach (var item in _items)
        {
            var rSec = GetFilteredSecondaryCategories(item.PrimaryCategoryId).FirstOrDefault(s => s.SecondaryCategoryId == id.Value);
            if (rSec != null) return rSec.Name;
        }

        return string.Empty;
    }

    private string GetTertiaryCatName(int? id)
    {
        if (!id.HasValue) return string.Empty;
        var tert = TertiaryCategories.FirstOrDefault(c => c.TertiaryCategoryId == id.Value);
        if (tert != null) return tert.Name;

        var bulkTert = AvailableBulkTertiaryCategories.FirstOrDefault(t => t.TertiaryCategoryId == id.Value);
        if (bulkTert != null) return bulkTert.Name;

        foreach (var item in _items)
        {
            var rTert = GetFilteredTertiaryCategories(item.SecondaryCategoryId).FirstOrDefault(t => t.TertiaryCategoryId == id.Value);
            if (rTert != null) return rTert.Name;
        }

        return string.Empty;
    }

    private IEnumerable<MainCategory> DistinctMainCategories =>
        MainCategories.GroupBy(c => c.Name.Trim()).Select(g => g.First());

    private IEnumerable<PrimaryCategory> AvailableBulkPrimaryCategories =>
        GetFilteredPrimaryCategories(_bulkMainCatId);

    private IEnumerable<SecondaryCategory> AvailableBulkSecondaryCategories =>
        GetFilteredSecondaryCategories(_bulkPrimaryCatId);

    private IEnumerable<TertiaryCategory> AvailableBulkTertiaryCategories =>
        GetFilteredTertiaryCategories(_bulkSecondaryCatId);

    private void OnBulkMainCatChanged(int? val)
    {
        _bulkMainCatId = val;
        _bulkPrimaryCatId = null;
        _bulkSecondaryCatId = null;
        _bulkTertiaryCatId = null;
    }

    private void OnBulkPrimaryCatChanged(int? val)
    {
        _bulkPrimaryCatId = val;
        _bulkSecondaryCatId = null;
        _bulkTertiaryCatId = null;
    }

    private void OnBulkSecondaryCatChanged(int? val)
    {
        _bulkSecondaryCatId = val;
        _bulkTertiaryCatId = null;
    }

    private IEnumerable<PrimaryCategory> GetFilteredPrimaryCategories(int? mainCatId) =>
        mainCatId.HasValue
            ? PrimaryCategories.Where(p => p.MainCategoryId == mainCatId.Value)
                               .GroupBy(p => p.Name.Trim()).Select(g => g.First())
            : Enumerable.Empty<PrimaryCategory>();

    private IEnumerable<SecondaryCategory> GetFilteredSecondaryCategories(int? primaryCatId)
    {
        if (!primaryCatId.HasValue) return Enumerable.Empty<SecondaryCategory>();

        var primCat = PrimaryCategories.FirstOrDefault(p => p.PrimaryCategoryId == primaryCatId.Value);
        string primName = primCat?.Name?.Trim() ?? string.Empty;
        var dbList = SecondaryCategories.Where(s => s.PrimaryCategoryId == primaryCatId.Value)
                                         .GroupBy(s => s.Name.Trim()).Select(g => g.First()).ToList();

        string? matchedKey = _primaryToSecondaryMap.Keys.FirstOrDefault(k => primName.Contains(k));
        if (matchedKey != null)
        {
            var allowedSecNames = _primaryToSecondaryMap[matchedKey];
            if (dbList.Any())
            {
                var filtered = dbList
                    .Where(s => allowedSecNames.Any(a => s.Name.Trim().Contains(a)))
                    .OrderBy(s => Array.IndexOf(allowedSecNames, allowedSecNames.FirstOrDefault(a => s.Name.Trim().Contains(a))))
                    .ToList();

                if (filtered.Any()) return filtered;
            }

            int vId = -200;
            return allowedSecNames.Select(name => new SecondaryCategory
            {
                SecondaryCategoryId = vId--,
                PrimaryCategoryId = primaryCatId.Value,
                Name = name
            }).ToList();
        }

        return dbList;
    }

    private IEnumerable<TertiaryCategory> GetFilteredTertiaryCategories(int? secondaryCatId)
    {
        if (!secondaryCatId.HasValue) return Enumerable.Empty<TertiaryCategory>();

        var secCat = SecondaryCategories.FirstOrDefault(s => s.SecondaryCategoryId == secondaryCatId.Value)
                     ?? AvailableBulkSecondaryCategories.FirstOrDefault(s => s.SecondaryCategoryId == secondaryCatId.Value);

        if (secCat == null)
        {
            foreach (var itm in _items)
            {
                secCat = GetFilteredSecondaryCategories(itm.PrimaryCategoryId).FirstOrDefault(s => s.SecondaryCategoryId == secondaryCatId.Value);
                if (secCat != null) break;
            }
        }

        string secName = secCat?.Name?.Trim() ?? string.Empty;

        if (secName.Contains("انفكاك"))
        {
            return BuildTertiaryList(secondaryCatId.Value, _tertiaryForEnfakak);
        }
        if (secName.Contains("احتساب") || secName.Contains("إضافة") || secName.Contains("اضافة"))
        {
            return BuildTertiaryList(secondaryCatId.Value, _tertiaryForEhtisab);
        }
        if (secName.Contains("تكليف") || secName.Contains("إعفاء") || secName.Contains("اعفاء"))
        {
            return BuildTertiaryList(secondaryCatId.Value, _tertiaryForTakleef);
        }
        if (secName.Contains("ترشيح"))
        {
            return BuildTertiaryList(secondaryCatId.Value, _tertiaryForTarsheeh);
        }
        if (secName.Contains("لجنة"))
        {
            return BuildTertiaryList(secondaryCatId.Value, _iraqiCommittees.ToArray());
        }

        return Enumerable.Empty<TertiaryCategory>();
    }

    private List<TertiaryCategory> BuildTertiaryList(int secId, string[] definedNames)
    {
        var result = new List<TertiaryCategory>();
        var fromDb = TertiaryCategories.Where(t => t.SecondaryCategoryId == secId)
                                       .GroupBy(t => t.Name.Trim()).Select(g => g.First()).ToList();

        int virtualId = -100;
        foreach (var name in definedNames)
        {
            var matched = fromDb.FirstOrDefault(d => d.Name.Trim().Equals(name, StringComparison.OrdinalIgnoreCase));
            if (matched != null)
            {
                result.Add(matched);
            }
            else
            {
                result.Add(new TertiaryCategory
                {
                    TertiaryCategoryId = virtualId--,
                    SecondaryCategoryId = secId,
                    Name = name
                });
            }
        }
        return result;
    }


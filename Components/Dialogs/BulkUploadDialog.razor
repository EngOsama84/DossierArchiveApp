    private (string DocNum, string Subject, DateTime? DocDate) ParseFileNameUltra(string rawName)
    {
        string name = rawName.Trim();
        DateTime? detectedDate = null;

        var dateRegex = new Regex(@"(?:^|[\s\-_])(\d{1,2}\s*[\-\/\.]\s*\d{1,2}\s*[\-\/\.]\s*(?:19|20)\d{2})(?:$|[\s\-_])");
        var match = dateRegex.Match(name);

        if (match.Success)
        {
            string rawDateStr = match.Groups[1].Value;
            string cleanDate = Regex.Replace(rawDateStr, @"\s+", "").Replace('/', '-').Replace('.', '-');
            string[] formats = { "d-M-yyyy", "dd-MM-yyyy", "d-M-yyyy", "dd-M-yyyy", "d-MM-yyyy" };

            if (DateTime.TryParseExact(cleanDate, formats, CultureInfo.InvariantCulture, DateTimeStyles.None, out var dt))
            {
                detectedDate = dt;
            }

            name = name.Remove(match.Index, match.Length).Trim();
        }
        else
        {
            var isoRegex = new Regex(@"(?:^|[\s\-_])((?:19|20)\d{2}\s*[\-\/\.]\s*\d{1,2}\s*[\-\/\.]\s*\d{1,2})(?:$|[\s\-_])");
            var isoMatch = isoRegex.Match(name);
            if (isoMatch.Success)
            {
                string rawDateStr = isoMatch.Groups[1].Value;
                string cleanDate = Regex.Replace(rawDateStr, @"\s+", "").Replace('/', '-').Replace('.', '-');
                if (DateTime.TryParseExact(cleanDate, new[] { "yyyy-M-d", "yyyy-MM-dd" }, CultureInfo.InvariantCulture, DateTimeStyles.None, out var dtIso))
                {
                    detectedDate = dtIso;
                }
                name = name.Remove(isoMatch.Index, isoMatch.Length).Trim();
            }
        }

        name = name.Trim('-', '_', ' ');

        string docNum = string.Empty;
        string subject = string.Empty;

        var parts = name.Split(new[] { '-', '_' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                        .Where(p => !string.IsNullOrWhiteSpace(p))
                        .ToList();

        if (parts.Count == 0)
        {
            docNum = "1";
            subject = "مستند";
        }
        else if (parts.Count == 1)
        {
            string single = parts[0];
            var numMatch = Regex.Match(single, @"\b\d+\b");
            if (numMatch.Success)
            {
                docNum = numMatch.Value;
                subject = single.Replace(numMatch.Value, "").Trim();
            }
            else
            {
                subject = single;
                docNum = "1";
            }
        }
        else
        {
            int numIndex = parts.FindIndex(p => Regex.IsMatch(p, @"^\d+$"));
            if (numIndex != -1)
            {
                docNum = parts[numIndex];
                var subParts = parts.Where((p, i) => i != numIndex);
                subject = string.Join(" - ", subParts);
            }
            else
            {
                int mixedIndex = parts.FindIndex(p => Regex.IsMatch(p, @"\d+"));
                if (mixedIndex != -1)
                {
                    var m = Regex.Match(parts[mixedIndex], @"\d+");
                    docNum = m.Value;
                    parts[mixedIndex] = parts[mixedIndex].Replace(docNum, "").Trim();
                    subject = string.Join(" - ", parts.Where(p => !string.IsNullOrWhiteSpace(p)));
                }
                else
                {
                    docNum = parts[0];
                    subject = string.Join(" - ", parts.Skip(1));
                }
            }
        }

        if (string.IsNullOrWhiteSpace(subject)) subject = "مستند مؤرشف";
        if (string.IsNullOrWhiteSpace(docNum)) docNum = "1";

        return (docNum.Trim(), subject.Trim(), detectedDate ?? DateTime.Today);
    }


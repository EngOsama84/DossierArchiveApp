@using Microsoft.EntityFrameworkCore
@using DossierArchiveApp.Data
@using DossierArchiveApp.Models
@using DossierArchiveApp.Services
@inject AppDbContext DbContext
@inject UserSessionService SessionService
@inject ISnackbar Snackbar

<div dir="rtl" class="d-flex align-center justify-center" style="position: fixed; inset: 0; background: linear-gradient(135deg, #0d2820 0%, #1B4D3E 100%); z-index: 9999;">
    <MudPaper Elevation="10" Class="pa-6" Style="width: 100%; max-width: 440px; border-radius: 12px; background-color: #ffffff;">

        <!-- الترويسة والشعار -->
        <div class="text-center mb-4">
            @if (!string.IsNullOrWhiteSpace(_settings?.LogoPath))
            {
                <img src="@_settings.LogoPath"
                     style="width: 100px; height: 125px; object-fit: contain; border-radius: 8px; border: 1px solid #e0e0e0; padding: 4px; background: #fff; box-shadow: 0 2px 6px rgba(0,0,0,0.08); margin-bottom: 10px;"
                     alt="شعار المؤسسة" />
            }
            else
            {
                <div class="d-inline-flex align-center justify-center rounded-circle p-3 mb-2" style="background-color: #e8f5e9;">
                    <MudIcon Icon="@Icons.Material.Filled.FolderShared" Style="font-size: 3rem; color: #1B4D3E;" />
                </div>
            }

            <MudText Typo="Typo.h5" Class="fw-bold" Style="color: #1B4D3E; line-height: 1.3;">
                برنامج الأضابير الإلكترونية
            </MudText>

            @if (!string.IsNullOrEmpty(_settings?.DirectorateName))
            {
                <MudText Typo="Typo.subtitle1" Class="fw-bold mt-1" Style="color: #2c3e50;">
                    @_settings.DirectorateName
                </MudText>
            }

            @if (!string.IsNullOrEmpty(_settings?.DepartmentName))
            {
                <MudText Typo="Typo.body2" Class="fw-bold text-secondary" Style="margin-top: 2px;">
                    @_settings.DepartmentName
                </MudText>
            }

            <MudText Typo="Typo.caption" Class="d-block mt-2 text-muted" Style="font-size: 0.8rem;">
                @(_mustChangePasswordMode ? "تعيين كلمة مرور جديدة للمتابعة" : "تسجيل الدخول للمتابعة")
            </MudText>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="mb-3 text-right" Style="font-size: 0.85rem; border-radius: 6px;">
                @_errorMessage
            </MudAlert>
        }

        @if (!_mustChangePasswordMode)
        {
            <!-- ================= نمط تسجيل الدخول المعتاد ================= -->
            <!-- حقل اسم المستخدم -->
            <div class="mb-3">
                <MudText Typo="Typo.caption" Class="fw-bold mb-1 d-block text-secondary">اسم المستخدم *</MudText>
                <MudTextField @ref="_userNameField"
                              @bind-Value="_userName"
                              Placeholder="أدخل اسم المستخدم"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              AutoFocus="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Person"
                              Immediate="true" />
            </div>

            <!-- حقل كلمة المرور -->
            <div class="mb-4">
                <MudText Typo="Typo.caption" Class="fw-bold mb-1 d-block text-secondary">كلمة المرور *</MudText>
                <MudTextField @bind-Value="_password"
                              Placeholder="أدخل كلمة المرور"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Lock"
                              OnKeyDown="@(async (e) => { if (e.Key == "Enter") await AttemptLogin(); })" />
            </div>

            <!-- زر الدخول -->
            <MudButton Variant="Variant.Filled"
                       FullWidth="true"
                       Size="Size.Large"
                       OnClick="AttemptLogin"
                       Disabled="_isBusy"
                       Class="login-submit-btn">
                @if (_isBusy)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <span class="mr-2">جارٍ التحقق...</span>
                }
                else
                {
                    <span>تسجيل الدخول</span>
                }
            </MudButton>
        }
        else
        {
            <!-- ================= نمط تغيير كلمة المرور الإجباري ================= -->
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Variant="Variant.Outlined" Style="font-size: 0.82rem;">
                هذا الدخول الأول لحسابك، يرجى تعيين كلمة مرور جديدة وخاصة بك.
            </MudAlert>

            <div class="mb-3">
                <MudText Typo="Typo.caption" Class="fw-bold mb-1 d-block text-secondary">كلمة المرور الجديدة *</MudText>
                <MudTextField @bind-Value="_newPassword"
                              Placeholder="أدخل كلمة المرور الجديدة"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              AutoFocus="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.LockReset" />
            </div>

            <div class="mb-4">
                <MudText Typo="Typo.caption" Class="fw-bold mb-1 d-block text-secondary">تأكيد كلمة المرور الجديدة *</MudText>
                <MudTextField @bind-Value="_confirmPassword"
                              Placeholder="أعد إدخال كلمة المرور"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.CheckCircleOutline"
                              OnKeyDown="@(async (e) => { if (e.Key == "Enter") await ConfirmPasswordReset(); })" />
            </div>

            <MudButton Variant="Variant.Filled"
                       FullWidth="true"
                       Size="Size.Large"
                       OnClick="ConfirmPasswordReset"
                       Disabled="_isBusy"
                       Class="login-submit-btn">
                @if (_isBusy)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <span class="mr-2">جارٍ الحفظ والمتابعة...</span>
                }
                else
                {
                    <span>حفظ ومتابعة الدخول</span>
                }
            </MudButton>
        }

    </MudPaper>
</div>

<style>
    .login-submit-btn {
        background-color: #1B4D3E !important;
        color: #ffffff !important;
        font-weight: bold !important;
        border-radius: 6px !important;
        padding: 10px !important;
        transition: all 0.25s ease-in-out !important;
        box-shadow: 0 4px 10px rgba(27, 77, 62, 0.25) !important;
        outline: none !important;
    }

        .login-submit-btn:hover:not(:disabled),
        .login-submit-btn:focus:not(:disabled),
        .login-submit-btn:focus-visible:not(:disabled) {
            background-color: #C5A059 !important;
            color: #ffffff !important;
            transform: translateY(-2px) !important;
            box-shadow: 0 6px 16px rgba(197, 160, 89, 0.45) !important;
            outline: 2px solid #8e6c28 !important;
            outline-offset: 2px !important;
        }

        .login-submit-btn:active:not(:disabled) {
            transform: translateY(0) !important;
        }
</style>

@code {
    private string _userName = string.Empty;
    private string _password = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;

    private string? _errorMessage;
    private bool _isBusy = false;
    private bool _mustChangePasswordMode = false;
    private User? _pendingUser;

    private SystemSetting? _settings;
    private MudTextField<string>? _userNameField;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _settings = await DbContext.SystemSettings.AsNoTracking().FirstOrDefaultAsync();
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _userNameField != null && !_mustChangePasswordMode)
        {
            await _userNameField.FocusAsync();
        }
    }

    private async Task AttemptLogin()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_userName))
        {
            _errorMessage = "يرجى كتابة اسم المستخدم";
            return;
        }

        if (string.IsNullOrWhiteSpace(_password))
        {
            _errorMessage = "يرجى كتابة كلمة المرور";
            return;
        }

        _isBusy = true;
        try
        {
            // 1. فحص وجود الحساب وحالته
            var account = await DbContext.Users
                .FirstOrDefaultAsync(u => u.UserName.ToLower() == _userName.Trim().ToLower());

            if (account != null && account.IsActive == 0)
            {
                _errorMessage = "هذا الحساب معطل حالياً، يرجى مراجعة الإدارة.";
                Snackbar.Add(_errorMessage, Severity.Warning);
                return;
            }

            // 2. التحقق من صحة بيانات الدخول
            var user = await SessionService.ValidateUserCredentialsAsync(_userName.Trim(), _password);

            if (user == null)
            {
                _errorMessage = "اسم المستخدم أو كلمة المرور غير صحيحة!";
                Snackbar.Add(_errorMessage, Severity.Error);
                return;
            }

            // 3. التحقق من شرط تغيير كلمة المرور عند أول دخول
            if (user.MustChangePassword)
            {
                _pendingUser = user;
                _mustChangePasswordMode = true;
                _newPassword = string.Empty;
                _confirmPassword = string.Empty;
                return;
            }

            // 4. الدخول المباشر
            await FinalizeLogin(user);
        }
        catch (Exception ex)
        {
            _errorMessage = $"خطأ في الاتصال بالنظام: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ConfirmPasswordReset()
    {
        _errorMessage = null;

        if (_pendingUser == null)
        {
            _mustChangePasswordMode = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(_newPassword) || _newPassword.Length < 4)
        {
            _errorMessage = "كلمة المرور يجب ألا تقل عن 4 خانات.";
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            _errorMessage = "كلمتا المرور غير متطابقتين.";
            return;
        }

        _isBusy = true;
        try
        {
            var userInDb = await DbContext.Users.FindAsync(_pendingUser.UserId);
            if (userInDb == null)
            {
                _errorMessage = "تعذر العثور على الحساب لتحديثه.";
                return;
            }

            userInDb.PasswordHash = UserSessionService.HashPassword(_newPassword);
            userInDb.MustChangePassword = false;
            userInDb.UpdatedAt = DateTime.Now;

            await DbContext.SaveChangesAsync();

            Snackbar.Add("تم تعيين كلمة المرور الجديدة بنجاح", Severity.Success);

            // إكمال تسجيل الدخول وتفعيل الجلسة
            await FinalizeLogin(userInDb);
        }
        catch (Exception ex)
        {
            _errorMessage = $"خطأ أثناء حفظ كلمة المرور: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task FinalizeLogin(User user)
    {
        user.LastLogin = DateTime.Now;
        user.UpdatedAt = DateTime.Now;
        await DbContext.SaveChangesAsync();

        await SessionService.SetUserAsync(user);
        Snackbar.Add($"أهلاً بك، {user.UserName}", Severity.Success);
    }
}
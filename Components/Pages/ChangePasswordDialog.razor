@using Microsoft.EntityFrameworkCore
@using DossierArchiveApp.Data
@using DossierArchiveApp.Services
@inject AppDbContext DbContext
@inject UserSessionService SessionService
@inject ISnackbar Snackbar

<MudDialog DisableSidePadding="true" Style="direction: rtl; text-align: right; min-width: 360px; max-width: 420px; border-radius: 8px;">
    <TitleContent>
        <div class="d-flex align-center gap-2 px-4 pt-3 pb-2" style="border-bottom: 1px solid #e0e0e0;">
            <MudIcon Icon="@Icons.Material.Filled.LockReset" Color="Color.Primary" Size="Size.Medium" />
            <MudText Typo="Typo.h6" Class="fw-bold" Style="color: #1B4D3E;">
                تغيير كلمة المرور
            </MudText>
        </div>
    </TitleContent>

    <DialogContent>
        <div class="px-5 py-3">
            <MudText Typo="Typo.body2" Class="mb-3 text-secondary">
                المستخدم الحالي: <strong>@SessionService.CurrentUser?.UserName</strong>
            </MudText>

            <div class="mb-3">
                <MudText Typo="Typo.caption" Class="fw-bold mb-1 d-block text-secondary">كلمة المرور الحالية</MudText>
                <MudTextField @bind-Value="_currentPassword"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </div>

            <div class="mb-3">
                <MudText Typo="Typo.caption" Class="fw-bold mb-1 d-block text-secondary">كلمة المرور الجديدة</MudText>
                <MudTextField @bind-Value="_newPassword"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </div>

            <div class="mb-3">
                <MudText Typo="Typo.caption" Class="fw-bold mb-1 d-block text-secondary">تأكيد كلمة المرور الجديدة</MudText>
                <MudTextField @bind-Value="_confirmPassword"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </div>
        </div>
    </DialogContent>

    <DialogActions>
        <div class="d-flex justify-end gap-2 px-5 pb-3 w-100">
            <MudButton OnClick="Cancel" Variant="Variant.Outlined" Color="Color.Secondary">إلغاء</MudButton>
            <MudButton OnClick="SaveNewPassword" Variant="Variant.Filled" Color="Color.Primary" Style="background-color: #1B4D3E; color: white;">
                تحديث كلمة المرور
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveNewPassword()
    {
        if (SessionService.CurrentUser == null) return;

        var user = await DbContext.Users.FirstOrDefaultAsync(u => u.UserId == SessionService.CurrentUser.UserId);
        if (user == null) return;

        if (!string.IsNullOrEmpty(user.PasswordHash) && user.PasswordHash != _currentPassword)
        {
            Snackbar.Add("كلمة المرور الحالية غير صحيحة!", Severity.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(_newPassword))
        {
            Snackbar.Add("يرجى إدخال كلمة مرور جديدة", Severity.Warning);
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            Snackbar.Add("كلمة المرور الجديدة غير متطابقة مع التأكيد!", Severity.Warning);
            return;
        }

        user.PasswordHash = _newPassword;
        user.UpdatedAt = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
        await DbContext.SaveChangesAsync();

        await SessionService.LogActivityAsync("تغيير كلمة المرور", "مستخدم", user.UserId, $"قام المستخدم ({user.UserName}) بتغيير كلمة المرور الخاصة به.");

        Snackbar.Add("تم تغيير كلمة المرور بنجاح", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }
}
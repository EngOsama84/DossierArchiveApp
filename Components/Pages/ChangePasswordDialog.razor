@using DossierArchiveApp.Data
@using DossierArchiveApp.Models
@using DossierArchiveApp.Services
@inject AppDbContext DbContext
@inject ISnackbar Snackbar

<MudDialog dir="rtl">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.LockReset" Color="Color.Warning" />
            <MudText Typo="Typo.h6" Class="fw-bold">تغيير كلمة المرور</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" Variant="Variant.Filled">
                @_errorMessage
            </MudAlert>
        }

        <div class="d-flex flex-column gap-3 pt-2">
            <div>
                <MudText Typo="Typo.caption" Class="fw-bold mb-1 d-block text-secondary">كلمة المرور الجديدة *</MudText>
                <MudTextField @bind-Value="_newPassword"
                              Placeholder="أدخل كلمة مرور قوية"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              AutoFocus="true" />
            </div>

            <div>
                <MudText Typo="Typo.caption" Class="fw-bold mb-1 d-block text-secondary">تأكيد كلمة المرور الجديدة *</MudText>
                <MudTextField @bind-Value="_confirmPassword"
                              Placeholder="أعد إدخال كلمة المرور"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              OnKeyDown="@(async (e) => { if (e.Key == "Enter") await SavePassword(); })" />
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Outlined" Color="Color.Secondary">إلغاء</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="SavePassword"
                   Disabled="_isSaving"
                   Style="background-color: #1B4D3E; color: white;">
            @if (_isSaving)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <span class="mr-2">جارٍ الحفظ...</span>
            }
            else
            {
                <span>حفظ التعديل</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public User CurrentUser { get; set; } = default!;

    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _errorMessage;
    private bool _isSaving = false;

    private void Cancel() => MudDialog.Cancel();

    private async Task SavePassword()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_newPassword) || _newPassword.Length < 4)
        {
            _errorMessage = "كلمة المرور يجب ألا تقل عن 4 خانات.";
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            _errorMessage = "كلمتا المرور غير متطابقتين.";
            return;
        }

        _isSaving = true;
        try
        {
            var userInDb = await DbContext.Users.FindAsync(CurrentUser.UserId);
            if (userInDb != null)
            {
                // استخدام تشفير PBKDF2 المحدث
                userInDb.PasswordHash = UserSessionService.HashPassword(_newPassword);
                userInDb.MustChangePassword = false;
                userInDb.UpdatedAt = DateTime.Now;

                await DbContext.SaveChangesAsync();

                CurrentUser.PasswordHash = userInDb.PasswordHash;
                CurrentUser.MustChangePassword = false;
                CurrentUser.UpdatedAt = userInDb.UpdatedAt;

                Snackbar.Add("تم تغيير كلمة المرور بنجاح", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                _errorMessage = "تعذر العثور على الحساب لتحديثه.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"خطأ أثناء حفظ كلمة المرور: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }
}
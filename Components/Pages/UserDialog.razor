@using Microsoft.EntityFrameworkCore
@using DossierArchiveApp.Data
@using DossierArchiveApp.Models
@using DossierArchiveApp.Services
@inject AppDbContext DbContext
@inject UserSessionService SessionService
@inject ISnackbar Snackbar

<MudDialog DisableSidePadding="true" Style="direction: rtl; text-align: right; min-width: 460px; max-width: 520px; border-radius: 8px;">

    <!-- 1. شريط العنوان -->
    <TitleContent>
        <div class="d-flex align-center gap-2 px-4 pt-3 pb-2" style="border-bottom: 1px solid #e0e0e0;">
            <MudIcon Icon="@Icons.Material.Filled.PersonPin" Color="Color.Primary" Size="Size.Medium" />
            <MudText Typo="Typo.h6" Class="fw-bold" Style="color: #1B4D3E;">
                @(UserToEdit.UserId == 0 ? "إضافة مستخدم جديد" : "تعديل بيانات المستخدم")
            </MudText>
        </div>
    </TitleContent>

    <!-- 2. محتوى الحقول والصلاحيات -->
    <DialogContent>
        <div class="px-5 py-3">
            <!-- الاسم الكامل -->
            <div class="mb-3">
                <MudText Typo="Typo.caption" Class="fw-bold mb-1 d-block text-secondary">الاسم الكامل (اختياري)</MudText>
                <MudTextField @bind-Value="UserToEdit.FullName"
                              Placeholder="اسم الموظف أو المستخدم الثلاثي"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </div>

            <!-- اسم المستخدم -->
            <div class="mb-3">
                <MudText Typo="Typo.caption" Class="fw-bold mb-1 d-block text-secondary">اسم المستخدم للدخول *</MudText>
                <MudTextField @bind-Value="UserToEdit.UserName"
                              Placeholder="أدخل اسم المستخدم بالإنجليزية"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true" />
            </div>

            <!-- كلمة المرور -->
            <div class="mb-3">
                <MudText Typo="Typo.caption" Class="fw-bold mb-1 d-block text-secondary">
                    @(UserToEdit.UserId == 0 ? "كلمة المرور *" : "كلمة المرور الجديدة")
                </MudText>
                <MudTextField @bind-Value="_rawPassword"
                              Placeholder="@(UserToEdit.UserId == 0 ? "أدخل كلمة المرور" : "اتركها فارغة إذا لا ترغب بالتغيير")"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </div>

            <!-- خيار تغيير كلمة المرور عند أول دخول -->
            <div class="mb-3">
                <MudCheckBox T="bool"
                             @bind-Value="UserToEdit.MustChangePassword"
                             Color="Color.Primary"
                             Dense="true">
                    <span style="font-size: 0.85rem;">إلزام المستخدم بتغيير كلمة المرور عند أول تسجيل دخول</span>
                </MudCheckBox>
            </div>

            <!-- قسم الصلاحيات -->
            <MudPaper Outlined="true" Class="pa-3 mb-3" Style="background-color: #fafafa; border-radius: 6px;">
                <div class="d-flex justify-space-between align-center mb-2 pb-2" style="border-bottom: 1px dashed #ccc;">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color: #1B4D3E;">
                        صلاحية مدير النظام (تحكم كامل)
                    </MudText>
                    <MudSwitch T="bool"
                               Value="@(UserToEdit.IsAdmin == 1)"
                               ValueChanged="@((val) => SetAdminState(val))"
                               Color="Color.Success" />
                </div>

                @if (UserToEdit.IsAdmin == 1)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-1" Style="font-size: 0.8rem;">
                        مدير النظام يمتلك كافة صلاحيات الإضافة والتعديل والحذف والتصدير وإدارة الحسابات تلقائياً.
                    </MudAlert>
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="fw-bold d-block mb-2 text-secondary">
                        الصلاحيات المخصصة للنظام:
                    </MudText>
                    <div class="d-flex flex-column gap-1">
                        <MudCheckBox T="bool"
                                     Value="@(UserToEdit.CanAdd == 1)"
                                     ValueChanged="@((val) => UserToEdit.CanAdd = val ? 1 : 0)"
                                     Color="Color.Info"
                                     Dense="true">
                            <span style="font-size: 0.85rem;">صلاحية إضافة أضابير ومستندات جديدة</span>
                        </MudCheckBox>

                        <MudCheckBox T="bool"
                                     Value="@(UserToEdit.CanEdit == 1)"
                                     ValueChanged="@((val) => UserToEdit.CanEdit = val ? 1 : 0)"
                                     Color="Color.Warning"
                                     Dense="true">
                            <span style="font-size: 0.85rem;">صلاحية تعديل بيانات الموظفين والمستندات</span>
                        </MudCheckBox>

                        <MudCheckBox T="bool"
                                     Value="@(UserToEdit.CanDelete == 1)"
                                     ValueChanged="@((val) => UserToEdit.CanDelete = val ? 1 : 0)"
                                     Color="Color.Error"
                                     Dense="true">
                            <span style="font-size: 0.85rem;">صلاحية حذف الأضابير والمستندات</span>
                        </MudCheckBox>

                        <MudCheckBox T="bool"
                                     Value="@(UserToEdit.CanExport == 1)"
                                     ValueChanged="@((val) => UserToEdit.CanExport = val ? 1 : 0)"
                                     Color="Color.Secondary"
                                     Dense="true">
                            <span style="font-size: 0.85rem;">صلاحية تصدير البيانات والتقارير والطباعة</span>
                        </MudCheckBox>
                    </div>
                }
            </MudPaper>

            <!-- مفتاح تفعيل الحساب -->
            <div class="d-flex justify-space-between align-center px-3 py-2 rounded" style="background-color: #f8f9fa; border: 1px solid #e9ecef;">
                <MudText Typo="Typo.body2" Class="fw-bold">حالة الحساب</MudText>
                <MudSwitch T="bool"
                           Value="@(UserToEdit.IsActive == 1)"
                           ValueChanged="@((val) => UserToEdit.IsActive = val ? 1 : 0)"
                           Color="Color.Success"
                           Label="@(UserToEdit.IsActive == 1 ? "مفعل" : "معطل")" />
            </div>

        </div>
    </DialogContent>

    <!-- 3. أزرار الإجراءات -->
    <DialogActions>
        <div class="d-flex justify-end gap-2 px-5 pb-3 w-100">
            <MudButton OnClick="Cancel" Variant="Variant.Outlined" Color="Color.Secondary" Style="border-radius: 4px;">إلغاء</MudButton>
            <MudButton OnClick="Save" Variant="Variant.Filled" Color="Color.Primary" Style="background-color: #1B4D3E; color: white; padding: 6px 28px; border-radius: 4px; font-weight: bold;">
                حفظ
            </MudButton>
        </div>
    </DialogActions>

</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public User UserToEdit { get; set; } = new();

    private string _rawPassword = string.Empty;

    private void SetAdminState(bool isAdmin)
    {
        UserToEdit.IsAdmin = isAdmin ? 1 : 0;
        if (isAdmin)
        {
            UserToEdit.CanAdd = 1;
            UserToEdit.CanEdit = 1;
            UserToEdit.CanDelete = 1;
            UserToEdit.CanExport = 1;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(UserToEdit.UserName))
        {
            Snackbar.Add("يرجى إدخال اسم المستخدم", Severity.Warning);
            return;
        }

        // التحقق من عدم تكرار اسم المستخدم
        bool isDuplicate = await DbContext.Users
            .AnyAsync(u => u.UserName.ToLower() == UserToEdit.UserName.Trim().ToLower() && u.UserId != UserToEdit.UserId);

        if (isDuplicate)
        {
            Snackbar.Add("اسم المستخدم موجود مسبقاً، يرجى اختيار اسم آخر!", Severity.Error);
            return;
        }

        if (UserToEdit.UserId == 0 && string.IsNullOrWhiteSpace(_rawPassword))
        {
            Snackbar.Add("يرجى إدخال كلمة مرور للحساب الجديد", Severity.Warning);
            return;
        }

        // تشفير كلمة المرور في حال تم إدخالها
        if (!string.IsNullOrWhiteSpace(_rawPassword))
        {
            UserToEdit.PasswordHash = UserSessionService.HashPassword(_rawPassword);
        }

        bool isNew = UserToEdit.UserId == 0;
        DateTime now = DateTime.Now;

        if (isNew)
        {
            UserToEdit.CreatedAt = now;
            UserToEdit.UpdatedAt = now;
            DbContext.Users.Add(UserToEdit);
        }
        else
        {
            UserToEdit.UpdatedAt = now;
            DbContext.Users.Update(UserToEdit);
        }

        await DbContext.SaveChangesAsync();

        // توثيق العملية في سجل التدقيق
        await SessionService.LogActivityAsync(
            actionType: isNew ? "إضافة مستخدم" : "تعديل مستخدم",
            entityType: "مستخدم",
            entityId: UserToEdit.UserId,
            description: isNew
                ? $"قام ({SessionService.CurrentUser?.UserName}) بإنشاء حساب جديد للمستخدم ({UserToEdit.UserName})."
                : $"قام ({SessionService.CurrentUser?.UserName}) بتعديل بيانات حساب المستخدم ({UserToEdit.UserName})."
        );

        Snackbar.Add("تم حفظ بيانات المستخدم بنجاح", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }
}
@using Microsoft.EntityFrameworkCore
@using DossierArchiveApp.Data
@using DossierArchiveApp.Models
@using DossierArchiveApp.Services
@inject AppDbContext DbContext
@inject UserSessionService SessionService
@inject ISnackbar Snackbar

<MudDialog DisableSidePadding="true" Style="direction: rtl; text-align: right; min-width: 360px; max-width: 400px; border-radius: 8px;">
    <TitleContent>
        <div class="d-flex align-center gap-2 px-4 pt-3 pb-2" style="border-bottom: 1px solid #e0e0e0;">
            <MudIcon Icon="@Icons.Material.Filled.LockPerson" Color="Color.Primary" Size="Size.Medium" />
            <MudText Typo="Typo.h6" Class="fw-bold" Style="color: #1B4D3E;">
                تسجيل الدخول / تبديل المستخدم
            </MudText>
        </div>
    </TitleContent>

    <DialogContent>
        <div class="px-5 py-4">
            <div class="mb-3">
                <MudText Typo="Typo.caption" Class="fw-bold mb-1 d-block text-secondary">اختر الحساب *</MudText>
                <MudSelect T="int" @bind-Value="_selectedUserId"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true"
                           AnchorOrigin="Origin.BottomCenter">
                    @foreach (var user in _availableUsers)
                    {
                        <MudSelectItem Value="@user.UserId">
                            <div class="d-flex justify-space-between align-center py-1">
                                <span class="fw-bold">@user.UserName</span>
                                <span style="font-size: 0.75rem; color: #777;">
                                    @(user.UserTypeId switch
                                    {
                                        1 => "مدير",
                                        2 => "محرر",
                                        3 => "مدخل",
                                        4 => "قارئ",
                                        _ => ""
                                    })
                            </span>
                        </div>
                    </MudSelectItem>
                                        }
                </MudSelect>
            </div>

            <div class="mb-3">
                <MudText Typo="Typo.caption" Class="fw-bold mb-1 d-block text-secondary">كلمة المرور</MudText>
                <MudTextField @bind-Value="_inputPassword"
                              Placeholder="أدخل كلمة المرور"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </div>
        </div>
    </DialogContent>

    <DialogActions>
        <div class="d-flex justify-end gap-2 px-5 pb-3 w-100">
            <MudButton OnClick="Cancel" Variant="Variant.Outlined" Color="Color.Secondary">إلغاء</MudButton>
            <MudButton OnClick="SubmitLogin" Variant="Variant.Filled" Color="Color.Primary" Style="background-color: #1B4D3E; color: white; padding: 6px 24px; font-weight: bold;">
                دخول
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private List<User> _availableUsers = new();
    private int _selectedUserId;
    private string _inputPassword = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _availableUsers = await DbContext.Users
            .Where(u => u.IsActive == 1)
            .OrderBy(u => u.UserId)
            .ToListAsync();

        if (_availableUsers.Any())
        {
            _selectedUserId = _availableUsers.First().UserId;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitLogin()
    {
        var targetUser = _availableUsers.FirstOrDefault(u => u.UserId == _selectedUserId);
        if (targetUser == null)
        {
            Snackbar.Add("يرجى اختيار مستخدم", Severity.Warning);
            return;
        }

        // فحص كلمة المرور إذا كانت معينة
        if (!string.IsNullOrEmpty(targetUser.PasswordHash) && targetUser.PasswordHash != _inputPassword)
        {
            Snackbar.Add("كلمة المرور غير صحيحة!", Severity.Error);
            return;
        }

        // تحديث آخر تسجيل دخول
        targetUser.LastLogin = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
        await DbContext.SaveChangesAsync();

        // تفعيل جلسة المستخدم وتسجيل الحركة تلقائياً
        await SessionService.SetUserAsync(targetUser);

        Snackbar.Add($"مرحباً بك ({targetUser.UserName})", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }
}
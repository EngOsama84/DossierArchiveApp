@using DossierArchiveApp.Data
@using DossierArchiveApp.Models
@using Microsoft.EntityFrameworkCore
@using DossierArchiveApp.Services
@using System.IO
@inject UserSessionService SessionService
@inject AppDbContext DbContext
@inject ISnackbar Snackbar

<MudRTLProvider RightToLeft="true">
    <MudDialog Style="direction: rtl; text-align: right;">
        <TitleContent>
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Color="Color.Primary" />
                <MudText Typo="Typo.h6" Class="fw-bold" Style="color: #1B4D3E;">إضافة إضبارة موظف جديدة</MudText>
            </div>
        </TitleContent>
        <DialogContent>
            <MudForm @ref="_form" @bind-IsValid="_isValid">

                @if (SessionService.IsSuperAdmin)
                {
                    <MudSelect T="int?"
                               @bind-Value="_selectedDepartmentId"
                               Label="الشعبة التابع لها الموظف"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Required="true"
                               RequiredError="يرجى تحديد الشعبة التابع لها الموظف"
                               Dense="true"
                               Class="mb-4">
                        @foreach (var dept in _departments)
                        {
                            <MudSelectItem T="int?" Value="@((int?)dept.DepartmentId)">@dept.Name</MudSelectItem>
                        }
                    </MudSelect>
                }
                else
                {
                    <div class="pa-2 mb-3 rounded" style="background-color: #f1f8f5; border: 1px solid #c8e6c9;">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">الشعبة المسجلة للإضبارة:</MudText>
                        <MudText Typo="Typo.body2" Class="fw-bold" Style="color: #1B4D3E;">
                            @(string.IsNullOrWhiteSpace(SessionService.CurrentDepartmentName) ? "المديرية العامة" : SessionService.CurrentDepartmentName)
                        </MudText>
                    </div>
                }

                <MudTextField T="string"
                              Label="اسم الموظف الكامل"
                              @bind-Value="_newEmployee.EmployeeName"
                              Required="true"
                              RequiredError="يرجى إدخال اسم الموظف"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mb-4" />

                <MudTextField T="string"
                              Label="رقم الأضبارة"
                              @bind-Value="_newEmployee.FileNumber"
                              Required="true"
                              RequiredError="يرجى تحديد رقم الأضبارة"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mb-4" />

                <div class="d-flex align-center justify-space-between mt-2 px-1">
                    <MudText Typo="Typo.body2" Class="fw-bold">الموظف في الخدمة الفعلية (فعال)</MudText>
                    <MudSwitch @bind-Value="_isActive"
                               Color="Color.Success" />
                </div>
            </MudForm>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="Cancel" Variant="Variant.Text" Color="Color.Secondary">إلغاء</MudButton>
            <MudButton OnClick="Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@(!_isValid || _isSaving)"
                       Style="background-color: #1B4D3E; color: white; min-width: 150px;">
                @if (_isSaving)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <span class="ms-2">جارٍ الحفظ...</span>
                }
                else
                {
                    <span>حفظ الموظف والمجلدات</span>
                }
            </MudButton>
        </DialogActions>
    </MudDialog>
</MudRTLProvider>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private MudForm _form = default!;
    private bool _isValid;
    private bool _isSaving;
    private bool _isActive = true;

    private int? _selectedDepartmentId;
    private List<Department> _departments = new();

    private Employee _newEmployee = new()
    {
        CreatedAt = DateTime.Now,
        UpdatedAt = DateTime.Now,
        IsActive = 1
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (SessionService.IsSuperAdmin)
            {
                _departments = await DbContext.Departments
                    .AsNoTracking()
                    .Where(d => d.IsActive == 1)
                    .OrderBy(d => d.DepartmentId)
                    .ToListAsync();

                _selectedDepartmentId = _departments.FirstOrDefault()?.DepartmentId;
            }
            else
            {
                _selectedDepartmentId = SessionService.CurrentDepartmentId;
            }

            var maxId = await DbContext.Employees.IgnoreQueryFilters().MaxAsync(e => (int?)e.EmployeeId) ?? 0;
            _newEmployee.FileNumber = (maxId + 1).ToString("D4");
        }
        catch
        {
            _newEmployee.FileNumber = "0001";
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.Validate();
        if (!_isValid) return;

        int? targetDeptId = SessionService.IsSuperAdmin ? _selectedDepartmentId : SessionService.CurrentDepartmentId;

        if (SessionService.IsSuperAdmin && !targetDeptId.HasValue)
        {
            Snackbar.Add("يرجى اختيار الشعبة التي يتبع لها الموظف!", Severity.Warning);
            return;
        }

        string trimmedName = _newEmployee.EmployeeName.Trim();
        string trimmedFile = _newEmployee.FileNumber.Trim();

        _isSaving = true;
        try
        {
            var settings = await DbContext.SystemSettings.AsNoTracking().FirstOrDefaultAsync();
            if (settings == null || string.IsNullOrWhiteSpace(settings.BaseFolderPath))
            {
                Snackbar.Add("لم يتم تحديد مسار مجلد النظام الرئيسي! يرجى التوجه إلى شاشة الإعدادات وضبط المسار أولاً.", Severity.Error);
                _isSaving = false;
                return;
            }

            if (!Directory.Exists(settings.BaseFolderPath))
            {
                Snackbar.Add($"مجلد النظام الرئيسي غير موجود على القرص ({settings.BaseFolderPath})! يرجى التحقق من وجوده في شاشة الإعدادات.", Severity.Error);
                _isSaving = false;
                return;
            }

            // التحقق من تكرار الاسم ورقم الإضبارة
            bool nameExists = await DbContext.Employees.IgnoreQueryFilters().AnyAsync(e => e.EmployeeName == trimmedName);
            if (nameExists)
            {
                Snackbar.Add("اسم الموظف مسجل مسبقاً، يرجى التأكد من الاسم!", Severity.Warning);
                _isSaving = false;
                return;
            }

            bool fileExists = await DbContext.Employees.IgnoreQueryFilters().AnyAsync(e => e.FileNumber == trimmedFile);
            if (fileExists)
            {
                Snackbar.Add("رقم الأضبارة مستخدم مسبقاً لموظف آخر!", Severity.Warning);
                _isSaving = false;
                return;
            }

            char[] invalidChars = Path.GetInvalidFileNameChars();
            string cleanName = string.Concat(trimmedName.Split(invalidChars, StringSplitOptions.RemoveEmptyEntries));
            string cleanFile = string.Concat(trimmedFile.Split(invalidChars, StringSplitOptions.RemoveEmptyEntries));

            // تحديد اسم مجلد الشعبة الفيزيائي بأمان
            string deptFolderName = "المديرية العامة";
            if (targetDeptId.HasValue)
            {
                var targetDept = await DbContext.Departments.AsNoTracking().FirstOrDefaultAsync(d => d.DepartmentId == targetDeptId.Value);
                if (targetDept != null && !string.IsNullOrWhiteSpace(targetDept.Name))
                {
                    deptFolderName = string.Concat(targetDept.Name.Trim().Split(invalidChars, StringSplitOptions.RemoveEmptyEntries));
                }
            }

            // 1. المسار النسبي والكامل مع عزل مجلد الشعبة
            string employeeFolderRelPath = Path.Combine(deptFolderName, $"{cleanFile}_{cleanName}");
            string employeeFolderFullPath = Path.Combine(settings.BaseFolderPath, employeeFolderRelPath);

            if (!Directory.Exists(employeeFolderFullPath))
            {
                Directory.CreateDirectory(employeeFolderFullPath);
            }

            // 2. المجلدان الأساسيان: الصادر والوارد
            string[] rootBranches = { "الصادر", "الوارد" };

            // 3. جلب التصنيفات الفعلية
            var primaryCategories = await DbContext.PrimaryCategories.AsNoTracking().ToListAsync();
            List<string> categoryNames = primaryCategories
                .Select(c => c.Name.Trim())
                .Where(name => name != "صادر" && name != "وارد" && name != "الصادر" && name != "الوارد")
                .Distinct()
                .ToList();

            if (!categoryNames.Any())
            {
                categoryNames = new List<string> { "أوامر إدارية", "استمارات ومستمسكات", "طلبات شخصية", "كتب اعتيادية" };
            }

            // 4. بناء الهيكلية داخل مجلد الموظف
            foreach (var branch in rootBranches)
            {
                string branchFullPath = Path.Combine(employeeFolderFullPath, branch);
                if (!Directory.Exists(branchFullPath))
                {
                    Directory.CreateDirectory(branchFullPath);
                }

                foreach (var catName in categoryNames)
                {
                    string cleanCatName = string.Concat(catName.Split(invalidChars, StringSplitOptions.RemoveEmptyEntries));
                    string subCategoryFullPath = Path.Combine(branchFullPath, cleanCatName);

                    if (!Directory.Exists(subCategoryFullPath))
                    {
                        Directory.CreateDirectory(subCategoryFullPath);
                    }
                }
            }

            // 5. حفظ الموظف مع DepartmentId
            _newEmployee.EmployeeName = trimmedName;
            _newEmployee.FileNumber = trimmedFile;
            _newEmployee.DepartmentId = targetDeptId;
            _newEmployee.IsActive = _isActive ? 1 : 0;
            _newEmployee.EmployeeFolderPath = employeeFolderRelPath;

            DbContext.Employees.Add(_newEmployee);
            await DbContext.SaveChangesAsync();

            await SessionService.LogActivityAsync(
                actionType: "إضافة موظف",
                entityType: "موظف",
                entityId: _newEmployee.EmployeeId,
                description: $"تمت إضافة الموظف ({_newEmployee.EmployeeName}) برقم إضبارة ({_newEmployee.FileNumber}) وربطه بـ ({deptFolderName})."
            );

            Snackbar.Add($"تم حفظ الموظف وإنشاء هيكلية مجلدات إضباره ضمن ({deptFolderName}) بنجاح", Severity.Success);
            MudDialog.Close(DialogResult.Ok(_newEmployee));
        }
        catch (DbUpdateException)
        {
            Snackbar.Add("تعذر الحفظ لوجود تشابه في القيود الفريدة لقاعدة البيانات", Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"حدث خطأ أثناء إنشاء المجلدات أو الحفظ: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }
}
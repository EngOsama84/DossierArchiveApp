    private async Task ViewDocument(Document doc)
    {
        try
        {
            var settings = await DbContext.SystemSettings.AsNoTracking().FirstOrDefaultAsync();
            if (settings == null || string.IsNullOrWhiteSpace(settings.BaseFolderPath))
            {
                Snackbar.Add("لم يتم تحديد مسار المجلد الأساسي في الإعدادات!", Severity.Error);
                return;
            }

            string? relativePath = null;
            if (_selectedEmployee != null)
            {
                relativePath = await DbContext.DocumentEmployees
                    .Where(de => de.DocumentId == doc.DocumentId && de.EmployeeId == _selectedEmployee.EmployeeId)
                    .Select(de => de.EmployeeFilePath)
                    .FirstOrDefaultAsync();
            }

            if (string.IsNullOrWhiteSpace(relativePath))
            {
                relativePath = doc.FilePath;
            }

            if (string.IsNullOrWhiteSpace(relativePath))
            {
                Snackbar.Add("مسار المستند غير مسجل في النظام!", Severity.Warning);
                return;
            }

            string fullDiskPath = Path.Combine(settings.BaseFolderPath, relativePath);

            if (!File.Exists(fullDiskPath))
            {
                Snackbar.Add($"الملف غير موجود على القرص: {fullDiskPath}", Severity.Warning);
                return;
            }

            string mode = (settings.PDFViewerMode ?? "internal").Trim().ToLower();

            if (mode == "external")
            {
                var psi = new System.Diagnostics.ProcessStartInfo
                {
                    FileName = fullDiskPath,
                    UseShellExecute = true
                };
                System.Diagnostics.Process.Start(psi);
            }
            else if (mode == "browser")
            {
                byte[] fileBytes = await File.ReadAllBytesAsync(fullDiskPath);
                string base64 = Convert.ToBase64String(fileBytes);
                await JS.InvokeVoidAsync("openPdfFromBase64", base64);
            }
            else
            {
                byte[] fileBytes = await File.ReadAllBytesAsync(fullDiskPath);
                string base64 = Convert.ToBase64String(fileBytes);
                string dataUrl = $"data:application/pdf;base64,{base64}";

                var parameters = new DialogParameters
                {
                    ["Title"] = $"{doc.Subject} - ({doc.DocumentNumber})",
                    ["PdfDataUrl"] = dataUrl
                };
                var options = new DialogOptions
                {
                    MaxWidth = MaxWidth.ExtraLarge,
                    FullWidth = true,
                    CloseButton = false
                };

                await DialogService.ShowAsync<PdfViewerDialog>("استعراض المستند", parameters, options);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"حدث خطأ أثناء فتح المستند: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteDocument(Document doc)
    {
        if (_selectedEmployee == null || doc == null) return;

        try
        {
            var settings = await DbContext.SystemSettings.AsNoTracking().FirstOrDefaultAsync();
            string baseFolder = settings?.BaseFolderPath ?? string.Empty;

            var allLinks = await DbContext.DocumentEmployees
                .Where(de => de.DocumentId == doc.DocumentId)
                .ToListAsync();

            int linkedEmployeesCount = allLinks.Count;
            bool deleteAll = false;

            if (linkedEmployeesCount > 1)
            {
                var parameters = new DialogParameters
                {
                    ["ContentText"] = $"الكتاب (رقم: {doc.DocumentNumber} - {doc.Subject}) مشترك ومؤرشف في أضابير ({linkedEmployeesCount}) موظفين.\nكيف ترغب في إتمام عملية الحذف؟",
                    ["Button1Text"] = "حذف من الموظف الحالي فقط",
                    ["Button2Text"] = "نقل إلى سلة المحذوفات للجميع",
                    ["CancelText"] = "إلغاء الأمر"
                };

                var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small };
                var dialog = await DialogService.ShowAsync<DeleteChoiceDialog>("خيارات حذف المستند المشترك", parameters, options);
                var result = await dialog.Result;

                if (result.Canceled || result.Data == null)
                {
                    return;
                }

                string choice = result.Data.ToString()!;
                deleteAll = (choice == "all");
            }
            else
            {
                bool? confirm = await DialogService.ShowMessageBox(
                    "تأكيد نقل المستند إلى سلة المحذوفات",
                    $"هل أنت متأكد من حذف المستند (رقم: {doc.DocumentNumber} - {doc.Subject})؟\nسيتم نقله إلى سلة المحذوفات مع إمكانية استعادته لاحقاً.",
                    yesText: "نعم، حذف",
                    cancelText: "إلغاء");

                if (confirm != true) return;
                deleteAll = true;
            }

            if (deleteAll)
            {
                var docDb = await DbContext.Documents.FirstOrDefaultAsync(d => d.DocumentId == doc.DocumentId);
                if (docDb != null)
                {
                    docDb.IsDeleted = 1;
                    docDb.DeletedAt = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
                    DbContext.Documents.Update(docDb);
                    await DbContext.SaveChangesAsync();
                }

                await SessionService.LogActivityAsync(
                    actionType: "حذف مستند (سلة المحذوفات)",
                    entityType: "مستند",
                    entityId: doc.DocumentId,
                    description: $"تم نقل كتاب ({doc.Subject}) ذي الرقم ({doc.DocumentNumber}) إلى سلة المحذوفات."
                );

                Snackbar.Add("تم نقل المستند إلى سلة المحذوفات بنجاح", Severity.Success);
            }
            else
            {
                var currentLink = allLinks.FirstOrDefault(de => de.EmployeeId == _selectedEmployee.EmployeeId);
                if (currentLink != null)
                {
                    DbContext.DocumentEmployees.Remove(currentLink);
                    await DbContext.SaveChangesAsync();

                    await SessionService.LogActivityAsync(
                        actionType: "فك ارتباط مستند",
                        entityType: "مستند / موظف",
                        entityId: doc.DocumentId,
                        description: $"تمت إزالة كتاب ({doc.Subject}) ذي الرقم ({doc.DocumentNumber}) من إضبارة الموظف ({_selectedEmployee.EmployeeName}) فقط."
                    );

                    Snackbar.Add($"تمت إزالة المستند من إضبارة ({_selectedEmployee.EmployeeName}) فقط", Severity.Success);
                }
            }

            await LoadEmployeeDocuments(_selectedEmployee.EmployeeId);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"حدث خطأ أثناء تنفيذ الحذف: {ex.Message}", Severity.Error);
        }
    }

    private async Task ExportToExcel()
    {
        if (_selectedEmployee == null || !_documents.Any())
        {
            Snackbar.Add("لا توجد مستندات لتصديرها لهذا الموظف!", Severity.Warning);
            return;
        }

        _isExporting = true;
        try
        {
            var settings = await DbContext.SystemSettings.AsNoTracking().FirstOrDefaultAsync();

            var docsToExport = FilteredDocuments.ToList();
            if (!docsToExport.Any())
            {
                docsToExport = _documents;
            }

            byte[] fileBytes = ExportService.ExportEmployeeDocumentsToExcel(_selectedEmployee, docsToExport, settings);
            string base64 = Convert.ToBase64String(fileBytes);

            string safeEmpName = string.Join("_", _selectedEmployee.EmployeeName.Split(Path.GetInvalidFileNameChars()));
            string fileName = $"اضبارة_{safeEmpName}_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";

            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, base64);

            await SessionService.LogActivityAsync(
                actionType: "تصدير Excel",
                entityType: "إضبارة موظف",
                entityId: _selectedEmployee.EmployeeId,
                description: $"قام المستخدم ({SessionService.CurrentUser?.UserName}) بتصدير فهرس كتب الموظف ({_selectedEmployee.EmployeeName}) إلى ملف Excel يحتوي ({docsToExport.Count}) كتاباً."
            );

            Snackbar.Add("تم تصدير ملف الإكسل بنجاح!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"حدث خطأ أثناء تصدير الإكسل: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isExporting = false;
        }
    }


    private async Task LoadEmployees()
    {
        _loadingEmployees = true;
        try
        {
            _employees = await DbContext.Employees
                .AsNoTracking()
                .OrderBy(e => e.FileNumber)
                .ToListAsync();

            if (_employees.Any() && _selectedEmployee == null)
            {
                var first = FilteredEmployees.FirstOrDefault() ?? _employees.First();
                await SelectEmployee(first);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ أثناء تحميل الموظفين: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingEmployees = false;
        }
    }

    private async Task SelectEmployee(Employee emp)
    {
        _selectedEmployee = emp;
        await LoadEmployeeDocuments(emp.EmployeeId);
    }

    private async Task LoadEmployeeDocuments(int employeeId)
    {
        _loadingDocs = true;
        try
        {
            var query = from de in DbContext.DocumentEmployees.AsNoTracking()
                        where de.EmployeeId == employeeId && de.IsDeleted == 0
                        join d in DbContext.Documents.AsNoTracking() on de.DocumentId equals d.DocumentId
                        where d.IsDeleted == 0
                        orderby d.DocumentDate descending
                        select new
                        {
                            Doc = d,
                            SharedCount = DbContext.DocumentEmployees.Count(x =>
                                x.DocumentId == d.DocumentId &&
                                x.EmployeeId != employeeId &&
                                x.IsDeleted == 0)
                        };

            var results = await query.ToListAsync();

            _documents = results.Select(r => r.Doc).ToList();
            _sharedCounts = results.ToDictionary(r => r.Doc.DocumentId, r => r.SharedCount);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ أثناء جلب المستندات: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingDocs = false;
        }
    }


    private async Task DeleteSelectedEmployee()
    {
        if (_selectedEmployee == null) return;

        if (!SessionService.CanDeleteEmployee)
        {
            Snackbar.Add("عذراً، لا تملك الصلاحية اللازمة لحذف الموظفين!", Severity.Error);
            return;
        }

        bool hasDocuments = await DbContext.DocumentEmployees
            .AnyAsync(de => de.EmployeeId == _selectedEmployee.EmployeeId);

        if (hasDocuments)
        {
            await DialogService.ShowMessageBox(
                "لا يمكن نقل الإضبارة إلى سلة المحذوفات",
                $"الموظف ({_selectedEmployee.EmployeeName}) يحتوي على كتب ووثائق رسمية مؤرشفة في إضباره.\nلحماية البيانات، يرجى حذف أو فك ارتباط المستندات أولاً، أو تعديل حالة الموظف إلى (غير فعال).",
                yesText: "حسناً");
            return;
        }

        bool? confirm = await DialogService.ShowMessageBox(
            "تأكيد نقل الموظف إلى سلة المحذوفات",
            $"هل أنت متأكد من حذف إضبارة الموظف: ({_selectedEmployee.EmployeeName})؟\nسيتم نقله إلى سلة المحذوفات مع إمكانية استعادته لاحقاً بواسطة مدير النظام.",
            yesText: "نعم، نقل للسلة",
            cancelText: "إلغاء");

        if (confirm != true) return;

        int deletedEmpId = _selectedEmployee.EmployeeId;
        string deletedEmpName = _selectedEmployee.EmployeeName;
        string deletedFileNum = _selectedEmployee.FileNumber;

        try
        {
            var empDb = await DbContext.Employees.FirstOrDefaultAsync(e => e.EmployeeId == deletedEmpId);
            if (empDb != null)
            {
                empDb.IsDeleted = 1;
                empDb.DeletedAt = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
                DbContext.Employees.Update(empDb);
                await DbContext.SaveChangesAsync();

                await SessionService.LogActivityAsync(
                    actionType: "حذف موظف (سلة المحذوفات)",
                    entityType: "موظف",
                    entityId: deletedEmpId,
                    description: $"تم نقل إضبارة الموظف ({deletedEmpName}) ذات رقم الإضبارة ({deletedFileNum}) إلى سلة المحذوفات."
                );
            }

            _employees.Remove(_selectedEmployee);
            _selectedEmployee = _employees.FirstOrDefault();

            if (_selectedEmployee != null)
            {
                await SelectEmployee(_selectedEmployee);
            }
            else
            {
                _documents.Clear();
            }

            Snackbar.Add($"تم نقل إضبارة الموظف ({deletedEmpName}) إلى سلة المحذوفات بنجاح", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"حدث خطأ أثناء نقل الموظف للسلة: {ex.Message}", Severity.Error);
        }
    }


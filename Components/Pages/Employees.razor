@page "/employees"
@page "/"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using DossierArchiveApp.Data
@using DossierArchiveApp.Models
@using DossierArchiveApp.Services
@using DossierArchiveApp.Components.Dialogs
@inject AppDbContext DbContext
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject UserSessionService SessionService
@inject ExportService ExportService

<PageTitle>أضابير الموظفين والأرشيف</PageTitle>

<div dir="rtl" class="pa-3 pa-md-4" style="background-color: #f6f7f9; min-height: 92vh; text-align: right;">

    <!-- الشريط العلوي المتجاوب -->
    <div class="d-flex flex-wrap align-center justify-space-between gap-2 mb-3">
        <!-- فلاتر وبحث الموظفين (في اليمين) -->
        <div class="d-flex flex-grow-1 align-center gap-2" style="max-width: 650px; min-width: 260px;">
            <MudTextField @bind-Value="_employeeSearchText"
                          Placeholder="بحث باسم الموظف أو رقم الأضبارة..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Clearable="true"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="flex-grow-1"
                          Style="background-color: white;" />

            <MudSelect T="string"
                       @bind-Value="_employeeStatusFilter"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Dense="true"
                       Style="background-color: white; min-width: 110px; max-width: 130px;">
                <MudSelectItem Value="@("Active")">الفعالون</MudSelectItem>
                <MudSelectItem Value="@("Inactive")">غير الفعالين</MudSelectItem>
                <MudSelectItem Value="@("All")">الكل</MudSelectItem>
            </MudSelect>
        </div>

        <!-- أزرار الإجراءات بالترتيب: إضافة مستند -> أرشفة مجمعة -> خط فاصل -> زر منسدل -->
        <div class="d-flex align-center gap-2 flex-wrap">
            @if (_selectedEmployee != null)
            {
                @if (SessionService.CanAdd)
                {
                    <!-- 1. زر إضافة مستند فردي -->
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.NoteAdd"
                               OnClick="OpenAddDocumentDialog"
                               Style="background-color: #1B4D3E; color: white; border-radius: 6px; font-weight: bold; padding: 7px 18px; white-space: nowrap;">
                        إضافة مستند
                    </MudButton>

                    <!-- 2. زر الأرشفة الذكية المجمعة -->
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Tertiary"
                               StartIcon="@Icons.Material.Filled.AutoFixHigh"
                               OnClick="OpenBulkUploadDialog"
                               Style="background-color: #2E7D32; color: white; border-radius: 6px; font-weight: bold; padding: 7px 16px; white-space: nowrap;">
                        أرشفة ذكية مجمعة
                    </MudButton>
                }

                @if (_documents.Any())
                {
                    <!-- 3. خط عمودي فاصل -->
                    <MudDivider Vertical="true" FlexItem="true" Class="mx-1" Style="height: 28px; border-color: #cfd8dc;" />

                    <!-- 4. زر منسدل موحد للمخرجات (طباعة الفهرس + تصدير Excel) -->
                    <MudMenu Label="استخراج وفهرسة"
                             Variant="Variant.Outlined"
                             Color="Color.Primary"
                             StartIcon="@Icons.Material.Filled.Assignment"
                             EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                             AnchorOrigin="Origin.BottomRight"
                             TransformOrigin="Origin.TopRight"
                             Style="border-radius: 6px; font-weight: bold; background-color: white; white-space: nowrap;">

                        <MudMenuItem Icon="@Icons.Material.Filled.Print"
                                     IconColor="Color.Primary"
                                     OnClick="OpenPrintDialog"
                                     Disabled="@(!SessionService.CanExport)">
                            طباعة الفهرس (A4)
                        </MudMenuItem>

                        <MudMenuItem Icon="@Icons.Custom.FileFormats.FileExcel"
                                     IconColor="Color.Success"
                                     OnClick="ExportToExcel"
                                     Disabled="@(_isExporting || !SessionService.CanExport)">
                            @if (_isExporting)
                            {
                                <span>جارٍ التصدير...</span>
                            }
                            else
                            {
                                <span>تصدير إلى Excel</span>
                            }
                        </MudMenuItem>
                    </MudMenu>
                }
            }
        </div>
    </div>

    <!-- شبكة العرض الرئيسية المتجاوبة -->
    <MudGrid Spacing="2">

        <!-- 1. قائمة الموظفين (في اليمين) -->
        <MudItem xs="12" md="4" lg="3">
            <MudPaper Elevation="1" Class="pa-3" Style="border-radius: 8px; background-color: white; height: 100%; display: flex; flex-direction: column;">
                <MudText Typo="Typo.h6" Class="fw-bold text-center mb-2" Style="color: #1B4D3E;">
                    الموظفون (@FilteredEmployees.Count)
                </MudText>

                @if (SessionService.CanAddEmployee)
                {
                    <MudButton Variant="Variant.Filled"
                               FullWidth="true"
                               Class="mb-2"
                               OnClick="OpenAddEmployeeDialog"
                               Style="background-color: #F4E8D1; color: #7A5B15; font-weight: bold; border-radius: 6px;">
                        إضافة موظف
                    </MudButton>
                }

                <div class="d-flex gap-2 mb-2">
                    @if (SessionService.CanEditEmployee)
                    {
                        <MudButton Variant="Variant.Filled"
                                   FullWidth="true"
                                   Disabled="@(_selectedEmployee == null)"
                                   OnClick="OpenEditEmployeeDialog"
                                   Style="@(_selectedEmployee != null ? "background-color: #E3F2FD; color: #1565C0; font-weight: bold;" : "")">
                            تعديل
                        </MudButton>
                    }
                    @if (SessionService.CanDeleteEmployee)
                    {
                        <MudButton Variant="Variant.Filled"
                                   FullWidth="true"
                                   Disabled="@(_selectedEmployee == null)"
                                   OnClick="DeleteSelectedEmployee"
                                   Style="@(_selectedEmployee != null ? "background-color: #B71C1C; color: white; font-weight: bold;" : "")">
                            حذف
                        </MudButton>
                    }
                </div>

                <!-- قائمة الموظفين مدعومة بـ Virtualize بدون أي تحذيرات CSS -->
                <div class="dynamic-employee-scroll pa-1" style="height: calc(100vh - 275px); overflow-y: auto;">
                    @if (_loadingEmployees)
                    {
                        <div class="d-flex justify-center pa-4">
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                        </div>
                    }
                    else if (!FilteredEmployees.Any())
                    {
                        <div class="pa-4 text-center">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">لا يوجد موظفون مطابقون لبحثك.</MudText>
                        </div>
                    }
                    else
                    {
                        <Virtualize TItem="Employee" Items="@FilteredEmployees" Context="emp">
                            <ItemContent>
                                @{
                                    bool isSelected = _selectedEmployee?.EmployeeId == emp.EmployeeId;
                                }
                                <div class="employee-card pa-2 mb-2 @(isSelected ? "selected-card" : "normal-card")"
                                     @onclick="@(() => SelectEmployee(emp))">
                                    <div class="d-flex justify-space-between align-center">
                                        <div style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                            <MudText Typo="Typo.body2" Class="fw-bold" Style="@(isSelected ? "color: #1B4D3E;" : "color: #212121;")">
                                                @emp.EmployeeName
                                            </MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                الأضبارة: @emp.FileNumber
                                            </MudText>
                                        </div>
                                        @if (emp.IsActive != 1)
                                        {
                                            <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Text">معطل</MudChip>
                                        }
                                    </div>
                                </div>
                            </ItemContent>
                        </Virtualize>
                    }
                </div>
            </MudPaper>
        </MudItem>

        <!-- 2. منطقة المستندات والفلاتر (في اليسار) -->
        <MudItem xs="12" md="8" lg="9">
            <MudPaper Elevation="1" Class="pa-3 pa-md-4" Style="border-radius: 8px; min-height: calc(100vh - 170px); background-color: white;">
                @if (_selectedEmployee != null)
                {
                    <div class="d-flex align-center justify-start mb-3">
                        <MudText Typo="Typo.h6" Class="fw-bold" Style="color: #2c3e50;">
                            كتب @_selectedEmployee.EmployeeName (@FilteredDocuments.Count())
                        </MudText>
                    </div>

                    <!-- السطر الأول: القوائم الأربع المنسدلة تتبع الهيكلية المعتمدة -->
                    <MudGrid Spacing="2" Class="mb-2">

                        <!-- 1. نوع الكتاب -->
                        <MudItem xs="12" sm="6" md="3">
                            <MudSelect T="int?" Value="_selectedMainCatId"
                                       ValueChanged="OnMainCategoryChanged"
                                       Label="نوع الكتاب"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Dense="true"
                                       Clearable="true"
                                       Class="compact-filter-field">
                                <MudSelectItem Value="@((int?)null)">الكل</MudSelectItem>
                                @foreach (var cat in _mainCategories)
                                {
                                    <MudSelectItem Value="@((int?)cat.MainCategoryId)">@cat.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <!-- 2. التصنيف الرئيسي -->
                        <MudItem xs="12" sm="6" md="3">
                            <MudSelect T="int?" Value="_selectedPrimaryCatId"
                                       ValueChanged="OnPrimaryCategoryChanged"
                                       Label="التصنيف الرئيسي"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Dense="true"
                                       Clearable="true"
                                       Disabled="@(_selectedMainCatId == null || !AvailablePrimaryCategories.Any())"
                                       Class="compact-filter-field">
                                <MudSelectItem Value="@((int?)null)">الكل</MudSelectItem>
                                @foreach (var cat in AvailablePrimaryCategories)
                                {
                                    <MudSelectItem Value="@((int?)cat.PrimaryCategoryId)">@cat.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <!-- 3. التصنيف الفرعي الأول -->
                        <MudItem xs="12" sm="6" md="3">
                            <MudSelect T="int?" Value="_selectedSecondaryCatId"
                                       ValueChanged="OnSecondaryCategoryChanged"
                                       Label="الفرعي الأول"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Dense="true"
                                       Clearable="true"
                                       Disabled="@(_selectedPrimaryCatId == null || !AvailableSecondaryCategories.Any())"
                                       Class="compact-filter-field">
                                <MudSelectItem Value="@((int?)null)">الكل</MudSelectItem>
                                @foreach (var cat in AvailableSecondaryCategories)
                                {
                                    <MudSelectItem Value="@((int?)cat.SecondaryCategoryId)">@cat.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <!-- 4. التصنيف الفرعي الثاني -->
                        <MudItem xs="12" sm="6" md="3">
                            <MudSelect T="int?" @bind-Value="_selectedTertiaryCatId"
                                       Label="الفرعي الثاني"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Dense="true"
                                       Clearable="true"
                                       Disabled="@(!IsTertiaryEnabled || !AvailableTertiaryCategories.Any())"
                                       Class="compact-filter-field">
                                <MudSelectItem Value="@((int?)null)">الكل</MudSelectItem>
                                @foreach (var cat in AvailableTertiaryCategories)
                                {
                                    <MudSelectItem Value="@((int?)cat.TertiaryCategoryId)">@cat.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    </MudGrid>

                    <!-- السطر الثاني: الموضوع والرقم والتاريخ -->
                    <MudGrid Spacing="2" Class="mb-3">

                        <!-- 1. موضوع الكتاب -->
                        <MudItem xs="12" sm="6" md="3">
                            <MudTextField @bind-Value="_docSubjectFilter"
                                          Label="الموضوع"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Clearable="true"
                                          Immediate="true"
                                          Class="compact-filter-field" />
                        </MudItem>

                        <!-- 2. رقم الكتاب -->
                        <MudItem xs="12" sm="6" md="3">
                            <MudTextField @bind-Value="_docNumberFilter"
                                          Label="رقم الكتاب"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Clearable="true"
                                          Immediate="true"
                                          Class="compact-filter-field" />
                        </MudItem>

                        <!-- 3. من تاريخ -->
                        <MudItem xs="12" sm="6" md="3">
                            <MudDatePicker Label="من تاريخ"
                                           @bind-Date="_dateFrom"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Clearable="true"
                                           DateFormat="yyyy/MM/dd"
                                           Class="compact-filter-field date-compact" />
                        </MudItem>

                        <!-- 4. إلى تاريخ -->
                        <MudItem xs="12" sm="6" md="3">
                            <MudDatePicker Label="إلى تاريخ"
                                           @bind-Date="_dateTo"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Clearable="true"
                                           DateFormat="yyyy/MM/dd"
                                           Class="compact-filter-field date-compact" />
                        </MudItem>
                    </MudGrid>

                    <MudDivider Class="my-2" />

                    <!-- جدول استعراض كتب الموظف -->
                    <div style="overflow-x: auto;">
                        <MudTable Items="@FilteredDocuments"
                                  Dense="true"
                                  Hover="true"
                                  Elevation="0"
                                  Height="calc(100vh - 310px)"
                                  FixedHeader="true"
                                  Loading="@_loadingDocs"
                                  LoadingProgressColor="Color.Primary"
                                  Class="responsive-dynamic-table">
                            <HeaderContent>
                                <MudTh Style="font-weight: bold; background-color: #fafafa; white-space: nowrap; width: 120px;">الرقم</MudTh>
                                <MudTh Style="font-weight: bold; background-color: #fafafa; min-width: 160px;">الموضوع</MudTh>
                                <MudTh Style="font-weight: bold; background-color: #fafafa; white-space: nowrap; width: 110px;">التاريخ</MudTh>
                                <MudTh Style="font-weight: bold; background-color: #fafafa; min-width: 140px;">التصنيف الشجري</MudTh>
                                <MudTh Style="font-weight: bold; background-color: #fafafa; text-align: center; width: 55px; white-space: nowrap; padding: 6px 10px;">الملف</MudTh>
                                <MudTh Style="font-weight: bold; background-color: #fafafa; text-align: center; width: 95px; white-space: nowrap; padding: 6px 10px;">إجراء</MudTh>
                                <MudTh Style="font-weight: bold; background-color: #fafafa; text-align: center; width: 95px; white-space: nowrap; padding: 6px 10px;">المشتركون</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="الرقم">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                                        @context.DocumentNumber
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="الموضوع" Class="fw-bold">@context.Subject</MudTd>
                                <MudTd DataLabel="التاريخ" Style="white-space: nowrap;">
                                    @(context.DocumentDate?.ToString("yyyy/MM/dd") ?? "—")
                                </MudTd>
                                <MudTd DataLabel="التصنيف الشجري">
                                    @GetCategoryHierarchyName(context)
                                </MudTd>

                                <!-- عمود الملف -->
                                <MudTd DataLabel="الملف" Style="text-align: center; width: 55px; white-space: nowrap; padding: 6px 10px;">
                                    <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="@(() => ViewDocument(context))" />
                                </MudTd>

                                <!-- عمود الإجراء -->
                                <MudTd DataLabel="إجراء" Style="text-align: center; width: 95px; white-space: nowrap; padding: 6px 10px;">
                                    <div class="d-flex justify-center align-center gap-2">
                                        @if (SessionService.CanEdit)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                           Color="Color.Info"
                                                           Size="Size.Small"
                                                           Title="تعديل المستند"
                                                           OnClick="@(() => OpenEditDocumentDialog(context))" />
                                        }

                                        @if (SessionService.CanDelete)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                           Color="Color.Error"
                                                           Size="Size.Small"
                                                           Title="حذف المستند"
                                                           OnClick="@(() => DeleteDocument(context))" />
                                        }
                                    </div>
                                </MudTd>

                                <!-- عمود المشتركون -->
                                <MudTd DataLabel="المشتركون" Style="text-align: center; width: 95px; white-space: nowrap; padding: 6px 10px;">
                                    @if (_sharedCounts.TryGetValue(context.DocumentId, out int sharedCount) && sharedCount > 0)
                                    {
                                        <MudChip T="string"
                                                 Variant="Variant.Filled"
                                                 Size="Size.Small"
                                                 Icon="@Icons.Material.Filled.Group"
                                                 OnClick="@(() => ShowSharedEmployees(context.DocumentId, context.DocumentNumber))"
                                                 Style="cursor: pointer; font-weight: bold; font-size: 0.78rem; background-color: #FADBD8; color: #78281F; border: 1px solid #F5B7B1; height: 26px; padding: 0 8px;"
                                                 Title="انقر لعرض أسماء الموظفين المشتركين">
                                            (@sharedCount)
                                        </MudChip>
                                    }
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <div class="pa-6 text-center">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">لا توجد كتب مطابقة لبحثك.</MudText>
                                </div>
                            </NoRecordsContent>
                        </MudTable>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column align-center justify-center" style="height: 60vh;">
                        <MudIcon Icon="@Icons.Material.Filled.PersonSearch" Size="Size.Large" Color="Color.Secondary" Style="font-size: 4.5rem;" />
                        <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-3 text-center">
                            يرجى اختيار موظف من القائمة لعرض إضبارته ومستنداته
                        </MudText>
                    </div>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</div>

<style>
    .employee-card {
        cursor: pointer;
        border-radius: 6px;
        transition: all 0.2s ease-in-out;
    }

        .employee-card:hover {
            background-color: #f1f7f4 !important;
        }

    .selected-card {
        background-color: #E8F5E9 !important;
        border: 1px solid #C8E6C9 !important;
        border-right: 5px solid #C5A059 !important;
    }

    .normal-card {
        background-color: #FFFFFF;
        border: 1px solid #EEEEEE;
    }

    .compact-filter-field .mud-input-root-outlined {
        height: 36px !important;
        min-height: 36px !important;
        background-color: #ffffff;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        display: flex !important;
        align-items: center !important;
    }

    .compact-filter-field input,
    .compact-filter-field .mud-select-input {
        font-size: 0.88rem !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        height: 34px !important;
        line-height: 34px !important;
        display: flex !important;
        align-items: center !important;
    }

    .compact-filter-field .mud-input-adornment {
        margin-top: 0 !important;
        align-self: center !important;
    }

    .compact-filter-field .mud-input-label-outlined {
        transform: translate(-14px, 9px) scale(1) !important;
        font-size: 0.92rem !important;
        font-weight: 500 !important;
        color: #555555 !important;
    }

        .compact-filter-field .mud-input-label-outlined.mud-input-label-inputcontrol {
            transform: translate(-14px, -8px) scale(0.85) !important;
            font-size: 0.95rem !important;
            font-weight: bold !important;
            background-color: #ffffff !important;
            padding: 0 5px !important;
        }

    .responsive-dynamic-table .mud-table-sticky-header th {
        background-color: #fafafa !important;
        z-index: 2 !important;
        border-bottom: 2px solid #e0e0e0 !important;
    }

    .dynamic-employee-scroll::-webkit-scrollbar,
    .responsive-dynamic-table .mud-table-container::-webkit-scrollbar {
        width: 6px;
    }

    .dynamic-employee-scroll::-webkit-scrollbar-thumb,
    .responsive-dynamic-table .mud-table-container::-webkit-scrollbar-thumb {
        background-color: #cfd8dc;
        border-radius: 4px;
    }

        .dynamic-employee-scroll::-webkit-scrollbar-thumb:hover,
        .responsive-dynamic-table .mud-table-container::-webkit-scrollbar-thumb:hover {
            background-color: #90a4ae;
        }
</style>

@code {
    private List<Employee> _employees = new();
    private Employee? _selectedEmployee;
    private bool _loadingEmployees = true;
    private string _employeeSearchText = "";
    private string _employeeStatusFilter = "Active";

    private List<Document> _documents = new();
    private Dictionary<int, int> _sharedCounts = new();

    private List<MainCategory> _mainCategories = new();
    private List<PrimaryCategory> _primaryCategories = new();
    private List<SecondaryCategory> _secondaryCategories = new();
    private List<TertiaryCategory> _tertiaryCategories = new();
    private bool _loadingDocs = false;
    private bool _isExporting = false;

    // خريطة علاقات: التصنيف الرئيسي -> قائمة التصنيفات الفرعية الأولى المسموحة
    private readonly Dictionary<string, string[]> _primaryToSecondaryMap = new(StringComparer.OrdinalIgnoreCase)
    {
        ["أمر إداري"] = new[] { "مباشرة", "انفكاك", "علاوة", "ترفيع", "شكر", "عقوبة", "لجنة", "تكليف", "تنسيب", "ترشيح", "تقييم", "احتساب", "إضافة", "إعفاء", "دورة", "غير ذلك" },
        ["استمارة"] = new[] { "معلومات", "مستمسكات", "تقييم", "جرد", "غير ذلك" },
        ["طلب شخصي"] = new[] { "إجازة", "نقل", "تنسيب", "تظلم", "مخصصات", "سلفة", "غير ذلك" },
        ["اعتيادية"] = new[] { "مخاطبات", "تبليغ", "استدعاء", "نتيجة", "غير ذلك" }
    };

    private readonly string[] _tertiaryForEnfakak = new[] { "دورة", "مؤتمر", "ورشة", "إجازة", "نقل", "تنسيب", "تقاعد", "تكليف", "غير ذلك" };
    private readonly string[] _tertiaryForEhtisab = new[] { "شهادة", "خدمة", "علاوة", "ترفيع", "شكر", "غير ذلك" };
    private readonly string[] _tertiaryForTakleef = new[] { "منصب", "لجنة", "مهام", "تنسيب", "تكليف", "غير ذلك" };
    private readonly string[] _tertiaryForTarsheeh = new[] { "دورة", "مؤتمر", "ورشة", "تكليف", "لجنة", "غير ذلك" };

    private readonly List<string> _iraqiCommittees = new()
    {
        "تحقيقية", "تدقيقية", "فتح وتحليل العطاءات", "استلام وإنجاز",

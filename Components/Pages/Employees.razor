    private async Task ViewDocument(Document doc)
    {
        try
        {
            var settings = await DbContext.SystemSettings.AsNoTracking().FirstOrDefaultAsync();
            if (settings == null || string.IsNullOrWhiteSpace(settings.BaseFolderPath))
            {
                Snackbar.Add("لم يتم تحديد مسار المجلد الأساسي في الإعدادات!", Severity.Error);
                return;
            }

            string? relativePath = null;
            if (_selectedEmployee != null)
            {
                relativePath = await DbContext.DocumentEmployees
                    .Where(de => de.DocumentId == doc.DocumentId && de.EmployeeId == _selectedEmployee.EmployeeId)
                    .Select(de => de.EmployeeFilePath)
                    .FirstOrDefaultAsync();
            }

            if (string.IsNullOrWhiteSpace(relativePath))
            {
                relativePath = doc.FilePath;
            }

            if (string.IsNullOrWhiteSpace(relativePath))
            {
                Snackbar.Add("مسار المستند غير مسجل في النظام!", Severity.Warning);
                return;
            }

            string fullDiskPath = Path.Combine(settings.BaseFolderPath, relativePath);

            if (!File.Exists(fullDiskPath))
            {
                Snackbar.Add($"الملف غير موجود على القرص: {fullDiskPath}", Severity.Warning);
                return;
            }

            string mode = (settings.PDFViewerMode ?? "internal").Trim().ToLower();

            if (mode == "external")
            {
                var psi = new System.Diagnostics.ProcessStartInfo
                {
                    FileName = fullDiskPath,
                    UseShellExecute = true
                };
                System.Diagnostics.Process.Start(psi);
            }
            else if (mode == "browser")
            {
                byte[] fileBytes = await File.ReadAllBytesAsync(fullDiskPath);
                string base64 = Convert.ToBase64String(fileBytes);
                await JS.InvokeVoidAsync("openPdfFromBase64", base64);
            }
            else
            {
                byte[] fileBytes = await File.ReadAllBytesAsync(fullDiskPath);
                string base64 = Convert.ToBase64String(fileBytes);
                string dataUrl = $"data:application/pdf;base64,{base64}";

                var parameters = new DialogParameters
                {
                    ["Title"] = $"{doc.Subject} - ({doc.DocumentNumber})",
                    ["PdfDataUrl"] = dataUrl
                };
                var options = new DialogOptions
                {
                    MaxWidth = MaxWidth.ExtraLarge,
                    FullWidth = true,
                    CloseButton = false
                };

                await DialogService.ShowAsync<PdfViewerDialog>("استعراض المستند", parameters, options);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"حدث خطأ أثناء فتح المستند: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteDocument(Document doc)
    {
        if (_selectedEmployee == null || doc == null) return;

        if (!SessionService.CanDelete)
        {
            Snackbar.Add("عذراً، لا تملك الصلاحية اللازمة لحذف المستندات!", Severity.Error);
            return;
        }

        try
        {
            // 1. فحص الروابط الفعالة الحالية للكتاب
            var activeLinks = await DbContext.DocumentEmployees
                .Where(de => de.DocumentId == doc.DocumentId && de.IsDeleted == 0)
                .ToListAsync();

            int linkedEmployeesCount = activeLinks.Count;
            bool deleteAll = false;

            // 2. إذا كان الكتاب مشتركاً بين أكثر من موظف، نسأل المستخدم عن نوع الحذف
            if (linkedEmployeesCount > 1)
            {
                var parameters = new DialogParameters
                {
                    ["ContentText"] = $"الكتاب (رقم: {doc.DocumentNumber} - {doc.Subject}) مشترك ومؤرشف في أضابير ({linkedEmployeesCount}) موظفين.\nكيف ترغب في إتمام عملية الحذف؟",
                    ["Button1Text"] = "حذف من الموظف الحالي فقط",
                    ["Button2Text"] = "نقل إلى سلة المحذوفات للجميع",
                    ["CancelText"] = "إلغاء الأمر"
                };

                var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small };
                var dialog = await DialogService.ShowAsync(typeof(DeleteChoiceDialog), "خيارات حذف المستند المشترك", parameters, options);
                var result = await dialog.Result;

                if (result is null || result.Canceled || result.Data == null)
                    return;

                string choice = result.Data.ToString()!;
                deleteAll = (choice == "all");
            }
            else
            {
                // إذا كان مرتبطاً بموظف واحد فقط، فالحذف حتماً هو حذف كلي ونقل للسلة
                deleteAll = true;
            }

            // 3. طلب سبب الحذف إلزامياً في كل الحالات (موظف واحد أو مشترك)
            string dialogTitle = deleteAll ? "تأكيد حذف المستند وإرساله للسلة" : "تأكيد استبعاد المستند من الموظف";
            string dialogMessage = deleteAll
                ? $"سيتم نقل كتاب ({doc.Subject}) ذي الرقم ({doc.DocumentNumber}) إلى سلة المحذوفات. يرجى تدوين سبب الحذف للمسؤول."
                : $"سيتم استبعاد كتاب ({doc.Subject}) ذي الرقم ({doc.DocumentNumber}) من إضبارة ({_selectedEmployee.EmployeeName}) فقط.";

            var reasonParams = new DialogParameters
            {
                ["Title"] = dialogTitle,
                ["Message"] = dialogMessage
            };
            var reasonOptions = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
            var reasonDialog = await DialogService.ShowAsync<DeleteConfirmationDialog>("سبب الحذف", reasonParams, reasonOptions);
            var reasonResult = await reasonDialog.Result;

            if (reasonResult is null || reasonResult.Canceled || reasonResult.Data == null)
                return;

            string deleteReason = reasonResult.Data.ToString()!;
            int? currentUserId = SessionService.CurrentUser?.UserId;
            DateTime now = DateTime.Now;

            if (deleteAll)
            {
                // أ) تحديث سجل المستند الأصلي
                var docDb = await DbContext.Documents.FirstOrDefaultAsync(d => d.DocumentId == doc.DocumentId);
                if (docDb != null)
                {
                    docDb.IsDeleted = 1;
                    docDb.DeletedAt = now;
                    docDb.DeletedBy = currentUserId;
                    docDb.DeleteReason = deleteReason;

                    DbContext.Documents.Update(docDb);
                }

                // ب) تحديث كافة روابط المستند لتصبح محذوفة أيضاً
                var allDocLinks = await DbContext.DocumentEmployees
                    .Where(de => de.DocumentId == doc.DocumentId)
                    .ToListAsync();

                foreach (var link in allDocLinks)
                {
                    link.IsDeleted = 1;
                    link.DeletedAt = now;
                    link.DeletedBy = currentUserId;
                    link.DeleteReason = deleteReason;
                    DbContext.DocumentEmployees.Update(link);
                }

                await DbContext.SaveChangesAsync();

                await SessionService.LogActivityAsync(
                    actionType: "حذف مستند (سلة المحذوفات)",
                    entityType: "مستند",
                    entityId: doc.DocumentId,
                    description: $"تم نقل كتاب ({doc.Subject}) [رقم: {doc.DocumentNumber}] إلى السلة. السبب: ({deleteReason})"
                );

                Snackbar.Add("تم نقل المستند إلى سلة المحذوفات بنجاح", Severity.Success);
            }
            else
            {
                // حذف فردي: إبقاء المستند نشطاً وتعديل رابط الموظف الحالي فقط
                var currentLink = activeLinks.FirstOrDefault(de => de.EmployeeId == _selectedEmployee.EmployeeId);
                if (currentLink != null)
                {
                    currentLink.IsDeleted = 1;
                    currentLink.DeletedAt = now;
                    currentLink.DeletedBy = currentUserId;
                    currentLink.DeleteReason = deleteReason;

                    DbContext.DocumentEmployees.Update(currentLink);
                    await DbContext.SaveChangesAsync();

                    await SessionService.LogActivityAsync(
                        actionType: "استبعاد مستند من موظف",
                        entityType: "مستند / موظف",
                        entityId: doc.DocumentId,
                        description: $"تم استبعاد كتاب ({doc.Subject}) من إضبارة ({_selectedEmployee.EmployeeName}). السبب: ({deleteReason})"
                    );

                    Snackbar.Add($"تم استبعاد المستند من إضبارة ({_selectedEmployee.EmployeeName}) ونقله للسلة الفردية", Severity.Success);
                }
            }

            // تحديث واجهة إضبارة الموظف فوراً
            await LoadEmployeeDocuments(_selectedEmployee.EmployeeId);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"حدث خطأ أثناء تنفيذ عملية الحذف: {ex.Message}", Severity.Error);
        }
    }

    private async Task ExportToExcel()
    {
        if (!SessionService.CanExport)
        {
            Snackbar.Add("عذراً، لا تملك الصلاحية اللازمة لتصدير البيانات!", Severity.Error);
            return;
        }

        if (_selectedEmployee == null || !_documents.Any())
        {
            Snackbar.Add("لا توجد مستندات لتصديرها لهذا الموظف!", Severity.Warning);
            return;
        }

        _isExporting = true;
        try
        {
            var settings = await DbContext.SystemSettings.AsNoTracking().FirstOrDefaultAsync();

            var docsToExport = FilteredDocuments.ToList();
            if (!docsToExport.Any())
            {
                docsToExport = _documents;
            }

            byte[] fileBytes = ExportService.ExportEmployeeDocumentsToExcel(_selectedEmployee, docsToExport, settings);
            string base64 = Convert.ToBase64String(fileBytes);

            string safeEmpName = string.Join("_", _selectedEmployee.EmployeeName.Split(Path.GetInvalidFileNameChars()));
            string fileName = $"اضبارة_{safeEmpName}_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";

            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, base64);

            await SessionService.LogActivityAsync(
                actionType: "تصدير Excel",
                entityType: "إضبارة موظف",
                entityId: _selectedEmployee.EmployeeId,
                description: $"قام المستخدم ({SessionService.CurrentUser?.UserName}) بتصدير فهرس كتب الموظف ({_selectedEmployee.EmployeeName}) إلى ملف Excel يحتوي ({docsToExport.Count}) كتاباً."
            );

            Snackbar.Add("تم تصدير ملف الإكسل بنجاح!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"حدث خطأ أثناء تصدير الإكسل: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isExporting = false;
        }
    }

    private async Task OpenPrintDialog()
    {
        if (!SessionService.CanExport)
        {
            Snackbar.Add("عذراً، لا تملك الصلاحية اللازمة لطباعة وتصدير الفهرس!", Severity.Error);
            return;
        }

        if (_selectedEmployee == null || !_documents.Any()) return;

        await JS.InvokeVoidAsync("open", $"/print-dossier/{_selectedEmployee.EmployeeId}", "_blank");

        await SessionService.LogActivityAsync(
            actionType: "طباعة فهرس إضبارة",
            entityType: "إضبارة موظف",
            entityId: _selectedEmployee.EmployeeId,
            description: $"قام المستخدم ({SessionService.CurrentUser?.UserName}) بفتح وطباعة فهرس إضبارة الموظف ({_selectedEmployee.EmployeeName})."
        );
    }
}
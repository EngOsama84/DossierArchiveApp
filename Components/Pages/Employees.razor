@page "/employees"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using DossierArchiveApp.Data
@using DossierArchiveApp.Models
@inject AppDbContext DbContext
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>أضابير الموظفين والأرشيف</PageTitle>

<div dir="rtl" class="pa-4" style="background-color: #f6f7f9; min-height: 92vh; text-align: right;">

    <!-- الشريط العلوي -->
    <div class="d-flex justify-space-between align-center mb-3">
        <!-- فلاتر الموظفين في اليمين -->
        <div class="d-flex align-center gap-2">
            <MudTextField @bind-Value="_employeeSearchText"
                          Placeholder="بحث باسم الموظف أو رقم الأضبارة..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Clearable="true"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="background-color: white; width: 280px;" />

            <MudSelect T="string"
                       @bind-Value="_employeeStatusFilter"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Dense="true"
                       Style="background-color: white; width: 140px;">
                <MudSelectItem Value="@("Active")">الفعالون</MudSelectItem>
                <MudSelectItem Value="@("Inactive")">غير الفعالين</MudSelectItem>
                <MudSelectItem Value="@("All")">الكل</MudSelectItem>
            </MudSelect>
        </div>

        <!-- زر إضافة مستند في اليسار -->
        <div>
            @if (_selectedEmployee != null)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.NoteAdd"
                           OnClick="OpenAddDocumentDialog"
                           Style="background-color: #1B4D3E; color: white; border-radius: 6px; font-weight: bold; padding: 8px 24px;">
                    إضافة مستند
                </MudButton>
            }
        </div>
    </div>

    <!-- شبكة العرض الرئيسية -->
    <MudGrid Spacing="3">

        <!-- 1. قائمة الموظفين (في اليمين) -->
        <MudItem xs="12" md="3">
            <MudPaper Elevation="1" Class="pa-3" Style="border-radius: 8px; background-color: white;">
                <MudText Typo="Typo.h5" Class="fw-bold text-center mb-3" Style="color: #1B4D3E;">
                    الموظفون
                </MudText>

                <MudButton Variant="Variant.Filled"
                           FullWidth="true"
                           Class="mb-2"
                           OnClick="OpenAddEmployeeDialog"
                           Style="background-color: #F4E8D1; color: #7A5B15; font-weight: bold; border-radius: 6px;">
                    إضافة موظف
                </MudButton>

                <div class="d-flex gap-2 mb-3">
                    <MudButton Variant="Variant.Filled"
                               FullWidth="true"
                               Disabled="@(_selectedEmployee == null)"
                               OnClick="OpenEditEmployeeDialog"
                               Style="@(_selectedEmployee != null ? "background-color: #E3F2FD; color: #1565C0; font-weight: bold;" : "")">
                        تعديل
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               FullWidth="true"
                               Disabled="@(_selectedEmployee == null)"
                               OnClick="DeleteSelectedEmployee"
                               Style="@(_selectedEmployee != null ? "background-color: #B71C1C; color: white; font-weight: bold;" : "")">
                        حذف
                    </MudButton>
                </div>

                <div style="max-height: 68vh; overflow-y: auto; padding-right: 4px;">
                    @if (_loadingEmployees)
                    {
                        <div class="d-flex justify-center pa-4">
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                        </div>
                    }
                    else
                    {
                        @foreach (var emp in FilteredEmployees)
                        {
                            bool isSelected = _selectedEmployee?.EmployeeId == emp.EmployeeId;
                            <div class="employee-card pa-3 mb-2"
                                 @onclick="@(() => SelectEmployee(emp))"
                                 style="@GetEmployeeCardStyle(isSelected)">
                                <div class="d-flex justify-space-between align-center">
                                    <div>
                                        <MudText Typo="Typo.subtitle1" Class="fw-bold" Style="@(isSelected ? "color: #1B4D3E;" : "color: #212121;")">
                                            @emp.EmployeeName
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            الأضبارة: @emp.FileNumber
                                        </MudText>
                                    </div>
                                    @if (emp.IsActive != 1)
                                    {
                                        <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Text">معطل</MudChip>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </MudPaper>
        </MudItem>

        <!-- 2. منطقة المستندات والفلاتر (في اليسار) -->
        <MudItem xs="12" md="9">
            <MudPaper Elevation="1" Class="pa-5" Style="border-radius: 8px; min-height: 80vh; background-color: white;">
                @if (_selectedEmployee != null)
                {
                    <div class="d-flex align-center justify-start mb-4">
                        <MudText Typo="Typo.h5" Class="fw-bold" Style="color: #2c3e50;">
                            كتب @_selectedEmployee.EmployeeName
                        </MudText>
                    </div>

                    <!-- شريط فلاتر التصنيفات الأربعة الشجرية المشروطة + حقول البحث -->
                    <MudGrid Spacing="2" Class="mb-2">

                        <!-- 1. نوع الكتاب (المستوى الأول - مفعل دائماً) -->
                        <MudItem xs="12" sm="2">
                            <MudSelect T="int?" Value="_selectedMainCatId"
                                       ValueChanged="OnMainCategoryChanged"
                                       Label="نوع الكتاب: الكل"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Dense="true"
                                       Clearable="true">
                                <MudSelectItem Value="@((int?)null)">الكل</MudSelectItem>
                                @foreach (var cat in _mainCategories)
                                {
                                    <MudSelectItem Value="@((int?)cat.MainCategoryId)">@cat.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <!-- 2. التصنيف الرئيسي (معطل حتى يتم اختيار نوع الكتاب) -->
                        <MudItem xs="12" sm="2">
                            <MudSelect T="int?" Value="_selectedPrimaryCatId"
                                       ValueChanged="OnPrimaryCategoryChanged"
                                       Label="التصنيف الرئيسي: الكل"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Dense="true"
                                       Clearable="true"
                                       Disabled="@(_selectedMainCatId == null || !AvailablePrimaryCategories.Any())">
                                <MudSelectItem Value="@((int?)null)">الكل</MudSelectItem>
                                @foreach (var cat in AvailablePrimaryCategories)
                                {
                                    <MudSelectItem Value="@((int?)cat.PrimaryCategoryId)">@cat.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <!-- 3. التصنيف الفرعي الأول (معطل حتى يتم اختيار التصنيف الرئيسي) -->
                        <MudItem xs="12" sm="2">
                            <MudSelect T="int?" Value="_selectedSecondaryCatId"
                                       ValueChanged="OnSecondaryCategoryChanged"
                                       Label="الفرعي الأول: الكل"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Dense="true"
                                       Clearable="true"
                                       Disabled="@(_selectedPrimaryCatId == null || !AvailableSecondaryCategories.Any())">
                                <MudSelectItem Value="@((int?)null)">الكل</MudSelectItem>
                                @foreach (var cat in AvailableSecondaryCategories)
                                {
                                    <MudSelectItem Value="@((int?)cat.SecondaryCategoryId)">@cat.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <!-- 4. التصنيف الفرعي الثاني (معطل دائماً إلا إذا كان الفرعي الأول له تفرع فرعي ثانٍ أو كان لجنة) -->
                        <MudItem xs="12" sm="2">
                            <MudSelect T="int?" @bind-Value="_selectedTertiaryCatId"
                                       Label="الفرعي الثاني: الكل"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Dense="true"
                                       Clearable="true"
                                       Disabled="@(!IsTertiaryEnabled)">
                                <MudSelectItem Value="@((int?)null)">الكل</MudSelectItem>
                                @foreach (var cat in AvailableTertiaryCategories)
                                {
                                    <MudSelectItem Value="@((int?)cat.TertiaryCategoryId)">@cat.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <!-- موضوع الكتاب -->
                        <MudItem xs="12" sm="2">
                            <MudTextField @bind-Value="_docSubjectFilter"
                                          Placeholder="موضوع الكتاب"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Clearable="true"
                                          Immediate="true" />
                        </MudItem>

                        <!-- رقم الكتاب -->
                        <MudItem xs="12" sm="2">
                            <MudTextField @bind-Value="_docNumberFilter"
                                          Placeholder="رقم الكتاب"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Clearable="true"
                                          Immediate="true" />
                        </MudItem>
                    </MudGrid>

                    <!-- فلاتر التواريخ والملاحظة -->
                    <MudGrid Spacing="2" Class="mb-1" Justify="Justify.Center">
                        <MudItem xs="12" sm="4">
                            <MudDatePicker Label="من تاريخ"
                                           @bind-Date="_dateFrom"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Clearable="true"
                                           DateFormat="yyyy/MM/dd" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudDatePicker Label="إلى تاريخ"
                                           @bind-Date="_dateTo"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Clearable="true"
                                           DateFormat="yyyy/MM/dd" />
                        </MudItem>
                        <MudItem xs="12" sm="4" Class="text-end">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                البحث والفلاتر تعمل تلقائياً أثناء التغيير.
                            </MudText>
                        </MudItem>
                    </MudGrid>

                    <MudDivider Class="my-3" />

                    <!-- جدول استعراض كتب الموظف -->
                    <MudTable Items="@FilteredDocuments"
                              Dense="true"
                              Hover="true"
                              Elevation="0"
                              Loading="@_loadingDocs"
                              LoadingProgressColor="Color.Primary">
                        <HeaderContent>
                            <MudTh Style="font-weight: bold; background-color: #fafafa;">الرقم</MudTh>
                            <MudTh Style="font-weight: bold; background-color: #fafafa;">الموضوع</MudTh>
                            <MudTh Style="font-weight: bold; background-color: #fafafa;">التاريخ</MudTh>
                            <MudTh Style="font-weight: bold; background-color: #fafafa;">التصنيف الشجري</MudTh>
                            <MudTh Style="font-weight: bold; background-color: #fafafa;">الملف</MudTh>
                            <MudTh Style="font-weight: bold; background-color: #fafafa; text-align: center;">إجراء</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="الرقم">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                                    @context.DocumentNumber
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="الموضوع" Class="fw-bold">@context.Subject</MudTd>
                            <MudTd DataLabel="التاريخ">@context.DocumentDate</MudTd>
                            <MudTd DataLabel="التصنيف الشجري">
                                @GetCategoryHierarchyName(context)
                            </MudTd>
                            <MudTd DataLabel="الملف">
                                <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(() => ViewDocument(context))" />
                            </MudTd>
                            <MudTd DataLabel="إجراء" Style="text-align: center;">
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(() => DeleteDocument(context))" />
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <div class="pa-8 text-center">
                                <MudText Typo="Typo.body1" Color="Color.Secondary">لا توجد كتب مطابقة.</MudText>
                            </div>
                        </NoRecordsContent>
                    </MudTable>
                }
                else
                {
                    <div class="d-flex flex-column align-center justify-center" style="height: 60vh;">
                        <MudIcon Icon="@Icons.Material.Filled.PersonSearch" Size="Size.Large" Color="Color.Secondary" Style="font-size: 5rem;" />
                        <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-3">
                            يرجى اختيار موظف من القائمة لعرض إضبارته ومستنداته
                        </MudText>
                    </div>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</div>

<style>
    .employee-card {
        cursor: pointer;
        border-radius: 6px;
        transition: all 0.2s ease-in-out;
    }

        .employee-card:hover {
            background-color: #f1f7f4 !important;
        }
</style>

@code {
    private List<Employee> _employees = new();
    private Employee? _selectedEmployee;
    private bool _loadingEmployees = true;
    private string _employeeSearchText = "";
    private string _employeeStatusFilter = "Active";

    private List<Document> _documents = new();

    // قوائم التصنيفات الأربعة الكاملة
    private List<MainCategory> _mainCategories = new();
    private List<PrimaryCategory> _primaryCategories = new();
    private List<SecondaryCategory> _secondaryCategories = new();
    private List<TertiaryCategory> _tertiaryCategories = new();
    private bool _loadingDocs = false;

    // اللجان الرسمية وفق القانون الإداري والمالي العراقي
    private readonly List<string> _iraqiCommittees = new()
    {
        "تحقيقية",
        "تدقيقية",
        "فتح وتحليل العطاءات",
        "استلام وإنجاز",
        "مشتريات واعتدال أسعار",
        "شطب وإتلاف",
        "جرد سنوي",
        "تضمين",
        "تثمين وبيع وإيجار أموال الدولة",
        "احتساب خدمة وتقاعد",
        "فنية تخصصية",
        "مقابلة وترقية"
    };

    // محددات الفلاتر
    private string _docNumberFilter = "";
    private string _docSubjectFilter = "";
    private int? _selectedMainCatId;
    private int? _selectedPrimaryCatId;
    private int? _selectedSecondaryCatId;
    private int? _selectedTertiaryCatId;
    private DateTime? _dateFrom;
    private DateTime? _dateTo;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
        await LoadEmployees();
    }

    private async Task LoadCategories()
    {
        _mainCategories = await DbContext.MainCategories.ToListAsync();
        _primaryCategories = await DbContext.PrimaryCategories.ToListAsync();
        _secondaryCategories = await DbContext.SecondaryCategories.ToListAsync();
        _tertiaryCategories = await DbContext.TertiaryCategories.ToListAsync();
    }

    // التحقق هل الفرعي الأول المختار هو (لجنة)
    private bool IsCurrentSecondaryCommittee
    {
        get
        {
            if (!_selectedSecondaryCatId.HasValue) return false;
            var currentSec = _secondaryCategories.FirstOrDefault(s => s.SecondaryCategoryId == _selectedSecondaryCatId.Value);
            return currentSec != null && currentSec.Name.Contains("لجنة");
        }
    }

    // 1. التصنيف الرئيسي المتاح: يعتمد على نوع الكتاب
    private IEnumerable<PrimaryCategory> AvailablePrimaryCategories =>
        _selectedMainCatId.HasValue
            ? _primaryCategories.Where(p => p.MainCategoryId == _selectedMainCatId.Value)
            : Enumerable.Empty<PrimaryCategory>();

    // 2. التصنيف الفرعي الأول المتاح: يعتمد على التصنيف الرئيسي
    private IEnumerable<SecondaryCategory> AvailableSecondaryCategories =>
        _selectedPrimaryCatId.HasValue
            ? _secondaryCategories.Where(s => s.PrimaryCategoryId == _selectedPrimaryCatId.Value)
            : Enumerable.Empty<SecondaryCategory>();

    // 3. التصنيف الفرعي الثاني المتاح: يشمل ما في قاعدة البيانات + اللجان العراقية إن كان الفرعي الأول لجنة
    private IEnumerable<TertiaryCategory> AvailableTertiaryCategories
    {
        get
        {
            if (!_selectedSecondaryCatId.HasValue)
                return Enumerable.Empty<TertiaryCategory>();

            var dbList = _tertiaryCategories
                .Where(t => t.SecondaryCategoryId == _selectedSecondaryCatId.Value)
                .ToList();

            if (dbList.Any()) return dbList;

            if (IsCurrentSecondaryCommittee)
            {
                int virtualId = -100;
                return _iraqiCommittees.Select(name => new TertiaryCategory
                {
                    TertiaryCategoryId = virtualId--,
                    SecondaryCategoryId = _selectedSecondaryCatId.Value,
                    Name = name
                }).ToList();
            }

            return Enumerable.Empty<TertiaryCategory>();
        }
    }

    // شرط تفعيل القائمة الفرعية الثانية
    private bool IsTertiaryEnabled => _selectedSecondaryCatId.HasValue &&
        (AvailableTertiaryCategories.Any() || IsCurrentSecondaryCommittee);

    // أحداث تحديث الفلاتر الشجرية وتصفير الأبناء عند تغيير الأب (Strict Cascading)
    private void OnMainCategoryChanged(int? value)
    {
        _selectedMainCatId = value;
        _selectedPrimaryCatId = null;
        _selectedSecondaryCatId = null;
        _selectedTertiaryCatId = null;
    }

    private void OnPrimaryCategoryChanged(int? value)
    {
        _selectedPrimaryCatId = value;
        _selectedSecondaryCatId = null;
        _selectedTertiaryCatId = null;
    }

    private void OnSecondaryCategoryChanged(int? value)
    {
        _selectedSecondaryCatId = value;
        _selectedTertiaryCatId = null;
    }

    private async Task LoadEmployees()
    {
        _loadingEmployees = true;
        try
        {
            _employees = await DbContext.Employees
                .OrderBy(e => e.FileNumber)
                .ToListAsync();

            if (_employees.Any() && _selectedEmployee == null)
            {
                await SelectEmployee(_employees.First());
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ أثناء تحميل الموظفين: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingEmployees = false;
        }
    }

    private async Task SelectEmployee(Employee emp)
    {
        _selectedEmployee = emp;
        await LoadEmployeeDocuments(emp.EmployeeId);
    }

    private async Task LoadEmployeeDocuments(int employeeId)
    {
        _loadingDocs = true;
        try
        {
            var docIds = await DbContext.DocumentEmployees
                .Where(de => de.EmployeeId == employeeId)
                .Select(de => de.DocumentId)
                .ToListAsync();

            _documents = await DbContext.Documents
                .Where(d => docIds.Contains(d.DocumentId) && d.IsDeleted == 0)
                .OrderByDescending(d => d.DocumentDate)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ أثناء جلب المستندات: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingDocs = false;
        }
    }

    private IEnumerable<Employee> FilteredEmployees => _employees.Where(e =>
    {
        if (_employeeStatusFilter == "Active" && e.IsActive != 1) return false;
        if (_employeeStatusFilter == "Inactive" && e.IsActive == 1) return false;

        if (!string.IsNullOrWhiteSpace(_employeeSearchText))
        {
            bool matchName = e.EmployeeName.Contains(_employeeSearchText, StringComparison.OrdinalIgnoreCase);
            bool matchFile = e.FileNumber.Contains(_employeeSearchText, StringComparison.OrdinalIgnoreCase);
            if (!matchName && !matchFile) return false;
        }

        return true;
    });

    private IEnumerable<Document> FilteredDocuments => _documents.Where(d =>
    {
        if (!string.IsNullOrWhiteSpace(_docNumberFilter) && !d.DocumentNumber.Contains(_docNumberFilter, StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrWhiteSpace(_docSubjectFilter) && !d.Subject.Contains(_docSubjectFilter, StringComparison.OrdinalIgnoreCase))
            return false;

        if (_selectedMainCatId.HasValue && d.MainCategoryId != _selectedMainCatId.Value)
            return false;

        if (_selectedPrimaryCatId.HasValue && d.PrimaryCategoryId != _selectedPrimaryCatId.Value)
            return false;

        if (_selectedSecondaryCatId.HasValue && d.SecondaryCategoryId != _selectedSecondaryCatId.Value)
            return false;

        if (_selectedTertiaryCatId.HasValue)
        {
            if (_selectedTertiaryCatId.Value < 0)
            {
                var selectedName = AvailableTertiaryCategories.FirstOrDefault(t => t.TertiaryCategoryId == _selectedTertiaryCatId.Value)?.Name;
                if (!string.IsNullOrEmpty(selectedName) && !d.Subject.Contains(selectedName, StringComparison.OrdinalIgnoreCase))
                    return false;
            }
            else if (d.TertiaryCategoryId != _selectedTertiaryCatId.Value)
            {
                return false;
            }
        }

        if (_dateFrom.HasValue && DateTime.TryParse(d.DocumentDate, out var docDate) && docDate < _dateFrom.Value)
            return false;

        if (_dateTo.HasValue && DateTime.TryParse(d.DocumentDate, out var docDate2) && docDate2 > _dateTo.Value)
            return false;

        return true;
    });

    private string GetCategoryHierarchyName(Document doc)
    {
        var main = _mainCategories.FirstOrDefault(c => c.MainCategoryId == doc.MainCategoryId)?.Name;
        var prim = _primaryCategories.FirstOrDefault(c => c.PrimaryCategoryId == doc.PrimaryCategoryId)?.Name;
        var sec = _secondaryCategories.FirstOrDefault(c => c.SecondaryCategoryId == doc.SecondaryCategoryId)?.Name;
        var tert = _tertiaryCategories.FirstOrDefault(c => c.TertiaryCategoryId == doc.TertiaryCategoryId)?.Name;

        var parts = new List<string?> { main, prim, sec, tert }.Where(s => !string.IsNullOrWhiteSpace(s));
        return string.Join(" / ", parts);
    }

    private string GetEmployeeCardStyle(bool isSelected)
    {
        if (isSelected)
        {
            return "background-color: #E8F5E9; border-right: 5px solid #C5A059; border: 1px solid #C8E6C9;";
        }
        return "background-color: #FFFFFF; border: 1px solid #EEEEEE;";
    }

    private async Task OpenAddEmployeeDialog()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<AddEmployeeDialog>("إضافة موظف", options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is Employee createdEmployee)
        {
            // إعادة تحميل قائمة الموظفين وتحديد الموظف المضاف حديثاً
            await LoadEmployees();
            var emp = _employees.FirstOrDefault(e => e.EmployeeId == createdEmployee.EmployeeId);
            if (emp != null)
            {
                await SelectEmployee(emp);
            }
        }
    }

    private async Task OpenEditEmployeeDialog()
    {
        if (_selectedEmployee == null) return;

        var parameters = new DialogParameters { ["EmployeeToEdit"] = _selectedEmployee };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await DialogService.ShowAsync<EditEmployeeDialog>("تعديل موظف", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is Employee updatedEmp)
        {
            // تحديث العنصر في القائمة المحلية فوراً
            var index = _employees.FindIndex(e => e.EmployeeId == updatedEmp.EmployeeId);
            if (index != -1)
            {
                _employees[index] = updatedEmp;
            }
            _selectedEmployee = updatedEmp;
            StateHasChanged();
        }
    }

    private async Task DeleteSelectedEmployee()
    {
        if (_selectedEmployee == null) return;

        // 1. التحقق الاستباقي: هل يمتلك الموظف مستندات وكتباً في إضباره؟
        bool hasDocuments = await DbContext.DocumentEmployees
            .AnyAsync(de => de.EmployeeId == _selectedEmployee.EmployeeId);

        if (hasDocuments)
        {
            // منع الحذف لحماية الوثائق
            await DialogService.ShowMessageBox(
                "لا يمكن حذف الإضبارة",
                $"الموظف ({_selectedEmployee.EmployeeName}) يحتوي على كتب ووثائق رسمية مؤرشفة في إضباره.\nلحماية البيانات والوثائق الإدارية، يمنع حذف الموظف نهائياً. يمكنك تعديل حالته إلى (غير فعال) بدلاً من الحذف.",
                yesText: "حسناً");
            return;
        }

        // 2. تأكيد بشري صريح في حال كانت الإضبارة فارغة
        bool? confirm = await DialogService.ShowMessageBox(
            "تأكيد حذف الموظف",
            $"هل أنت متأكد من حذف إضبارة الموظف: ({_selectedEmployee.EmployeeName})؟\nسيتم حذف سجله ومجلده نهائياً من النظام.",
            yesText: "نعم، حذف نهائي",
            cancelText: "إلغاء");

        if (confirm != true) return;

        try
        {
            // 3. حذف المجلد الفيزيائي الفارغ من القرص
            var settings = await DbContext.SystemSettings.AsNoTracking().FirstOrDefaultAsync();
            if (settings != null && !string.IsNullOrWhiteSpace(settings.BaseFolderPath) && !string.IsNullOrWhiteSpace(_selectedEmployee.EmployeeFolderPath))
            {
                string employeeFolderFullPath = Path.Combine(settings.BaseFolderPath, _selectedEmployee.EmployeeFolderPath);

                if (Directory.Exists(employeeFolderFullPath))
                {
                    Directory.Delete(employeeFolderFullPath, true);
                }
            }

            // 4. حذف السجل من قاعدة البيانات
            var empDb = await DbContext.Employees.FirstOrDefaultAsync(e => e.EmployeeId == _selectedEmployee.EmployeeId);
            if (empDb != null)
            {
                DbContext.Employees.Remove(empDb);
                await DbContext.SaveChangesAsync();
            }

            // 5. تحديث القائمة في الواجهة
            _employees.Remove(_selectedEmployee);
            _selectedEmployee = _employees.FirstOrDefault();

            if (_selectedEmployee != null)
            {
                await SelectEmployee(_selectedEmployee);
            }
            else
            {
                _documents.Clear();
            }

            Snackbar.Add("تم حذف الموظف ومجلده بنجاح", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"حدث خطأ أثناء عملية الحذف: {ex.Message}", Severity.Error);
        }
    }

    private void OpenAddDocumentDialog()
    {
        Snackbar.Add($"إضافة مستند جديد للموظف: {_selectedEmployee?.EmployeeName}", Severity.Info);
    }

    private void ViewDocument(Document doc)
    {
        Snackbar.Add($"معاينة الملف: {doc.OriginalFileName}", Severity.Normal);
    }

    private async Task DeleteDocument(Document doc)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "تأكيد حذف المستند",
            $"هل أنت متأكد من حذف الكتاب رقم: {doc.DocumentNumber}؟",
            yesText: "نعم، حذف", cancelText: "إلغاء");

        if (confirm == true)
        {
            doc.IsDeleted = 1;
            await DbContext.SaveChangesAsync();
            _documents.Remove(doc);
            Snackbar.Add("تم نقل المستند إلى المحذوفات", Severity.Success);
        }
    }
}
    private async Task LoadCategories()
    {
        _mainCategories = await DbContext.MainCategories.AsNoTracking().ToListAsync();
        _primaryCategories = await DbContext.PrimaryCategories.AsNoTracking().ToListAsync();
        _secondaryCategories = await DbContext.SecondaryCategories.AsNoTracking().ToListAsync();
        _tertiaryCategories = await DbContext.TertiaryCategories.AsNoTracking().ToListAsync();
    }

    private IEnumerable<PrimaryCategory> AvailablePrimaryCategories =>
        _selectedMainCatId.HasValue
            ? _primaryCategories.Where(p => p.MainCategoryId == _selectedMainCatId.Value)
            : Enumerable.Empty<PrimaryCategory>();

    private IEnumerable<SecondaryCategory> AvailableSecondaryCategories
    {
        get
        {
            if (!_selectedPrimaryCatId.HasValue) return Enumerable.Empty<SecondaryCategory>();

            var primCat = _primaryCategories.FirstOrDefault(p => p.PrimaryCategoryId == _selectedPrimaryCatId.Value);
            string primName = primCat?.Name?.Trim() ?? string.Empty;
            var dbList = _secondaryCategories.Where(s => s.PrimaryCategoryId == _selectedPrimaryCatId.Value).ToList();

            string? matchedKey = _primaryToSecondaryMap.Keys.FirstOrDefault(k => primName.Contains(k));
            if (matchedKey != null)
            {
                var allowedSecNames = _primaryToSecondaryMap[matchedKey];
                if (dbList.Any())
                {
                    var filtered = dbList
                        .Where(s => allowedSecNames.Any(a => s.Name.Trim().Contains(a)))
                        .OrderBy(s => Array.IndexOf(allowedSecNames, allowedSecNames.FirstOrDefault(a => s.Name.Trim().Contains(a))))
                        .ToList();

                    if (filtered.Any()) return filtered;
                }

                int vId = -200;
                return allowedSecNames.Select(name => new SecondaryCategory
                {
                    SecondaryCategoryId = vId--,
                    PrimaryCategoryId = _selectedPrimaryCatId.Value,
                    Name = name
                }).ToList();
            }

            return dbList;
        }
    }

    private IEnumerable<TertiaryCategory> AvailableTertiaryCategories
    {
        get
        {
            if (!_selectedSecondaryCatId.HasValue)
                return Enumerable.Empty<TertiaryCategory>();

            var secCat = AvailableSecondaryCategories.FirstOrDefault(s => s.SecondaryCategoryId == _selectedSecondaryCatId.Value)
                         ?? _secondaryCategories.FirstOrDefault(s => s.SecondaryCategoryId == _selectedSecondaryCatId.Value);

            string secName = secCat?.Name?.Trim() ?? string.Empty;

            if (secName.Contains("انفكاك"))
                return BuildTertiaryList(_selectedSecondaryCatId.Value, _tertiaryForEnfakak);

            if (secName.Contains("احتساب") || secName.Contains("إضافة") || secName.Contains("اضافة"))
                return BuildTertiaryList(_selectedSecondaryCatId.Value, _tertiaryForEhtisab);

            if (secName.Contains("تكليف") || secName.Contains("إعفاء") || secName.Contains("اعفاء"))
                return BuildTertiaryList(_selectedSecondaryCatId.Value, _tertiaryForTakleef);

            if (secName.Contains("ترشيح"))
                return BuildTertiaryList(_selectedSecondaryCatId.Value, _tertiaryForTarsheeh);

            if (secName.Contains("لجنة"))
                return BuildTertiaryList(_selectedSecondaryCatId.Value, _iraqiCommittees.ToArray());

            return Enumerable.Empty<TertiaryCategory>();
        }
    }

    private List<TertiaryCategory> BuildTertiaryList(int secId, string[] definedNames)
    {
        var result = new List<TertiaryCategory>();
        var fromDb = _tertiaryCategories.Where(t => t.SecondaryCategoryId == secId).ToList();

        int virtualId = -100;
        foreach (var name in definedNames)
        {
            var matched = fromDb.FirstOrDefault(d => d.Name.Trim().Equals(name, StringComparison.OrdinalIgnoreCase));
            if (matched != null)
            {
                result.Add(matched);
            }
            else
            {
                result.Add(new TertiaryCategory
                {
                    TertiaryCategoryId = virtualId--,
                    SecondaryCategoryId = secId,
                    Name = name
                });
            }
        }
        return result;
    }


                    <!-- جدول الشعب -->
                    <MudText Typo="Typo.subtitle1" Class="fw-bold mt-2 mb-1" Style="color: #1B4D3E;">قائمة الشُعب الرئيسية</MudText>
                    <MudTable Items="@_departmentsList" Dense="true" Hover="true" Striped="true" Elevation="1" Class="mb-4">

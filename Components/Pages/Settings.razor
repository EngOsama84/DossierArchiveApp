                    </MudTable>

                    <!-- جدول الوحدات -->
                    <MudText Typo="Typo.subtitle1" Class="fw-bold mt-4 mb-1" Style="color: #1B4D3E;">قائمة الوحدات (التابعة والمستقلة)</MudText>
                    <MudTable Items="@_subUnitsList" Dense="true" Hover="true" Striped="true" Elevation="1">
                        <HeaderContent>
                            <MudTh Style="width: 50px;">ت</MudTh>
                            <MudTh>اسم الوحدة</MudTh>
                            <MudTh>الارتباط التنظيمي / الشعبة التابعة</MudTh>
                            <MudTh>الحالة</MudTh>
                            <MudTh Style="text-align: center; width: 140px;">الإجراءات</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.SubUnitId</MudTd>
                            <MudTd Class="fw-bold">@context.Name</MudTd>
                            <MudTd>
                                @if (context.Department != null)
                                {
                                    <span style="color: #1B4D3E; font-weight: 500;">@context.Department.Name</span>

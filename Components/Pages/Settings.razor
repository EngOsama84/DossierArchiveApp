                </MudTabPanel>
            }

        </MudTabs>
    }
</div>

@code {
    private const string DefaultLogoPath = "images/default_logo.png";
    private SystemSetting _settings = new();
    private bool _loading = true;
    private bool _isSaving = false;
    private bool _isBackingUp = false;
    private bool _isDuplex = false;
    private bool _autoBackup = false;
    private bool _auditLog = true;
    private string _backupScope = "dbOnly";
    private List<ScannerInfo> _availableScanners = new();
    private List<FileInfo> _backupFiles = new();

    private List<Department> _departmentsList = new();
    private List<SubUnit> _subUnitsList = new();

    protected override async Task OnInitializedAsync()
    {
        if (SessionService.CurrentUser == null || !SessionService.CanAccessSettingsOrUsers)
        {
            Snackbar.Add("عذراً، لا تمتلك الصلاحية للوصول إلى إعدادات النظام!", Severity.Error);
            Navigation.NavigateTo("/employees");
            return;
        }

        await LoadSettings();
        if (SessionService.IsSuperAdmin)
        {
            await LoadDepartmentsAndUnitsAsync();
        }
    }

    private async Task LoadSettings()
    {
        _loading = true;
        try
        {
            var s = await DbContext.SystemSettings.FirstOrDefaultAsync();
            if (s == null)
            {
                s = new SystemSetting
                {
                    DirectorateName = "ديوان الوقف الشيعي",
                    DepartmentName = "شعبة تكنولوجيا المعلومات",
                    BaseFolderPath = @"D:\الاضبارة الالكترونية للموظفين",
                    LogoPath = DefaultLogoPath
                };
                DbContext.SystemSettings.Add(s);
                await DbContext.SaveChangesAsync();
            }

            _settings = s;
            _isDuplex = _settings.DuplexScan == 1;
            _autoBackup = _settings.AutoBackupEnabled == 1;
            _auditLog = _settings.KeepAuditLog == 1;

            RefreshConnectedScanners();
            if (SessionService.IsSuperAdmin)
            {
                LoadBackupFiles();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ أثناء جلب الإعدادات: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadDepartmentsAndUnitsAsync()
    {
        try
        {
            _departmentsList = await DbContext.Departments
                .Include(d => d.SubUnits)
                .OrderBy(d => d.DepartmentId)
                .ToListAsync();

            _subUnitsList = await DbContext.SubUnits
                .Include(s => s.Department)
                .OrderBy(s => s.DepartmentId.HasValue ? s.DepartmentId : 999)
                .ThenBy(s => s.SubUnitId)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"تعذر جلب الشُعب والوحدات: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenAddDepartmentDialog()
    {
        if (!SessionService.IsSuperAdmin) return;

        var parameters = new DialogParameters { ["Department"] = new Department() };
        var dialog = await DialogService.ShowAsync<DepartmentDialog>("إضافة شعبة", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is Department newDept)
        {
            DbContext.Departments.Add(newDept);
            await DbContext.SaveChangesAsync();
            await LoadDepartmentsAndUnitsAsync();
            Snackbar.Add("تمت إضافة الشعبة بنجاح", Severity.Success);
        }
    }

    private async Task OpenEditDepartmentDialog(Department dept)
    {
        if (!SessionService.IsSuperAdmin) return;

        var deptClone = new Department { DepartmentId = dept.DepartmentId, Name = dept.Name, IsActive = dept.IsActive };
        var parameters = new DialogParameters { ["Department"] = deptClone };
        var dialog = await DialogService.ShowAsync<DepartmentDialog>("تعديل شعبة", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is Department updatedDept)
        {
            var existing = await DbContext.Departments.FindAsync(dept.DepartmentId);
            if (existing != null)
            {
                existing.Name = updatedDept.Name;
                existing.IsActive = updatedDept.IsActive;
                await DbContext.SaveChangesAsync();
                await LoadDepartmentsAndUnitsAsync();
                Snackbar.Add("تم تحديث بيانات الشعبة بنجاح", Severity.Success);
            }
        }
    }

    private async Task DeleteDepartment(Department dept)
    {
        if (!SessionService.IsSuperAdmin) return;

        bool? confirm = await DialogService.ShowMessageBox(
            "تأكيد الحذف",
            $"هل أنت متأكد من حذف ({dept.Name})؟\nسيؤدي ذلك لفك ارتباط الوحدات التابعة لها.",
            yesText: "نعم، حذف",
            cancelText: "إلغاء");

        if (confirm == true)
        {
            var dbDept = await DbContext.Departments.Include(d => d.SubUnits).FirstOrDefaultAsync(d => d.DepartmentId == dept.DepartmentId);
            if (dbDept != null)
            {
                foreach (var sub in dbDept.SubUnits)
                {
                    sub.DepartmentId = null;
                }
                DbContext.Departments.Remove(dbDept);
                await DbContext.SaveChangesAsync();
                await LoadDepartmentsAndUnitsAsync();
                Snackbar.Add("تم حذف الشعبة بنجاح", Severity.Success);
            }
        }
    }

    private async Task OpenAddSubUnitDialog()
    {
        if (!SessionService.IsSuperAdmin) return;

        var parameters = new DialogParameters
        {
            ["SubUnit"] = new SubUnit(),
            ["Departments"] = _departmentsList
        };
        var dialog = await DialogService.ShowAsync<SubUnitDialog>("إضافة وحدة", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is SubUnit newSub)
        {
            DbContext.SubUnits.Add(newSub);
            await DbContext.SaveChangesAsync();
            await LoadDepartmentsAndUnitsAsync();
            Snackbar.Add("تمت إضافة الوحدة بنجاح", Severity.Success);
        }
    }

    private async Task OpenEditSubUnitDialog(SubUnit sub)
    {
        if (!SessionService.IsSuperAdmin) return;

        var subClone = new SubUnit
        {
            SubUnitId = sub.SubUnitId,
            Name = sub.Name,
            DepartmentId = sub.DepartmentId,
            IsActive = sub.IsActive
        };
        var parameters = new DialogParameters
        {
            ["SubUnit"] = subClone,
            ["Departments"] = _departmentsList
        };
        var dialog = await DialogService.ShowAsync<SubUnitDialog>("تعديل وحدة", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is SubUnit updatedSub)
        {
            var existing = await DbContext.SubUnits.FindAsync(sub.SubUnitId);
            if (existing != null)
            {
                existing.Name = updatedSub.Name;
                existing.DepartmentId = updatedSub.DepartmentId;
                existing.IsActive = updatedSub.IsActive;
                await DbContext.SaveChangesAsync();
                await LoadDepartmentsAndUnitsAsync();
                Snackbar.Add("تم تحديث بيانات الوحدة بنجاح", Severity.Success);
            }
        }
    }

    private async Task DeleteSubUnit(SubUnit sub)
    {
        if (!SessionService.IsSuperAdmin) return;

        bool? confirm = await DialogService.ShowMessageBox(
            "تأكيد الحذف",
            $"هل أنت متأكد من حذف الوحدة ({sub.Name}) نهائياً؟",
            yesText: "نعم، حذف",
            cancelText: "إلغاء");

        if (confirm == true)
        {
            var dbSub = await DbContext.SubUnits.FindAsync(sub.SubUnitId);
            if (dbSub != null)
            {
                DbContext.SubUnits.Remove(dbSub);
                await DbContext.SaveChangesAsync();
                await LoadDepartmentsAndUnitsAsync();
                Snackbar.Add("تم حذف الوحدة بنجاح", Severity.Success);
            }
        }
    }

    private string GetEffectiveLogoUrl()
    {
        if (string.IsNullOrWhiteSpace(_settings.LogoPath))
            return DefaultLogoPath;

        return _settings.LogoPath;
    }

    private bool IsCustomLogoActive()
    {
        if (string.IsNullOrWhiteSpace(_settings.LogoPath))
            return false;

        return !_settings.LogoPath.TrimStart('/').Equals(DefaultLogoPath.TrimStart('/'), StringComparison.OrdinalIgnoreCase);
    }

    private async Task ResetToDefaultLogo()
    {
        if (!SessionService.IsSuperAdmin) return;

        _settings.LogoPath = DefaultLogoPath;
        try
        {
            DbContext.SystemSettings.Update(_settings);
            await DbContext.SaveChangesAsync();
            Snackbar.Add("تمت استعادة الشعار الافتراضي بنجاح!", Severity.Success);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"حدث خطأ أثناء استعادة الشعار: {ex.Message}", Severity.Error);
        }
    }

    private async Task UploadLogo(IBrowserFile file)
    {
        if (!SessionService.IsSuperAdmin || file == null) return;

        try
        {
            using var stream = file.OpenReadStream(5 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            string base64 = Convert.ToBase64String(ms.ToArray());
            _settings.LogoPath = $"data:{file.ContentType};base64,{base64}";

            DbContext.SystemSettings.Update(_settings);
            await DbContext.SaveChangesAsync();

            Snackbar.Add("تم تحديث الشعار وتثبيته في النظام بنجاح!", Severity.Success);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ أثناء رفع ملف الشعار: {ex.Message}", Severity.Error);
        }
    }

    private void BrowseBaseFolder()
    {
        if (!SessionService.IsSuperAdmin) return;

        string? selected = OpenWindowsFolderPicker("اختر المجلد الأساسي لتخزين ملفات الأضابير");
        if (!string.IsNullOrWhiteSpace(selected))
        {
            _settings.BaseFolderPath = selected;
            StateHasChanged();
        }
    }

    private void BrowseBackupFolder()
    {
        if (!SessionService.IsSuperAdmin) return;

        string? selected = OpenWindowsFolderPicker("اختر مجلد حفظ النسخ الاحتياطية");
        if (!string.IsNullOrWhiteSpace(selected))
        {
            _settings.BackupFolderPath = selected;
            LoadBackupFiles();
            StateHasChanged();
        }
    }

    private string? OpenWindowsFolderPicker(string title)
    {
        try
        {
            var script = $@"[System.Reflection.Assembly]::LoadWithPartialName('System.Windows.Forms') | Out-Null; $f = New-Object System.Windows.Forms.FolderBrowserDialog; $f.Description = '{title}'; $f.ShowNewFolderButton = $true; if($f.ShowDialog() -eq 'OK'){{ Write-Output $f.SelectedPath }}";

            var psi = new System.Diagnostics.ProcessStartInfo
            {
                FileName = "powershell.exe",
                Arguments = $"-NoProfile -Command \"{script}\"",
                RedirectStandardOutput = true,
                UseShellExecute = false,
                CreateNoWindow = true
            };

            using var process = System.Diagnostics.Process.Start(psi);
            if (process != null)
            {
                string output = process.StandardOutput.ReadToEnd().Trim();
                process.WaitForExit();
                return string.IsNullOrWhiteSpace(output) ? null : output;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"تعذر فتح نافذة استعراض المجلد: {ex.Message}", Severity.Warning);
        }
        return null;
    }

    private void RefreshConnectedScanners()
    {
        try
        {
            _availableScanners = ScannerService.GetConnectedScanners();
            if (_availableScanners.Any() && string.IsNullOrEmpty(_settings.DefaultScannerName))
            {
                _settings.DefaultScannerName = _availableScanners.First().Name;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"تعذر قراءة أجهزة السكنر: {ex.Message}", Severity.Error);
        }
    }

    private void LoadBackupFiles()
    {
        if (!SessionService.IsSuperAdmin) return;

        _backupFiles.Clear();
        try
        {
            string backupFolder = _settings.BackupFolderPath?.Trim().Trim('"', '\'') ?? string.Empty;
            if (!string.IsNullOrWhiteSpace(backupFolder) && Directory.Exists(backupFolder))
            {
                var dir = new DirectoryInfo(backupFolder);
                _backupFiles = dir.GetFiles("*.*")
                                  .Where(f => f.Extension.Equals(".sqlite3", StringComparison.OrdinalIgnoreCase)
                                           || f.Extension.Equals(".zip", StringComparison.OrdinalIgnoreCase))
                                  .OrderByDescending(f => f.CreationTime)
                                  .ToList();
            }
        }
        catch { }
    }

    private void CheckBaseFolder()
    {
        if (string.IsNullOrWhiteSpace(_settings.BaseFolderPath))
        {
            Snackbar.Add("مسار المجلد الأساسي غير محدد!", Severity.Warning);
            return;
        }

        try
        {
            if (!Directory.Exists(_settings.BaseFolderPath))
            {
                if (SessionService.IsSuperAdmin)
                {
                    Directory.CreateDirectory(_settings.BaseFolderPath);
                    Snackbar.Add("تم إنشاء المجلد في المسار المحدد وهو جاهز للاستخدام!", Severity.Success);
                }
                else
                {
                    Snackbar.Add("المجلد الأساسي غير موجود على القرص، يرجى إبلاغ الإدارة العامة.", Severity.Error);
                }
            }
            else
            {
                Snackbar.Add("المجلد موجود ومتاح وجاهز للاستخدام.", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"تعذر الوصول للمسار: {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveSettings()
    {
        _isSaving = true;
        try
        {
            // صمام أمان سيرفر: منع مدير الشعبة من تغيير إعدادات السيادة في الكائن
            if (!SessionService.IsSuperAdmin)
            {
                var originalDbSettings = await DbContext.SystemSettings.AsNoTracking().FirstOrDefaultAsync();
                if (originalDbSettings != null)
                {
                    _settings.DirectorateName = originalDbSettings.DirectorateName;
                    _settings.DepartmentName = originalDbSettings.DepartmentName;
                    _settings.BaseFolderPath = originalDbSettings.BaseFolderPath;
                    _settings.BackupFolderPath = originalDbSettings.BackupFolderPath;
                    _settings.LogoPath = originalDbSettings.LogoPath;
                    _settings.FontFamily = originalDbSettings.FontFamily;
                    _settings.MaxFileSize = originalDbSettings.MaxFileSize;
                    _settings.DefaultLanguage = originalDbSettings.DefaultLanguage;
                }
            }

            _settings.DuplexScan = _isDuplex ? 1 : 0;
            _settings.AutoBackupEnabled = _autoBackup ? 1 : 0;
            _settings.KeepAuditLog = _auditLog ? 1 : 0;

            DbContext.SystemSettings.Update(_settings);
            await DbContext.SaveChangesAsync();

            await SessionService.LogActivityAsync(
                actionType: "تعديل إعدادات",
                entityType: "إعدادات النظام",
                entityId: _settings.SettingId,
                description: $"قام المستخدم ({SessionService.CurrentUser?.UserName}) بتحديث إعدادات النظام المتاحة له."
            );

            Snackbar.Add("تم حفظ التعديلات بنجاح!", Severity.Success);
            if (SessionService.IsSuperAdmin)
            {
                LoadBackupFiles();
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"حدث خطأ أثناء حفظ الإعدادات: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task TriggerManualBackup()
    {
        if (!SessionService.IsSuperAdmin)
        {
            Snackbar.Add("النسخ الاحتياطي متاح فقط لمدير النظام العام!", Severity.Error);
            return;
        }

        string backupFolder = _settings.BackupFolderPath?.Trim().Trim('"', '\'') ?? string.Empty;

        if (string.IsNullOrWhiteSpace(backupFolder))
        {
            Snackbar.Add("يرجى اختيار مجلد النسخ الاحتياطي وحفظ الإعدادات أولاً!", Severity.Warning);
            return;
        }

        // صمام أمان: منع اختيار مجلد تشغيل البرنامج نفسه لتفادي أخطاء القفل والتكرار الدائري
        string appBaseDir = AppContext.BaseDirectory.TrimEnd('\\', '/');
        string currentWorkingDir = Directory.GetCurrentDirectory().TrimEnd('\\', '/');
        string normalizedBackupFolder = Path.GetFullPath(backupFolder).TrimEnd('\\', '/');

        if (normalizedBackupFolder.Equals(appBaseDir, StringComparison.OrdinalIgnoreCase) ||
            normalizedBackupFolder.StartsWith(appBaseDir + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase) ||
            normalizedBackupFolder.Equals(currentWorkingDir, StringComparison.OrdinalIgnoreCase) ||
            normalizedBackupFolder.StartsWith(currentWorkingDir + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add("تحذير أمني: لا يمكن تحديد مجلد البرنامج كمسار للنسخ الاحتياطي! يرجى اختيار مجلد في مسار مستقل (مثل قرص D أو E).", Severity.Error);
            return;
        }

        _isBackingUp = true;
        try
        {
            if (!Directory.Exists(normalizedBackupFolder))
            {
                Directory.CreateDirectory(normalizedBackupFolder);
            }

            string sourceDb = Path.Combine(AppContext.BaseDirectory, "dossiers.sqlite3");
            if (!File.Exists(sourceDb))
            {
                sourceDb = Path.Combine(Directory.GetCurrentDirectory(), "dossiers.sqlite3");
            }

            if (!File.Exists(sourceDb))
            {
                Snackbar.Add("لم يتم العثور على ملف قاعدة البيانات dossiers.sqlite3!", Severity.Error);
                return;
            }

            string timestamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");

            if (_backupScope == "dbOnly")
            {
                string backupFileName = $"DossierDB_{timestamp}.sqlite3";
                string destPath = Path.Combine(normalizedBackupFolder, backupFileName);

                // استخدام FileShare.ReadWrite لتجاوز قفل محرك SQLite أثناء تشغيل التطبيق
                await using (var sourceStream = new FileStream(sourceDb, FileMode.Open, FileAccess.Read, FileShare.ReadWrite))
                await using (var destStream = new FileStream(destPath, FileMode.Create, FileAccess.Write, FileShare.None))
                {
                    await sourceStream.CopyToAsync(destStream);
                }

                await SessionService.LogActivityAsync(
                    actionType: "نسخ احتياطي (قاعدة فقط)",
                    entityType: "قاعدة البيانات",
                    entityId: null,
                    description: $"تم إنشاء نسخة احتياطية لقاعدة البيانات باسم: {backupFileName}"
                );

                Snackbar.Add($"تم إنشاء نسخة قاعدة البيانات بنجاح: {backupFileName}", Severity.Success);
            }
            else
            {
                string zipFileName = $"DossierFullBackup_{timestamp}.zip";
                string zipFullPath = Path.Combine(normalizedBackupFolder, zipFileName);

                await Task.Run(async () =>
                {
                    using (var archive = ZipFile.Open(zipFullPath, ZipArchiveMode.Create))
                    {
                        // 1. إضافة ملف قاعدة البيانات باستخدام تدفق آمن يدعم المشاركة
                        var dbEntry = archive.CreateEntry("dossiers.sqlite3", CompressionLevel.Optimal);
                        await using (var entryStream = dbEntry.Open())
                        await using (var dbFileStream = new FileStream(sourceDb, FileMode.Open, FileAccess.Read, FileShare.ReadWrite))
                        {
                            await dbFileStream.CopyToAsync(entryStream);
                        }

                        // 2. فحص وضغط مجلد الملفات والوثائق المؤرشفة
                        string baseFolder = _settings.BaseFolderPath?.Trim().Trim('"', '\'') ?? string.Empty;
                        if (!string.IsNullOrWhiteSpace(baseFolder) && Directory.Exists(baseFolder))
                        {
                            // استثناء ملفات الـ Zip والملفات المؤقتة لـ SQLite
                            var validFiles = Directory.GetFiles(baseFolder, "*.*", SearchOption.AllDirectories)
                                .Where(f =>
                                {
                                    string ext = Path.GetExtension(f).ToLowerInvariant();
                                    return ext != ".zip" && ext != ".sqlite3-wal" && ext != ".sqlite3-shm" && ext != ".tmp";
                                });

                            foreach (var filePath in validFiles)
                            {
                                try
                                {
                                    string relativePath = Path.GetRelativePath(baseFolder, filePath);
                                    string entryName = Path.Combine("Files", relativePath).Replace('\\', '/');

                                    var fileEntry = archive.CreateEntry(entryName, CompressionLevel.Optimal);
                                    await using var fileEntryStream = fileEntry.Open();
                                    await using var diskFileStream = new FileStream(filePath, FileMode.Open, FileAccess.Read, FileShare.ReadWrite);
                                    await diskFileStream.CopyToAsync(fileEntryStream);
                                }
                                catch
                                {
                                    // تخطي أي ملف معطوب أو محجوز كلياً دون إيقاف العملية
                                    continue;
                                }
                            }
                        }
                    }
                });

                await SessionService.LogActivityAsync(
                    actionType: "نسخ احتياطي شامل",
                    entityType: "النظام والملفات",
                    entityId: null,
                    description: $"تم إنشاء نسخة احتياطية شاملة باسم: {zipFileName}"
                );

                Snackbar.Add($"تم إنشاء النسخة الشاملة بنجاح: {zipFileName}", Severity.Success);
            }

            LoadBackupFiles();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"فشل النسخ الاحتياطي: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isBackingUp = false;
        }
    }

    private async Task RestoreFromLocalFile(string filePath, string fileName)
    {
        if (!SessionService.IsSuperAdmin)
        {
            Snackbar.Add("الاستعادة متاحة حصراً للمدير العام!", Severity.Error);
            return;
        }

        bool isZip = fileName.EndsWith(".zip", StringComparison.OrdinalIgnoreCase);

        bool? confirm = await DialogService.ShowMessageBox(
            "تأكيد استعادة النسخة الاحتياطية",
            $"تحذير أمني:\nأنت على وشك استعادة النسخة ({fileName}).\n" +
            (isZip ? "سيتم استبدال قاعدة البيانات واستخراج واستبدال مجلدات الوثائق بالكامل." : "سيتم استبدال قاعدة البيانات الحالية فقط.") +
            "\n\nهل ترغب بالمتابعة؟",
            yesText: "نعم، استعد الآن",
            cancelText: "إلغاء الأمر");

        if (confirm != true) return;

        await PerformRestoreAsync(filePath, isZip);
    }

    private async Task RestoreFromUploadedFile(IBrowserFile file)
    {
        if (!SessionService.IsSuperAdmin || file == null) return;

        bool isZip = file.Name.EndsWith(".zip", StringComparison.OrdinalIgnoreCase);

        bool? confirm = await DialogService.ShowMessageBox(
            "تأكيد استعادة من ملف مخصص",
            $"تحذير أمني:\nأنت على وشك استعادة ({file.Name}).\n" +
            (isZip ? "سيتم فك ضغط واستعادة قاعدة البيانات والملفات بالكامل." : "سيتم استبدال قاعدة البيانات الحالية.") +
            "\n\nهل أنت متأكد من سلامة الملف وترغب بالمتابعة؟",
            yesText: "نعم، استعد هذا الملف",
            cancelText: "إلغاء");

        if (confirm != true) return;

        string tempPath = Path.Combine(Path.GetTempPath(), $"restore_{Guid.NewGuid():N}_{(isZip ? "archive.zip" : "db.sqlite3")}");
        try
        {
            await using (var stream = file.OpenReadStream(500 * 1024 * 1024))
            await using (var fileStream = new FileStream(tempPath, FileMode.Create))
            {
                await stream.CopyToAsync(fileStream);
            }

            await PerformRestoreAsync(tempPath, isZip);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"فشل قراءة الملف: {ex.Message}", Severity.Error);
        }
        finally
        {
            if (File.Exists(tempPath))
            {
                try { File.Delete(tempPath); } catch { }
            }
        }
    }

    private async Task PerformRestoreAsync(string sourceBackupFile, bool isZip)
    {
        if (!SessionService.IsSuperAdmin) return;

        string currentDbPath = Path.Combine(AppContext.BaseDirectory, "dossiers.sqlite3");
        if (!File.Exists(currentDbPath))
        {
            currentDbPath = Path.Combine(Directory.GetCurrentDirectory(), "dossiers.sqlite3");
        }

        string emergencySafetyBackup = Path.Combine(Directory.GetCurrentDirectory(), $"SafetyRollback_{DateTime.Now:yyyyMMdd_HHmmss}.sqlite3");

        try
        {
            Microsoft.Data.Sqlite.SqliteConnection.ClearAllPools();

            if (File.Exists(currentDbPath))
            {
                File.Copy(currentDbPath, emergencySafetyBackup, true);
            }

            if (!isZip)
            {
                File.Copy(sourceBackupFile, currentDbPath, true);
            }
            else
            {
                using (var archive = ZipFile.OpenRead(sourceBackupFile))
                {
                    var dbEntry = archive.GetEntry("dossiers.sqlite3");
                    if (dbEntry != null)
                    {
                        dbEntry.ExtractToFile(currentDbPath, overwrite: true);
                    }

                    string baseFolder = _settings.BaseFolderPath?.Trim().Trim('"', '\'') ?? string.Empty;
                    if (!string.IsNullOrWhiteSpace(baseFolder))
                    {
                        if (!Directory.Exists(baseFolder)) Directory.CreateDirectory(baseFolder);

                        foreach (var entry in archive.Entries)
                        {
                            if (entry.FullName.StartsWith("Files/", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrEmpty(entry.Name))
                            {
                                string relativePath = entry.FullName.Substring("Files/".Length);
                                string targetFilePath = Path.Combine(baseFolder, relativePath);
                                string? parentDir = Path.GetDirectoryName(targetFilePath);

                                if (!string.IsNullOrEmpty(parentDir) && !Directory.Exists(parentDir))
                                {
                                    Directory.CreateDirectory(parentDir);
                                }

                                entry.ExtractToFile(targetFilePath, overwrite: true);
                            }
                        }
                    }
                }
            }

            Snackbar.Add("تمت عملية الاستعادة بنجاح! يتم الآن إعادة تحميل النظام...", Severity.Success);
            await Task.Delay(1500);
            Navigation.NavigateTo("/settings", forceLoad: true);
        }
        catch (Exception ex)
        {
            if (File.Exists(emergencySafetyBackup))
            {
                try { File.Copy(emergencySafetyBackup, currentDbPath, true); } catch { }
            }
            Snackbar.Add($"فشلت عملية الاستعادة وتم الحفاظ على البيانات: {ex.Message}", Severity.Error);
        }
    }
}
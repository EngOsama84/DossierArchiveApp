                        <RowTemplate>
                            <MudTd>@context.DepartmentId</MudTd>
                            <MudTd Class="fw-bold">@context.Name</MudTd>
                            <MudTd>
                                <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined">

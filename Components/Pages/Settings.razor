                                else
                                {
                                    <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Variant="Variant.Filled">مستقلة / مرتبطة بالمديرية مباشرة</MudChip>
                                }
                            </MudTd>
                            <MudTd>
                                @if (context.IsActive == 1)
                                {
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">نشطة</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">معطلة</MudChip>
                                }

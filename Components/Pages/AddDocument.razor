@code {
    [Parameter]
    public int? InitialEmployeeId { get; set; }

    private List<Employee> _employees = new();
    private HashSet<int> _selectedEmployeeIds = new();
    private bool _loadingEmployees = true;
    private string _employeeSearch = string.Empty;

    private List<MainCategory> _mainCategories = new();
    private List<PrimaryCategory> _allPrimaryCategories = new();
    private List<PrimaryCategory> _availablePrimaryCategories = new();
    private List<SecondaryCategory> _allSecondaryCategories = new();
    private List<SecondaryCategory> _availableSecondaryCategories = new();
    private List<TertiaryCategory> _allTertiaryCategories = new();
    private List<TertiaryCategory> _availableTertiaryCategories = new();

    private int? _selectedMainCatId;
    private int? _selectedPrimaryCatId;
    private int? _selectedSecondaryCatId;
    private int? _selectedTertiaryCatId;
    private bool _isTertiaryEnabled = false;

    private string _subject = string.Empty;
    private string _documentNumber = string.Empty;
    private DateTime? _documentDate = DateTime.Today;

    private IBrowserFile? _selectedFile;
    private string _previewFileUrl = string.Empty;
    private byte[]? _documentBytes;
    private string _finalExtension = ".pdf";

    private SystemSetting? _settings;
    private bool _isScanning = false;
    private bool _isSaving = false;

    private IEnumerable<Employee> FilteredEmployees =>
        string.IsNullOrWhiteSpace(_employeeSearch)
            ? _employees
            : _employees.Where(e => e.EmployeeName.Contains(_employeeSearch, StringComparison.OrdinalIgnoreCase)
                                 || e.FileNumber.Contains(_employeeSearch, StringComparison.OrdinalIgnoreCase));

    private bool CanSave => _selectedEmployeeIds.Any()
                            && !string.IsNullOrWhiteSpace(_subject)
                            && !string.IsNullOrWhiteSpace(_documentNumber)
                            && (_documentBytes != null || _selectedFile != null);

    protected override async Task OnInitializedAsync()
    {
        if (SessionService.CurrentUser == null || !SessionService.CanAdd)
        {
            Snackbar.Add("عذراً، حسابك لا يمتلك صلاحية إضافة أو أرشفة مستندات!", Severity.Error);
            Navigation.NavigateTo("/employees");
            return;
        }

        await LoadSettings();
        await LoadCategories();
        await LoadEmployees();

        if (InitialEmployeeId.HasValue)
        {
            _selectedEmployeeIds.Add(InitialEmployeeId.Value);
        }
    }

    private async Task LoadSettings()
    {
        _settings = await DbContext.SystemSettings.AsNoTracking().FirstOrDefaultAsync();
    }

    private async Task LoadCategories()
    {
        _mainCategories = await DbContext.MainCategories.AsNoTracking().ToListAsync();
        _allPrimaryCategories = await DbContext.PrimaryCategories.AsNoTracking().ToListAsync();
        _allSecondaryCategories = await DbContext.SecondaryCategories.AsNoTracking().ToListAsync();
        _allTertiaryCategories = await DbContext.TertiaryCategories.AsNoTracking().ToListAsync();
    }

    private async Task LoadEmployees()
    {
        _loadingEmployees = true;
        try
        {
            _employees = await DbContext.Employees
                .Where(e => e.IsActive == 1)
                .OrderBy(e => e.FileNumber)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"تعذر جلب الموظفين: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingEmployees = false;
        }
    }

    private void ToggleEmployeeSelection(int empId)
    {
        if (_selectedEmployeeIds.Contains(empId))
            _selectedEmployeeIds.Remove(empId);
        else
            _selectedEmployeeIds.Add(empId);
    }

    private void OnMainCategoryChanged(int? mainId)
    {
        _selectedMainCatId = mainId;
        _selectedPrimaryCatId = null;
        _selectedSecondaryCatId = null;
        _selectedTertiaryCatId = null;
        _isTertiaryEnabled = false;

        if (mainId.HasValue)
        {
            _availablePrimaryCategories = _allPrimaryCategories
                .Where(p => p.MainCategoryId == mainId.Value)
                .ToList();
        }
        else
        {
            _availablePrimaryCategories.Clear();
        }
        _availableSecondaryCategories.Clear();
        _availableTertiaryCategories.Clear();
    }

    private void OnPrimaryCategoryChanged(int? primId)
    {
        _selectedPrimaryCatId = primId;
        _selectedSecondaryCatId = null;
        _selectedTertiaryCatId = null;
        _isTertiaryEnabled = false;

        if (primId.HasValue)
        {
            _availableSecondaryCategories = _allSecondaryCategories
                .Where(s => s.PrimaryCategoryId == primId.Value)
                .ToList();
        }
        else
        {
            _availableSecondaryCategories.Clear();
        }
        _availableTertiaryCategories.Clear();
    }

    private void OnSecondaryCategoryChanged(int? secId)
    {
        _selectedSecondaryCatId = secId;
        _selectedTertiaryCatId = null;
        _availableTertiaryCategories.Clear();
        _isTertiaryEnabled = false;

        if (secId.HasValue)
        {
            var secCat = _allSecondaryCategories.FirstOrDefault(s => s.SecondaryCategoryId == secId.Value);
            string secName = secCat?.Name?.Trim() ?? string.Empty;

            string[] conditionalBranches = { "انفكاك", "مباشرة", "احتساب", "إعفاء" };
            if (conditionalBranches.Contains(secName))
            {
                var subList = _allTertiaryCategories.Where(t => t.SecondaryCategoryId == secId.Value).ToList();
                if (subList.Any())
                {
                    _availableTertiaryCategories = subList;
                    _isTertiaryEnabled = true;
                }
            }
            else if (secName == "لجنة")
            {
                var subList = _allTertiaryCategories.Where(t => t.SecondaryCategoryId == secId.Value).ToList();
                if (subList.Any())
                {
                    _availableTertiaryCategories = subList;
                }
                else
                {
                    string[] iraqiCommittees = {
                        "تحقيقية", "تدقيقية", "فتح وتحليل العطاءات", "استلام وإنجاز",
                        "مشتريات واعتدال أسعار", "شطب وإتلاف", "جرد سنوي", "تضمين",
                        "تثمين وبيع وإيجار أموال الدولة", "احتساب خدمة وتقاعد", "فنية تخصصية", "مقابلة وترقية"
                    };
                    int tempId = 1;
                    _availableTertiaryCategories = iraqiCommittees.Select(c => new TertiaryCategory
                    {
                        TertiaryCategoryId = tempId++,
                        SecondaryCategoryId = secId.Value,
                        Name = c
                    }).ToList();
                }
                _isTertiaryEnabled = true;
            }
        }
    }

    private async Task OnPdfFileSelected(IBrowserFile file)
    {
        if (file == null) return;

        try
        {
            _selectedFile = file;
            _finalExtension = Path.GetExtension(file.Name).ToLower();

            using var memoryStream = new MemoryStream();
            await file.OpenReadStream(50 * 1024 * 1024).CopyToAsync(memoryStream);
            _documentBytes = memoryStream.ToArray();

            if (!string.IsNullOrEmpty(_previewFileUrl))
            {
                await JS.InvokeVoidAsync("revokeBlobUrl", _previewFileUrl);
            }

            _previewFileUrl = await JS.InvokeAsync<string>(
                "createBlobUrlFromByteArray",
                _documentBytes,
                "application/pdf"
            );

            Snackbar.Add("تم تحميل الملف للمعاينة بنجاح", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ أثناء قراءة الملف: {ex.Message}", Severity.Error);
        }
    }

    private async Task ClearPreview()
    {
        if (!string.IsNullOrEmpty(_previewFileUrl))
        {
            await JS.InvokeVoidAsync("revokeBlobUrl", _previewFileUrl);
        }
        _previewFileUrl = string.Empty;
        _documentBytes = null;
        _selectedFile = null;
    }

    private async Task StartScannerAcquisition()
    {
        if (_settings == null || string.IsNullOrWhiteSpace(_settings.DefaultScannerName))
        {
            Snackbar.Add("يرجى تحديد الماسح الضوئي وحفظه في شاشة الإعدادات أولاً!", Severity.Warning);
            return;
        }

        _isScanning = true;
        try
        {
            Snackbar.Add("جارٍ الاتصال بالماسح وسحب المستند...", Severity.Info);

            var pdfBytes = await ScannerService.ScanDocumentAsync(
                _settings.DefaultScannerName,
                _settings.ScanSource ?? "Flatbed",
                "Color",
                150
            );

            if (pdfBytes != null && pdfBytes.Length > 0)
            {
                _documentBytes = pdfBytes;
                _finalExtension = ".pdf";
                _selectedFile = null;

                if (!string.IsNullOrEmpty(_previewFileUrl))
                {
                    await JS.InvokeVoidAsync("revokeBlobUrl", _previewFileUrl);
                }

                _previewFileUrl = await JS.InvokeAsync<string>(
                    "createBlobUrlFromByteArray",
                    _documentBytes,
                    "application/pdf"
                );

                Snackbar.Add("تم سحب المستند ومعاينته بنجاح!", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"تعذر إتمام المسح الضوئي: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isScanning = false;
            StateHasChanged();
        }
    }

    private string CleanFileSystemName(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return string.Empty;
        char[] invalidChars = Path.GetInvalidFileNameChars();
        string clean = string.Concat(input.Split(invalidChars, StringSplitOptions.RemoveEmptyEntries)).Trim();
        return clean.Replace('/', '-').Replace('\\', '-');
    }

    private async Task SaveDocument()
    {
        if (!CanSave) return;

        _isSaving = true;
        try
        {
            var settings = await DbContext.SystemSettings.AsNoTracking().FirstOrDefaultAsync();
            string baseFolder = settings?.BaseFolderPath ?? string.Empty;

            if (string.IsNullOrWhiteSpace(baseFolder) || !Directory.Exists(baseFolder))
            {
                Snackbar.Add("مسار المجلد الأساسي غير متاح، يرجى ضبطه من الإعدادات أولاً!", Severity.Error);
                _isSaving = false;
                return;
            }

            char[] invalidChars = Path.GetInvalidFileNameChars();
            string cleanSubject = CleanFileSystemName(_subject);
            string cleanDocNumber = CleanFileSystemName(_documentNumber);
            string formattedDate = _documentDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd");

            string storedFileName = $"{cleanSubject} - {cleanDocNumber} - {formattedDate}{_finalExtension}";

            string branchName = "الصادر";
            if (_selectedMainCatId.HasValue)
            {
                var mainCat = _mainCategories.FirstOrDefault(m => m.MainCategoryId == _selectedMainCatId.Value);
                if (mainCat != null && mainCat.Name.Contains("وارد"))
                {
                    branchName = "الوارد";
                }
            }

            string primaryFolderName = "عام";
            if (_selectedPrimaryCatId.HasValue)
            {
                var primCat = _allPrimaryCategories.FirstOrDefault(p => p.PrimaryCategoryId == _selectedPrimaryCatId.Value);
                if (primCat != null && !string.IsNullOrWhiteSpace(primCat.Name))
                {
                    primaryFolderName = CleanFileSystemName(primCat.Name);
                }
            }

            var document = new Document
            {
                Subject = _subject.Trim(),
                DocumentNumber = _documentNumber.Trim(),
                DocumentDate = formattedDate,
                OriginalFileName = _selectedFile?.Name ?? storedFileName,
                StoredFileName = storedFileName,
                FileExtension = _finalExtension,
                FilePath = string.Empty,
                MainCategoryId = _selectedMainCatId ?? 0,
                PrimaryCategoryId = _selectedPrimaryCatId ?? 0,
                SecondaryCategoryId = _selectedSecondaryCatId,
                TertiaryCategoryId = _selectedTertiaryCatId,
                CreatedAt = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"),
                UpdatedAt = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"),
                IsDeleted = 0
            };

            DbContext.Documents.Add(document);
            await DbContext.SaveChangesAsync();

            var selectedEmployees = await DbContext.Employees
                .Where(e => _selectedEmployeeIds.Contains(e.EmployeeId))
                .ToListAsync();

            string primaryRelativePath = string.Empty;

            foreach (var emp in selectedEmployees)
            {
                string cleanEmpName = string.Concat(emp.EmployeeName.Trim().Split(invalidChars, StringSplitOptions.RemoveEmptyEntries));
                string cleanEmpFile = string.Concat(emp.FileNumber.Trim().Split(invalidChars, StringSplitOptions.RemoveEmptyEntries));
                string empFolderRel = !string.IsNullOrWhiteSpace(emp.EmployeeFolderPath)
                    ? emp.EmployeeFolderPath
                    : $"{cleanEmpFile}_{cleanEmpName}";

                string targetCategoryDir = Path.Combine(baseFolder, empFolderRel, branchName, primaryFolderName);

                if (_selectedSecondaryCatId.HasValue)
                {
                    var secCat = _allSecondaryCategories.FirstOrDefault(s => s.SecondaryCategoryId == _selectedSecondaryCatId.Value);
                    if (secCat != null && !string.IsNullOrWhiteSpace(secCat.Name))
                    {
                        targetCategoryDir = Path.Combine(targetCategoryDir, CleanFileSystemName(secCat.Name));
                    }
                }

                if (!Directory.Exists(targetCategoryDir))
                {
                    Directory.CreateDirectory(targetCategoryDir);
                }

                string targetFilePath = Path.Combine(targetCategoryDir, storedFileName);

                if (File.Exists(targetFilePath))
                {
                    string uniqueSuffix = DateTime.Now.ToString("HHmmss");
                    string altFileName = $"{cleanSubject} - {cleanDocNumber} - {formattedDate}_{uniqueSuffix}{_finalExtension}";
                    targetFilePath = Path.Combine(targetCategoryDir, altFileName);
                }

                if (_documentBytes != null)
                {
                    await File.WriteAllBytesAsync(targetFilePath, _documentBytes);
                }

                string relEmployeeFilePath = Path.GetRelativePath(baseFolder, targetFilePath);

                if (string.IsNullOrEmpty(primaryRelativePath))
                {
                    primaryRelativePath = relEmployeeFilePath;
                }

                var docEmp = new DocumentEmployee
                {
                    DocumentId = document.DocumentId,
                    EmployeeId = emp.EmployeeId,
                    EmployeeFilePath = relEmployeeFilePath
                };

                DbContext.DocumentEmployees.Add(docEmp);
            }

            document.FilePath = primaryRelativePath;
            await DbContext.SaveChangesAsync();

            await SessionService.LogActivityAsync(
                actionType: "إضافة مستند",
                entityType: "مستند",
                entityId: document.DocumentId,
                description: $"تمت أرشفة كتاب ({document.Subject}) برقم ({document.DocumentNumber}) وتاريخ ({document.DocumentDate}) لعدد ({selectedEmployees.Count}) موظفين."
            );

            Snackbar.Add($"تم حفظ وتوزيع الكتاب على أضابير ({selectedEmployees.Count}) موظف بنجاح!", Severity.Success);
            Navigation.NavigateTo("/employees");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"حدث خطأ أثناء حفظ المستند: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (!string.IsNullOrEmpty(_previewFileUrl))
            {
                await JS.InvokeVoidAsync("revokeBlobUrl", _previewFileUrl);
            }
        }
        catch (JSDisconnectedException)
        {
            // تجاهل الاستثناء عند انقطاع الاتصال أو مغادرة الصفحة
        }
        catch (Exception)
        {
            // حماية من أي أخطاء أثناء تنظيف الموارد
        }
    }

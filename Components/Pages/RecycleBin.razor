    private async Task HardDeleteSingleLink(SingleDeletedLinkItem item)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "تأكيد الحذف النهائي من إضبارة الموظف",
            $"تحذير:\nأنت على وشك حذف قيد ربط الكتاب (رقم: {item.DocumentNumber} - {item.Subject}) بإضبارة الموظف ({item.EmployeeName}) نهائياً.\nسيتم مسح الملف من مجلد الموظف ولن يمكن استعادته لهذا الموظف مجدداً.\n\n(ملاحظة: إذا كان الكتاب مرتبطاً بموظفين آخرين فسيظل محفوظاً لديهم ويعمل بشكل طبيعي دون أي تأثر).\n\nهل ترغب بالمتابعة؟",
            yesText: "نعم، حذف نهائي",
            cancelText: "إلغاء");

        if (confirm != true) return;

        try
        {
            var linkDb = await DbContext.DocumentEmployees
                .IgnoreQueryFilters()
                .FirstOrDefaultAsync(de => de.DocumentEmployeeId == item.DocumentEmployeeId);

            if (linkDb != null)
            {
                // مسح الملف الفيزيائي من مجلد الموظف المعني فقط
                var settings = await DbContext.SystemSettings.AsNoTracking().FirstOrDefaultAsync();
                string baseFolder = settings?.BaseFolderPath ?? string.Empty;

                if (!string.IsNullOrWhiteSpace(baseFolder) && !string.IsNullOrWhiteSpace(linkDb.EmployeeFilePath))
                {
                    string fullPath = Path.Combine(baseFolder, linkDb.EmployeeFilePath);
                    if (File.Exists(fullPath))
                    {
                        try { File.Delete(fullPath); } catch { }
                    }
                }

                // حذف سجل الارتباط الفردي فقط من قاعدة البيانات دون المساس بسجل الكتاب الأصلي
                DbContext.DocumentEmployees.Remove(linkDb);
                await DbContext.SaveChangesAsync();

                await SessionService.LogActivityAsync(
                    actionType: "إتلاف ارتباط مستند نهائي",
                    entityType: "مستند / موظف",
                    entityId: item.DocumentId,
                    description: $"قام مدير النظام ({SessionService.CurrentUser?.UserName}) بالحذف والإتلاف النهائي لقيد كتاب ({item.Subject}) [رقم: {item.DocumentNumber}] من إضبارة الموظف ({item.EmployeeName}) فقط."
                );

                await LoadDeletedData();
                Snackbar.Add($"تم إتلاف القيد وحذفه نهائياً من إضبارة ({item.EmployeeName}) وبقاء الكتاب لباقي الموظفين", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"حدث خطأ أثناء الحذف النهائي: {ex.Message}", Severity.Error);
        }
    }


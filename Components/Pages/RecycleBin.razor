@page "/recycle-bin"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using DossierArchiveApp.Data
@using DossierArchiveApp.Models
@using DossierArchiveApp.Services
@inject AppDbContext DbContext
@inject NavigationManager Navigation
@inject UserSessionService SessionService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<div dir="rtl" class="pa-4">
    <!-- الترويسة الرئيسية -->
    <div class="d-flex align-center justify-space-between mb-4 pb-2" style="border-bottom: 2px solid #1B4D3E;">
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.DeleteSweep" Style="font-size: 2.2rem; color: #d32f2f;" />
            <div>
                <MudText Typo="Typo.h5" Class="fw-bold" Style="color: #1B4D3E;">سلة المحذوفات</MudText>
                <MudText Typo="Typo.caption" Class="text-secondary">إدارة واستعادة أو إتلاف المستندات وإضبارات الموظفين المحذوفة مؤقتاً</MudText>
            </div>
        </div>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadDeletedData">
            تحديث البيانات
        </MudButton>
    </div>

    <!-- التبويبات للفرز بين المحذوفات -->
    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4" Color="Color.Primary">

        <!-- تبويب 1: المستندات المحذوفة كلياً -->
        <MudTabPanel Text="المستندات المحذوفة كلياً" Icon="@Icons.Material.Filled.Description" BadgeData="@_deletedDocuments.Count" BadgeColor="Color.Error">
            <MudTable Items="@_deletedDocuments" Dense="true" Hover="true" Striped="true" Filter="new Func<FullDeletedDocItem, bool>(FilterFullDocFunc)" Loading="@_isLoading">
                <ToolBarContent>
                    <MudText Typo="Typo.h6" Class="fw-bold text-secondary">قائمة المستندات المحذوفة بالكامل</MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="_searchDocString" Placeholder="بحث برقم الكتاب، الموضوع، الموظف، أو الحاذف..." Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Immediate="true" />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>رقم الكتاب</MudTh>
                    <MudTh>تاريخ الكتاب</MudTh>
                    <MudTh>الموضوع</MudTh>
                    <MudTh>صاحب الإضبارة / المرتبطين</MudTh>
                    <MudTh>سبب الحذف</MudTh>
                    <MudTh>حُذف بواسطة</MudTh>
                    <MudTh>تاريخ الحذف</MudTh>
                    <MudTh Style="text-align: center;">الإجراءات</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="رقم الكتاب" Class="fw-bold">@context.Doc.DocumentNumber</MudTd>
                    <MudTd DataLabel="تاريخ الكتاب">@(context.Doc.DocumentDate?.ToString("yyyy/MM/dd") ?? "-")</MudTd>
                    <MudTd DataLabel="الموضوع">@context.Doc.Subject</MudTd>

                    <!-- عرض الموظف والشارة المنسدلة لبقية المرتبطين -->
                    <MudTd DataLabel="صاحب الإضبارة">
                        @if (!context.EmployeeNames.Any())
                        {
                            <span class="text-secondary" style="font-size: 0.8rem;">لا يوجد ارتباط</span>
                        }
                        else if (context.EmployeeNames.Count == 1)
                        {
                            <span style="font-size: 0.85rem; font-weight: bold; color: #1B4D3E;">
                                @context.EmployeeNames.First()
                            </span>
                        }
                        else
                        {
                            <div class="d-flex align-center gap-1">
                                <span style="font-size: 0.85rem; font-weight: bold; color: #1B4D3E;">
                                    @context.EmployeeNames.First()
                                </span>

                                <MudMenu AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" Dense="true">
                                    <ActivatorContent>
                                        <MudTooltip Text="عرض بقية الموظفين المرتبطين بهذا الكتاب">
                                            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined" Style="cursor: pointer; height: 22px; font-weight: bold;">
                                                +@(context.EmployeeNames.Count - 1) آخرين
                                            </MudChip>
                                        </MudTooltip>
                                    </ActivatorContent>
                                    <ChildContent>
                                        <div class="pa-2" dir="rtl" style="min-width: 200px;">
                                            <MudText Typo="Typo.caption" Class="fw-bold text-secondary d-block mb-1">الموظفون المشتركون في الكتاب:</MudText>
                                            <MudDivider Class="mb-1" />
                                            @foreach (var empName in context.EmployeeNames)
                                            {
                                                <div class="d-flex align-center gap-2 py-1">
                                                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Color="Color.Primary" />
                                                    <span style="font-size: 0.82rem;">@empName</span>
                                                </div>
                                            }
                                        </div>
                                    </ChildContent>
                                </MudMenu>
                            </div>
                        }
                    </MudTd>

                    <MudTd DataLabel="سبب الحذف">
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">
                            @(string.IsNullOrWhiteSpace(context.Doc.DeleteReason) ? "لم يذكر سبب" : context.Doc.DeleteReason)
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="حُذف بواسطة">
                        <MudChip T="string" Color="Color.Dark" Size="Size.Small" Variant="Variant.Outlined">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="me-1" />
                            @context.DeletedByUserName
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="تاريخ الحذف">
                        <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Outlined">
                            @(context.Doc.DeletedAt?.ToString("yyyy/MM/dd") ?? "-")
                        </MudChip>
                    </MudTd>
                    <MudTd Style="text-align: center;">
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Restore" OnClick="@(() => RestoreDocument(context.Doc))" Class="me-2">
                            استعادة للجميع
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.DeleteForever" OnClick="@(() => HardDeleteDocument(context.Doc))">
                            حذف نهائي
                        </MudButton>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="pa-4 text-center text-muted">لا توجد مستندات محذوفة كلياً في السلة.</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudTabPanel>

        <!-- تبويب 2: المستندات المستبعدة من موظف معين (حذف فردي) -->
        <MudTabPanel Text="مستندات مستبعدة فردياً" Icon="@Icons.Material.Filled.LinkOff" BadgeData="@_singleDeletedLinks.Count" BadgeColor="Color.Warning">
            <MudTable Items="@_singleDeletedLinks" Dense="true" Hover="true" Striped="true" Filter="new Func<SingleDeletedLinkItem, bool>(FilterSingleLinkFunc)" Loading="@_isLoading">
                <ToolBarContent>
                    <MudText Typo="Typo.h6" Class="fw-bold text-secondary">مستندات محذوفة من أضابير موظفين محددين</MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="_searchSingleString" Placeholder="بحث باسم الموظف، رقم الكتاب، الحاذف..." Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Immediate="true" />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>اسم الموظف</MudTh>
                    <MudTh>رقم الكتاب</MudTh>
                    <MudTh>تاريخ الكتاب</MudTh>
                    <MudTh>الموضوع</MudTh>
                    <MudTh>سبب الاستبعاد</MudTh>
                    <MudTh>حُذف بواسطة</MudTh>
                    <MudTh>تاريخ الحذف</MudTh>
                    <MudTh Style="text-align: center;">الإجراءات</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="اسم الموظف" Class="fw-bold" Style="color: #1B4D3E;">@context.EmployeeName</MudTd>
                    <MudTd DataLabel="رقم الكتاب">@context.DocumentNumber</MudTd>
                    <MudTd DataLabel="تاريخ الكتاب">@(context.DocumentDate?.ToString("yyyy/MM/dd") ?? "-")</MudTd>
                    <MudTd DataLabel="الموضوع">@context.Subject</MudTd>
                    <MudTd DataLabel="سبب الاستبعاد">
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">
                            @(string.IsNullOrWhiteSpace(context.DeleteReason) ? "لم يذكر سبب" : context.DeleteReason)
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="حُذف بواسطة">
                        <MudChip T="string" Color="Color.Dark" Size="Size.Small" Variant="Variant.Outlined">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="me-1" />
                            @context.DeletedByUserName
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="تاريخ الحذف">
                        <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Outlined">
                            @(context.DeletedAt?.ToString("yyyy/MM/dd") ?? "-")
                        </MudChip>
                    </MudTd>
                    <MudTd Style="text-align: center;">
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Restore" OnClick="@(() => RestoreSingleLink(context))" Class="me-2">
                            استعادة للموظف
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.DeleteForever" OnClick="@(() => HardDeleteSingleLink(context))">
                            حذف نهائي
                        </MudButton>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="pa-4 text-center text-muted">لا توجد ارتباطات مستبعدة فردياً حالياً.</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudTabPanel>

        <!-- تبويب 3: إضبارات الموظفين المحذوفة -->
        <MudTabPanel Text="أضابير الموظفين المحذوفة" Icon="@Icons.Material.Filled.Badge" BadgeData="@_deletedEmployees.Count" BadgeColor="Color.Error">
            <MudTable Items="@_deletedEmployees" Dense="true" Hover="true" Striped="true" Filter="new Func<DeletedEmployeeItem, bool>(FilterEmpFunc)" Loading="@_isLoading">
                <ToolBarContent>
                    <MudText Typo="Typo.h6" Class="fw-bold text-secondary">قائمة الموظفين في السلة</MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="_searchEmpString" Placeholder="بحث باسم الموظف، رقم الإضبارة، الحاذف..." Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Immediate="true" />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>رقم الإضبارة</MudTh>
                    <MudTh>اسم الموظف</MudTh>
                    <MudTh>سبب الحذف</MudTh>
                    <MudTh>حُذف بواسطة</MudTh>
                    <MudTh>تاريخ الحذف</MudTh>
                    <MudTh Style="text-align: center;">الإجراءات</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="رقم الإضبارة" Class="fw-bold">@context.Emp.FileNumber</MudTd>
                    <MudTd DataLabel="اسم الموظف">@context.Emp.EmployeeName</MudTd>
                    <MudTd DataLabel="سبب الحذف">
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">
                            @(string.IsNullOrWhiteSpace(context.Emp.DeleteReason) ? "لم يذكر سبب" : context.Emp.DeleteReason)
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="حُذف بواسطة">
                        <MudChip T="string" Color="Color.Dark" Size="Size.Small" Variant="Variant.Outlined">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="me-1" />
                            @context.DeletedByUserName
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="تاريخ الحذف">
                        <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Outlined">
                            @(context.Emp.DeletedAt?.ToString("yyyy/MM/dd") ?? "-")
                        </MudChip>
                    </MudTd>
                    <MudTd Style="text-align: center;">
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Restore" OnClick="@(() => RestoreEmployee(context.Emp))" Class="me-2">
                            استعادة
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.DeleteForever" OnClick="@(() => HardDeleteEmployee(context.Emp))">
                            حذف نهائي
                        </MudButton>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="pa-4 text-center text-muted">لا توجد إضبارات موظفين في سلة المحذوفات حالياً.</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudTabPanel>

    </MudTabs>
</div>

@code {
    public class FullDeletedDocItem
    {
        public Document Doc { get; set; } = new();
        public List<string> EmployeeNames { get; set; } = new();
        public string DeletedByUserName { get; set; } = "غير محدد";
    }

    public class SingleDeletedLinkItem
    {
        public int DocumentEmployeeId { get; set; }
        public int DocumentId { get; set; }
        public int EmployeeId { get; set; }
        public string EmployeeName { get; set; } = string.Empty;
        public string DocumentNumber { get; set; } = string.Empty;
        public DateTime? DocumentDate { get; set; }
        public string Subject { get; set; } = string.Empty;
        public string? DeleteReason { get; set; }
        public string DeletedByUserName { get; set; } = "غير محدد";
        public DateTime? DeletedAt { get; set; }
    }

    public class DeletedEmployeeItem
    {
        public Employee Emp { get; set; } = new();
        public string DeletedByUserName { get; set; } = "غير محدد";
    }

    private List<FullDeletedDocItem> _deletedDocuments = new();
    private List<SingleDeletedLinkItem> _singleDeletedLinks = new();
    private List<DeletedEmployeeItem> _deletedEmployees = new();
    private bool _isLoading = false;
    private string _searchDocString = string.Empty;
    private string _searchSingleString = string.Empty;
    private string _searchEmpString = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (SessionService.CurrentUser == null || !SessionService.CanAccessSettingsOrUsers)
        {
            Snackbar.Add("عذراً، الوصول إلى سلة المحذوفات مقتصر على مدير النظام فقط!", Severity.Error);
            Navigation.NavigateTo("/employees");
            return;
        }

        await LoadDeletedData();
    }

    private async Task LoadDeletedData()
    {
        _isLoading = true;
        try
        {
            // خريطة المستخدمين لتحويل UserId إلى الاسم الظاهر
            var usersMap = await DbContext.Users
                .AsNoTracking()
                .ToDictionaryAsync(u => u.UserId, u => string.IsNullOrWhiteSpace(u.FullName) ? u.UserName : u.FullName);

            // خريطة أسماء الموظفين مع كسر الفلتر العام
            var empsMap = await DbContext.Employees
                .IgnoreQueryFilters()
                .AsNoTracking()
                .ToDictionaryAsync(e => e.EmployeeId, e => e.EmployeeName);

            // 1. المستندات المحذوفة كلياً
            var rawDeletedDocs = await DbContext.Documents
                .IgnoreQueryFilters()
                .AsNoTracking()
                .Where(d => d.IsDeleted == 1)
                .OrderByDescending(d => d.DeletedAt)
                .ToListAsync();

            var docIds = rawDeletedDocs.Select(d => d.DocumentId).ToList();

            // روابط المستندات لمعرفة أصحاب الإضابير
            var docLinks = await DbContext.DocumentEmployees
                .IgnoreQueryFilters()
                .AsNoTracking()
                .Where(de => docIds.Contains(de.DocumentId))
                .ToListAsync();

            // تجميع الأسماء كقائمة List<string> لكل كتاب
            var docToEmpList = docLinks
                .GroupBy(l => l.DocumentId)
                .ToDictionary(
                    g => g.Key,
                    g => g.Select(x => empsMap.TryGetValue(x.EmployeeId, out var name) ? name : $"#{x.EmployeeId}").Distinct().ToList()
                );

            _deletedDocuments = rawDeletedDocs.Select(d => new FullDeletedDocItem
            {
                Doc = d,
                EmployeeNames = docToEmpList.TryGetValue(d.DocumentId, out var empList) ? empList : new List<string>(),
                DeletedByUserName = d.DeletedBy.HasValue && usersMap.TryGetValue(d.DeletedBy.Value, out var uName) ? uName : (SessionService.CurrentUser?.UserName ?? "المدير")
            }).ToList();

            // 2. المستندات المفكوكة فردياً (المستند حي IsDeleted == 0 ولكن رابطه بهذا الموظف محذوف IsDeleted == 1)
            var allDeletedLinks = await DbContext.DocumentEmployees
                .IgnoreQueryFilters()
                .AsNoTracking()
                .Where(de => de.IsDeleted == 1)
                .ToListAsync();

            if (allDeletedLinks.Any())
            {
                var singleDocIds = allDeletedLinks.Select(l => l.DocumentId).Distinct().ToList();

                var activeDocs = await DbContext.Documents
                    .IgnoreQueryFilters()
                    .AsNoTracking()
                    .Where(d => singleDocIds.Contains(d.DocumentId) && d.IsDeleted == 0)
                    .ToDictionaryAsync(d => d.DocumentId, d => d);

                _singleDeletedLinks = allDeletedLinks
                    .Where(l => activeDocs.ContainsKey(l.DocumentId) && empsMap.ContainsKey(l.EmployeeId))
                    .Select(l => new SingleDeletedLinkItem
                    {
                        DocumentEmployeeId = l.DocumentEmployeeId,
                        DocumentId = l.DocumentId,
                        EmployeeId = l.EmployeeId,
                        EmployeeName = empsMap[l.EmployeeId],
                        DocumentNumber = activeDocs[l.DocumentId].DocumentNumber,
                        DocumentDate = activeDocs[l.DocumentId].DocumentDate,
                        Subject = activeDocs[l.DocumentId].Subject,
                        DeleteReason = l.DeleteReason,
                        DeletedByUserName = l.DeletedBy.HasValue && usersMap.TryGetValue(l.DeletedBy.Value, out var uName) ? uName : (SessionService.CurrentUser?.UserName ?? "المدير"),
                        DeletedAt = l.DeletedAt
                    })
                    .OrderByDescending(x => x.DeletedAt)
                    .ToList();
            }
            else
            {
                _singleDeletedLinks.Clear();
            }

            // 3. الموظفون المحذوفون
            var rawDeletedEmps = await DbContext.Employees
                .IgnoreQueryFilters()
                .AsNoTracking()
                .Where(e => e.IsDeleted == 1)
                .OrderByDescending(e => e.DeletedAt)
                .ToListAsync();

            _deletedEmployees = rawDeletedEmps.Select(e => new DeletedEmployeeItem
            {
                Emp = e,
                DeletedByUserName = e.DeletedBy.HasValue && usersMap.TryGetValue(e.DeletedBy.Value, out var uName) ? uName : (SessionService.CurrentUser?.UserName ?? "المدير")
            }).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"تعذر جلب بيانات السلة: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    // ==========================================
    // إجراءات المستندات الكلية
    // ==========================================

    private async Task RestoreDocument(Document doc)
    {
        try
        {
            var docDb = await DbContext.Documents.IgnoreQueryFilters().FirstOrDefaultAsync(d => d.DocumentId == doc.DocumentId);
            if (docDb != null)
            {
                docDb.IsDeleted = 0;
                docDb.DeletedAt = null;
                docDb.DeleteReason = null;
                docDb.DeletedBy = null;
                DbContext.Documents.Update(docDb);
            }

            var links = await DbContext.DocumentEmployees
                .IgnoreQueryFilters()
                .Where(de => de.DocumentId == doc.DocumentId)
                .ToListAsync();

            foreach (var link in links)
            {
                link.IsDeleted = 0;
                link.DeletedAt = null;
                link.DeleteReason = null;
                link.DeletedBy = null;
                DbContext.DocumentEmployees.Update(link);
            }

            await DbContext.SaveChangesAsync();

            await SessionService.LogActivityAsync(
                actionType: "استعادة مستند كلي",
                entityType: "مستند",
                entityId: doc.DocumentId,
                description: $"قام مدير النظام ({SessionService.CurrentUser?.UserName}) باستعادة المستند ({doc.Subject}) ذي الرقم ({doc.DocumentNumber}) وإرجاعه لكافة الأضابير."
            );

            await LoadDeletedData();
            Snackbar.Add("تمت استعادة المستند بنجاح إلى كافة الأضابير المرتبطة به", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"فشلت استعادة المستند: {ex.Message}", Severity.Error);
        }
    }

    private async Task HardDeleteDocument(Document doc)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "إتلاف وحذف نهائي لا رجعة فيه",
            $"تحذير أمني: هل أنت متأكد من الحذف النهائي للمستند (رقم: {doc.DocumentNumber} - {doc.Subject})؟\nسيتم مسح الملفات الفيزيائية من القرص وحذف السجلات نهائياً من قاعدة البيانات.",
            yesText: "نعم، حذف نهائي الآن",
            cancelText: "إلغاء");

        if (confirm != true) return;

        try
        {
            var settings = await DbContext.SystemSettings.AsNoTracking().FirstOrDefaultAsync();
            string baseFolder = settings?.BaseFolderPath ?? string.Empty;

            var links = await DbContext.DocumentEmployees
                .IgnoreQueryFilters()
                .Where(de => de.DocumentId == doc.DocumentId)
                .ToListAsync();

            if (!string.IsNullOrWhiteSpace(baseFolder) && Directory.Exists(baseFolder))
            {
                foreach (var link in links)
                {
                    if (!string.IsNullOrWhiteSpace(link.EmployeeFilePath))
                    {
                        string fullPath = Path.Combine(baseFolder, link.EmployeeFilePath);
                        if (File.Exists(fullPath))
                        {
                            try { File.Delete(fullPath); } catch { }
                        }
                    }
                }
            }

            DbContext.DocumentEmployees.RemoveRange(links);
            var docDb = await DbContext.Documents.IgnoreQueryFilters().FirstOrDefaultAsync(d => d.DocumentId == doc.DocumentId);
            if (docDb != null)
            {
                DbContext.Documents.Remove(docDb);
            }

            await DbContext.SaveChangesAsync();

            await SessionService.LogActivityAsync(
                actionType: "إتلاف مستند نهائي",
                entityType: "مستند",
                entityId: doc.DocumentId,
                description: $"قام مدير النظام ({SessionService.CurrentUser?.UserName}) بالحذف والإتلاف النهائي للمستند ({doc.Subject}) وملفاته الفيزيائية."
            );

            await LoadDeletedData();
            Snackbar.Add("تم إتلاف المستند وحذف ملفاته نهائياً من القرص والقاعدة", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"حدث خطأ أثناء الحذف النهائي: {ex.Message}", Severity.Error);
        }
    }


@using DossierArchiveApp.Data
@using DossierArchiveApp.Models
@using Microsoft.EntityFrameworkCore
@using DossierArchiveApp.Services
@using System.IO
@inject UserSessionService SessionService
@inject AppDbContext DbContext
@inject ISnackbar Snackbar

<MudRTLProvider RightToLeft="true">
    <MudDialog Style="direction: rtl; text-align: right;">
        <TitleContent>
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.EditNote" Color="Color.Primary" />
                <MudText Typo="Typo.h6" Class="fw-bold" Style="color: #1B4D3E;">تعديل بيانات وإضبارة الموظف</MudText>
            </div>
        </TitleContent>
        <DialogContent>
            <MudForm @ref="_form" @bind-IsValid="_isValid">

                @if (SessionService.IsSuperAdmin)
                {
                    <MudSelect T="int?"
                               @bind-Value="_selectedDepartmentId"
                               Label="الشعبة التابع لها الموظف"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Required="true"
                               RequiredError="يرجى تحديد الشعبة التابع لها الموظف"
                               Dense="true"
                               Class="mb-4">
                        @foreach (var dept in _departments)
                        {
                            <MudSelectItem T="int?" Value="@((int?)dept.DepartmentId)">@dept.Name</MudSelectItem>
                        }
                    </MudSelect>
                }
                else
                {
                    <div class="pa-2 mb-3 rounded" style="background-color: #f1f8f5; border: 1px solid #c8e6c9;">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">الشعبة المسجلة للإضبارة:</MudText>
                        <MudText Typo="Typo.body2" Class="fw-bold" Style="color: #1B4D3E;">
                            @(_currentDeptName ?? SessionService.CurrentDepartmentName)
                        </MudText>
                    </div>
                }

                <MudTextField T="string"
                              Label="اسم الموظف الكامل"
                              @bind-Value="_employeeName"
                              Required="true"
                              RequiredError="يرجى إدخال اسم الموظف"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mb-4" />

                <MudTextField T="string"
                              Label="رقم الأضبارة"
                              @bind-Value="_fileNumber"
                              Required="true"
                              RequiredError="يرجى تحديد رقم الأضبارة"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mb-4" />

                <div class="d-flex align-center justify-space-between mt-2 px-1">
                    <MudText Typo="Typo.body2" Class="fw-bold">الموظف في الخدمة الفعلية (فعال)</MudText>
                    <MudSwitch @bind-Value="_isActive"
                               Color="Color.Success" />
                </div>
            </MudForm>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="Cancel" Variant="Variant.Text" Color="Color.Secondary">إلغاء</MudButton>
            <MudButton OnClick="Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@(!_isValid || _isSaving)"
                       Style="background-color: #1B4D3E; color: white; min-width: 140px;">
                @if (_isSaving)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <span class="ms-2">جارٍ التحديث...</span>
                }
                else
                {
                    <span>حفظ التعديلات</span>
                }
            </MudButton>
        </DialogActions>
    </MudDialog>
</MudRTLProvider>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Employee EmployeeToEdit { get; set; } = default!;

    private MudForm _form = default!;
    private bool _isValid;
    private bool _isSaving;
    private string _employeeName = string.Empty;
    private string _fileNumber = string.Empty;
    private bool _isActive = true;

    private int? _selectedDepartmentId;
    private string? _currentDeptName;
    private List<Department> _departments = new();

    protected override async Task OnInitializedAsync()
    {
        if (EmployeeToEdit != null)
        {
            _employeeName = EmployeeToEdit.EmployeeName;
            _fileNumber = EmployeeToEdit.FileNumber;
            _isActive = EmployeeToEdit.IsActive == 1;
            _selectedDepartmentId = EmployeeToEdit.DepartmentId;

            if (EmployeeToEdit.DepartmentId.HasValue)
            {
                var dept = await DbContext.Departments.FindAsync(EmployeeToEdit.DepartmentId.Value);
                _currentDeptName = dept?.Name;
            }

            if (SessionService.IsSuperAdmin)
            {
                _departments = await DbContext.Departments
                    .Where(d => d.IsActive == 1)
                    .OrderBy(d => d.DepartmentId)
                    .ToListAsync();
            }
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.Validate();
        if (!_isValid) return;

        if (SessionService.IsSuperAdmin && !_selectedDepartmentId.HasValue)
        {
            Snackbar.Add("يرجى اختيار الشعبة التي يتبع لها الموظف!", Severity.Warning);
            return;
        }

        string trimmedName = _employeeName.Trim();
        string trimmedFile = _fileNumber.Trim();

        _isSaving = true;
        try
        {
            var settings = await DbContext.SystemSettings.AsNoTracking().FirstOrDefaultAsync();
            if (settings == null || string.IsNullOrWhiteSpace(settings.BaseFolderPath))
            {
                Snackbar.Add("لم يتم تحديد مسار مجلد النظام الرئيسي في الإعدادات!", Severity.Error);
                _isSaving = false;
                return;
            }

            if (!Directory.Exists(settings.BaseFolderPath))
            {
                Snackbar.Add($"مجلد النظام الرئيسي غير موجود على القرص ({settings.BaseFolderPath})!", Severity.Error);
                _isSaving = false;
                return;
            }

            // التحقق من تكرار الاسم ورقم الإضبارة مع موظف آخر
            bool nameExists = await DbContext.Employees.AnyAsync(e => e.EmployeeId != EmployeeToEdit.EmployeeId && e.EmployeeName == trimmedName);
            if (nameExists)
            {
                Snackbar.Add("اسم الموظف مسجل لموظف آخر في النظام!", Severity.Warning);
                _isSaving = false;
                return;
            }

            bool fileExists = await DbContext.Employees.AnyAsync(e => e.EmployeeId != EmployeeToEdit.EmployeeId && e.FileNumber == trimmedFile);
            if (fileExists)
            {
                Snackbar.Add("رقم الأضبارة مستخدم مسبقاً لموظف آخر!", Severity.Warning);
                _isSaving = false;
                return;
            }

            char[] invalidChars = Path.GetInvalidFileNameChars();
            string cleanName = string.Concat(trimmedName.Split(invalidChars, StringSplitOptions.RemoveEmptyEntries));
            string cleanFile = string.Concat(trimmedFile.Split(invalidChars, StringSplitOptions.RemoveEmptyEntries));

            int? targetDeptId = SessionService.IsSuperAdmin ? _selectedDepartmentId : EmployeeToEdit.DepartmentId;

            // تحديد اسم مجلد الشعبة الفيزيائي الجديد
            string deptFolderName = "المديرية العامة";
            if (targetDeptId.HasValue)
            {
                var targetDept = await DbContext.Departments.FindAsync(targetDeptId.Value);
                if (targetDept != null && !string.IsNullOrWhiteSpace(targetDept.Name))
                {
                    deptFolderName = string.Concat(targetDept.Name.Trim().Split(invalidChars, StringSplitOptions.RemoveEmptyEntries));
                }
            }

            string newFolderRelPath = Path.Combine(deptFolderName, $"{cleanFile}_{cleanName}");
            string newFolderFullPath = Path.Combine(settings.BaseFolderPath, newFolderRelPath);

            string oldFolderRelPath = EmployeeToEdit.EmployeeFolderPath ?? string.Empty;
            string oldFolderFullPath = !string.IsNullOrWhiteSpace(oldFolderRelPath)
                ? Path.Combine(settings.BaseFolderPath, oldFolderRelPath)
                : string.Empty;

            // معالجة نقل المجلد الفيزيائي إذا تغير الاسم، الرقم، أو الشعبة
            if (!string.Equals(oldFolderRelPath, newFolderRelPath, StringComparison.OrdinalIgnoreCase))
            {
                string? targetParentDir = Path.GetDirectoryName(newFolderFullPath);
                if (!string.IsNullOrEmpty(targetParentDir) && !Directory.Exists(targetParentDir))
                {
                    Directory.CreateDirectory(targetParentDir);
                }

                if (!string.IsNullOrWhiteSpace(oldFolderFullPath) && Directory.Exists(oldFolderFullPath))
                {
                    Directory.Move(oldFolderFullPath, newFolderFullPath);

                    // تحديث مسارات المستندات في جدول الربط TB_DocumentEmployees
                    var docEmployees = await DbContext.DocumentEmployees
                        .Where(de => de.EmployeeId == EmployeeToEdit.EmployeeId)
                        .ToListAsync();

                    foreach (var de in docEmployees)
                    {
                        if (!string.IsNullOrEmpty(de.EmployeeFilePath) && de.EmployeeFilePath.StartsWith(oldFolderRelPath))
                        {
                            de.EmployeeFilePath = newFolderRelPath + de.EmployeeFilePath.Substring(oldFolderRelPath.Length);
                        }
                    }
                }
                else
                {
                    if (!Directory.Exists(newFolderFullPath))
                    {
                        Directory.CreateDirectory(newFolderFullPath);
                    }

                    // تجهيز التصنيفات الأساسية
                    string[] rootBranches = { "الصادر", "الوارد" };
                    var primaryCategories = await DbContext.PrimaryCategories.AsNoTracking().ToListAsync();
                    List<string> categoryNames = primaryCategories
                        .Select(c => c.Name.Trim())
                        .Where(name => name != "صادر" && name != "وارد" && name != "الصادر" && name != "الوارد")
                        .Distinct()
                        .ToList();

                    if (!categoryNames.Any())
                    {
                        categoryNames = new List<string> { "أوامر إدارية", "استمارات ومستمسكات", "طلبات شخصية", "كتب اعتيادية" };
                    }

                    foreach (var branch in rootBranches)
                    {
                        string branchFullPath = Path.Combine(newFolderFullPath, branch);
                        if (!Directory.Exists(branchFullPath)) Directory.CreateDirectory(branchFullPath);

                        foreach (var cat in categoryNames)
                        {
                            string cleanCat = string.Concat(cat.Split(invalidChars, StringSplitOptions.RemoveEmptyEntries));
                            string subCategoryFolder = Path.Combine(branchFullPath, cleanCat);
                            if (!Directory.Exists(subCategoryFolder)) Directory.CreateDirectory(subCategoryFolder);
                        }
                    }
                }
            }

            // تحديث السجل في قاعدة البيانات
            var empDb = await DbContext.Employees.FirstOrDefaultAsync(e => e.EmployeeId == EmployeeToEdit.EmployeeId);
            if (empDb != null)
            {
                string oldName = empDb.EmployeeName;

                empDb.EmployeeName = trimmedName;
                empDb.FileNumber = trimmedFile;
                empDb.DepartmentId = targetDeptId;
                empDb.IsActive = _isActive ? 1 : 0;
                empDb.EmployeeFolderPath = newFolderRelPath;
                empDb.UpdatedAt = DateTime.Now;

                await DbContext.SaveChangesAsync();

                await SessionService.LogActivityAsync(
                    actionType: "تعديل موظف",
                    entityType: "موظف",
                    entityId: empDb.EmployeeId,
                    description: $"تم تعديل بيانات الموظف ({oldName}) - الاسم: ({empDb.EmployeeName})، رقم الإضبارة: ({empDb.FileNumber})، الشعبة: ({deptFolderName})."
                );

                // مزامنة الكائن المعروض في الشاشة
                EmployeeToEdit.EmployeeName = empDb.EmployeeName;
                EmployeeToEdit.FileNumber = empDb.FileNumber;
                EmployeeToEdit.DepartmentId = empDb.DepartmentId;
                EmployeeToEdit.IsActive = empDb.IsActive;
                EmployeeToEdit.EmployeeFolderPath = empDb.EmployeeFolderPath;
                EmployeeToEdit.UpdatedAt = empDb.UpdatedAt;

                Snackbar.Add("تم تحديث بيانات الموظف والشعبة ومجلداته بنجاح!", Severity.Success);
                MudDialog.Close(DialogResult.Ok(EmployeeToEdit));
            }
            else
            {
                Snackbar.Add("لم يتم العثور على سجل الموظف في قاعدة البيانات!", Severity.Error);
            }
        }
        catch (DbUpdateException)
        {
            Snackbar.Add("تعذر التعديل لوجود تشابه في القيود الفريدة لقاعدة البيانات", Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"حدث خطأ أثناء تعديل المجلدات أو الحفظ: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }
}
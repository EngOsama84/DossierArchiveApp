@inherits LayoutComponentBase
@using Microsoft.EntityFrameworkCore
@using DossierArchiveApp.Data
@using DossierArchiveApp.Models
@using DossierArchiveApp.Services
@using DossierArchiveApp.Components.Pages
@inject AppDbContext DbContext
@inject UserSessionService SessionService
@inject IDialogService DialogService

<MudThemeProvider Theme="_customTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudRTLProvider RightToLeft="true">
    @if (!SessionService.IsLoggedIn)
    {
        <!-- إجبار تسجيل الدخول عند بدء التشغيل أو بعد تسجيل الخروج -->
        <LoginOverlay />
    }
    else
    {
        <MudLayout>
            <!-- الترويسة العلوية -->
            <MudAppBar Elevation="1" Dense="true" Fixed="true" Style="background-color: #1B4D3E; color: white;">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />

                <!-- شعار المديرية -->
                @if (!string.IsNullOrEmpty(_settings?.LogoPath))
                {
                    <img src="@_settings.LogoPath" style="height: 32px; width: 32px; object-fit: contain; margin-left: 10px; border-radius: 4px; background: white; padding: 2px;" alt="شعار" />
                }

                <!-- اسم المديرية والقسم -->
                <div class="d-flex flex-column mr-2">
                    <MudText Typo="Typo.subtitle1" Class="fw-bold" Style="line-height: 1.2;">
                        @(!string.IsNullOrEmpty(_settings?.DirectorateName) ? _settings.DirectorateName : "نظام إدارة الأضابير والأرشفة الإلكترونية")
                    </MudText>
                    @if (!string.IsNullOrEmpty(_settings?.DepartmentName))
                    {
                        <MudText Typo="Typo.caption" Style="opacity: 0.85;">
                            @_settings.DepartmentName
                        </MudText>
                    }
                </div>

                <MudSpacer />

                <!-- قائمة المستخدم: عرض الاسم الكامل وتسمية الشعبة بدقة -->
                <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Dense="true">
                    <ActivatorContent>
                        <div class="d-flex align-center gap-2 px-3 py-1 rounded" style="cursor: pointer; background-color: rgba(255, 255, 255, 0.12); border: 1px solid rgba(255, 255, 255, 0.2);">

                            <!-- الأفاتار: أول حرف من الاسم الكامل -->
                            <MudAvatar Color="Color.Surface" Size="Size.Small" Style="background-color: white; color: #1B4D3E; font-weight: bold; width: 30px; height: 30px; font-size: 0.9rem;">
                                @GetAvatarInitial()
                            </MudAvatar>

                            <!-- تفاصيل المستخدم: الاسم الكامل والشعبة -->
                            <div class="d-flex flex-column text-end">
                                <span class="fw-bold" style="font-size: 0.88rem; line-height: 1.2; color: white;">
                                    @GetUserDisplayName()
                                </span>
                                <span style="font-size: 0.72rem; color: #c8e6c9; line-height: 1.1;">
                                    @GetUserSubTitle()
                                </span>
                            </div>

                            <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" Style="color: white;" />
                        </div>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem Icon="@Icons.Material.Filled.LockReset" IconColor="Color.Primary" OnClick="OpenChangePasswordDialog">
                            تغيير كلمة المرور
                        </MudMenuItem>
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error" OnClick="Logout">
                            تسجيل الخروج
                        </MudMenuItem>
                    </ChildContent>
                </MudMenu>

            </MudAppBar>

            <!-- القائمة الجانبية -->
            <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2" Width="210px">
                <NavMenu />
            </MudDrawer>

            <!-- مساحة العمل -->
            <MudMainContent Class="pt-12 px-2 pb-4">
                @Body
            </MudMainContent>
        </MudLayout>
    }
</MudRTLProvider>

<style>
    body, *, .mud-typography, .mud-input, .mud-button-root, .mud-table {
        font-family: '@(_selectedFont)', 'Dubai', 'Segoe UI', Tahoma, sans-serif !important;
    }
</style>

@code {
    private bool _drawerOpen = false;
    private SystemSetting? _settings;
    private string _selectedFont = "Dubai";
    private MudTheme _customTheme = new();

    private void DrawerToggle() => _drawerOpen = !_drawerOpen;

    protected override async Task OnInitializedAsync()
    {
        SessionService.OnSessionChanged += HandleSessionChanged;

        UpdateDrawerState();

        try
        {
            _settings = await DbContext.SystemSettings.AsNoTracking().FirstOrDefaultAsync();
            if (_settings != null && !string.IsNullOrWhiteSpace(_settings.FontFamily))
            {
                _selectedFont = _settings.FontFamily;
            }
        }
        catch
        {
            _selectedFont = "Dubai";
        }

        _customTheme = new MudTheme()
        {
            Typography = new Typography()
            {
                Default = new DefaultTypography()
                {
                    FontFamily = new[] { _selectedFont, "Dubai", "Segoe UI", "Tahoma", "sans-serif" }
                }
            }
        };
    }

    private string GetAvatarInitial()
    {
        var fullName = SessionService.CurrentUser?.FullName?.Trim();
        if (!string.IsNullOrWhiteSpace(fullName))
        {
            return fullName[0].ToString().ToUpper();
        }

        var userName = SessionService.CurrentUser?.UserName?.Trim();
        if (!string.IsNullOrWhiteSpace(userName))
        {
            return userName[0].ToString().ToUpper();
        }

        return "م";
    }

    private string GetUserDisplayName()
    {
        if (!string.IsNullOrWhiteSpace(SessionService.CurrentUser?.FullName))
        {
            return SessionService.CurrentUser.FullName;
        }

        return SessionService.CurrentUser?.UserName ?? "المستخدم";
    }

    private string GetUserSubTitle()
    {
        if (SessionService.IsSuperAdmin)
        {
            return "الإدارة العامة (مدير النظام)";
        }

        if (!string.IsNullOrWhiteSpace(SessionService.CurrentDepartmentName))
        {
            return SessionService.CurrentDepartmentName;
        }

        return SessionService.RoleName;
    }

    private void HandleSessionChanged()
    {
        UpdateDrawerState();
        StateHasChanged();
    }

    private void UpdateDrawerState()
    {
        _drawerOpen = SessionService.IsLoggedIn && SessionService.IsAdmin;
    }

    private async Task OpenChangePasswordDialog()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        await DialogService.ShowAsync<ChangePasswordDialog>("تغيير كلمة المرور", options);
    }

    private async Task Logout()
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "تسجيل الخروج",
            "هل أنت متأكد من رغبتك في تسجيل الخروج من النظام؟",
            yesText: "نعم، خروج",
            cancelText: "إلغاء");

        if (confirm == true)
        {
            await SessionService.LogLogoutAsync();
        }
    }
}
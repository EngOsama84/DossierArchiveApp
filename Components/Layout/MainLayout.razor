@inherits LayoutComponentBase

<MudThemeProvider Theme="_customTheme" IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true" CloseButton="true" BackdropClick="false" />
<MudSnackbarProvider />

<MudLayout RightToLeft="true">
    <MudAppBar Elevation="1" Color="Color.Primary" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h6" Class="mr-3">نظام إدارة الأضابير والأرشفة الإلكترونية</MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2">الجمهورية العراقية</MudText>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="pa-4">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    // تطبيق الهوية البصرية: الأخضر الداكن المؤسسي + لمسات ذهبية
    private MudTheme _customTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#1B4D3E",          // أخضر داكن مؤسسي (Dark Green)
            Secondary = "#C5A059",        // لمسة ذهبية هادئة (Muted Gold)
            AppbarBackground = "#1B4D3E",
            Background = "#F8F9FA",
            Surface = "#FFFFFF",
            DrawerBackground = "#FFFFFF",
            TextPrimary = "#2C3E50"
        },
        Typography = new Typography()
        {
            Default = new DefaultTypography()
            {
                FontFamily = new[] { "Segoe UI", "Tahoma", "Calibri", "Arial", "sans-serif" }
            }
        }
    };
}